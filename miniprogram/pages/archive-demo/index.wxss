@import "../../app.wxss";

page { min-height: 100vh; background: #e7dfd1; color: #5c493c; }
.archive-demo-page { min-height: 100vh; padding: 0 40rpx calc(160rpx + env(safe-area-inset-bottom)); background: #e7dfd1; color: #5c493c; box-sizing: border-box; font-family: "Source Han Serif CN", "Source Han Serif SC", "Noto Serif CJK SC", "Songti SC", STSong, serif; }
.demo-topbar { position: sticky; z-index: 10; top: 0; margin: 0 -40rpx; border-bottom: 1rpx solid rgba(92, 73, 60, .22); background: #e7dfd1; }
.demo-topbar-row { position: relative; display: flex; height: 88rpx; align-items: center; justify-content: center; padding: 0 120rpx; box-sizing: border-box; }
.demo-topbar-title { color: #5c493c; font-size: 30rpx; font-weight: 600; line-height: 1.4; }
.demo-control { position: absolute; top: 0; display: flex; width: 88rpx; height: 88rpx; align-items: center; justify-content: center; color: #5c493c; }
.demo-back { left: 22rpx; font-family: Georgia, serif; font-size: 56rpx; line-height: 1; }
.demo-control:active, .demo-return:active { opacity: .62; }
.demo-meta { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; padding-top: 48rpx; color: #8a6755; font-family: Garamond, Georgia, "Songti SC", serif; font-size: 23rpx; line-height: 1.5; letter-spacing: 1rpx; }
.demo-meta text:last-child { color: #663124; white-space: nowrap; }
.demo-hero { padding: 92rpx 0 64rpx; }
.demo-title { color: #5c493c; font-size: 58rpx; font-weight: 600; line-height: 1.3; white-space: pre-wrap; }
.demo-question { margin-top: 38rpx; color: #40362f; font-size: 28rpx; line-height: 1.8; }
.demo-image-wrap { margin-top: 10rpx; }
.demo-image { display: block; width: 100%; height: 720rpx; background: #d9d0c4; }
.demo-image-placeholder { display: flex; height: 720rpx; flex-direction: column; align-items: center; justify-content: center; gap: 14rpx; border: 1rpx solid rgba(92, 73, 60, .2); box-sizing: border-box; color: #8a6755; font-family: Garamond, Georgia, serif; font-size: 22rpx; letter-spacing: 2rpx; }
.demo-image-placeholder text:last-child { font-family: "Source Han Serif CN", "Songti SC", serif; font-size: 27rpx; letter-spacing: 0; }
.demo-image-caption { display: flex; justify-content: space-between; gap: 24rpx; padding-top: 18rpx; color: #8a6755; font-family: Garamond, Georgia, "Songti SC", serif; font-size: 21rpx; line-height: 1.55; }
.demo-image-caption text:last-child { flex: 0 0 auto; color: #663124; }
.demo-copy { margin-top: 64rpx; padding-top: 34rpx; border-top: 1rpx solid rgba(92, 73, 60, .24); color: #5c493c; font-size: 28rpx; line-height: 1.9; }
.demo-return { display: flex; min-height: 96rpx; align-items: center; gap: 24rpx; margin-top: 52rpx; color: #5c493c; font-size: 28rpx; font-weight: 600; }
.demo-return text:last-child { color: #663124; font-family: Garamond, Georgia, serif; font-size: 34rpx; }

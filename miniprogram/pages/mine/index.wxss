@import "../../app.wxss";

/* 我的 —— 个人档案：深陶土色账户卡 + 米白档案卡，信息更少但层级更清楚 */
.mine-page {
  min-height: 100vh;
  width: 100%;
  padding: 0 30rpx;
  padding-bottom: calc(180rpx + env(safe-area-inset-bottom));
  background: #eae2d5;
  color: #3d332c;
  box-sizing: border-box;
}

/* 顶栏 */
.mine-topbar {
  justify-content: space-between;
  margin: 0 -30rpx;
  padding-right: 30rpx;
  padding-left: 30rpx;
  border-bottom-color: rgba(92, 73, 60, .16);
  background: #eae2d5;
}
.mine-topbar .brand-topbar-copy {
  color: #663124;
  font-size: 24rpx;
  letter-spacing: 4rpx;
}
.mine-topbar-meta {
  color: #8b6b58;
  font-family: Georgia, "Songti SC", serif;
  font-size: 18rpx;
  letter-spacing: 2rpx;
  line-height: 1;
}

/* 账户卡 */
.profile-card {
  position: relative;
  margin-top: 26rpx;
  padding: 34rpx;
  overflow: hidden;
  border-radius: 32rpx;
  background: linear-gradient(140deg, #6c3829 0%, #47231b 100%);
  box-shadow: 0 24rpx 60rpx rgba(63, 33, 23, .20);
  color: #fbf4ea;
  box-sizing: border-box;
}
.profile-card::before {
  content: "";
  position: absolute;
  top: -230rpx;
  right: -170rpx;
  width: 430rpx;
  height: 430rpx;
  border: 1rpx solid rgba(255, 255, 255, .10);
  border-radius: 50%;
}
.profile-card::after {
  content: "";
  position: absolute;
  top: -80rpx;
  right: -30rpx;
  width: 210rpx;
  height: 210rpx;
  border: 1rpx solid rgba(255, 255, 255, .08);
  border-radius: 50%;
}
.profile-card-deleted { background: linear-gradient(140deg, #613029 0%, #3d1d18 100%); }
.profile-card-guest { background: linear-gradient(140deg, #75412f 0%, #4c271e 100%); }

.profile-watermark {
  position: absolute;
  right: 12rpx;
  bottom: -44rpx;
  color: rgba(255, 255, 255, .05);
  font-family: Georgia, serif;
  font-size: 190rpx;
  letter-spacing: 8rpx;
  line-height: 1;
}
.profile-eyebrow {
  position: relative;
  z-index: 1;
  color: rgba(251, 244, 234, .62);
  font-family: Georgia, "Songti SC", serif;
  font-size: 18rpx;
  letter-spacing: 3rpx;
  line-height: 1.5;
}
.profile-name {
  position: relative;
  z-index: 1;
  overflow-wrap: anywhere;
  color: #fbf4ea;
  font-family: "MYRIAD Song", Georgia, "Songti SC", serif;
  font-size: 40rpx;
  font-weight: 600;
  line-height: 1.4;
}
.profile-name-action { display: inline-block; }
.profile-name-input {
  position: relative;
  z-index: 1;
  width: 100%;
  min-height: 54rpx;
  margin: 0;
  padding: 0;
  border: 0;
  background: transparent;
  color: #fbf4ea;
  font-family: "MYRIAD Song", Georgia, "Songti SC", serif;
  font-size: 40rpx;
  font-weight: 600;
  line-height: 1.4;
  box-sizing: border-box;
}
.profile-caption {
  position: relative;
  z-index: 1;
  margin-top: 6rpx;
  color: rgba(251, 244, 234, .72);
  font-size: 21rpx;
  line-height: 1.7;
  letter-spacing: .4rpx;
}
.profile-error {
  position: relative;
  z-index: 1;
  display: block;
  margin-top: 12rpx;
  color: #f2b8a8;
  font-size: 21rpx;
  line-height: 1.6;
}

.profile-main,
.guest-main {
  position: relative;
  z-index: 1;
  display: grid;
  grid-template-columns: 120rpx minmax(0, 1fr) 56rpx;
  align-items: center;
  gap: 22rpx;
}
.profile-identity { display: grid; gap: 5rpx; min-width: 0; }
.account-avatar {
  display: flex;
  width: 120rpx;
  height: 120rpx;
  align-items: center;
  justify-content: center;
  margin: 0;
  padding: 0;
  overflow: hidden;
  border: 2rpx solid rgba(255, 255, 255, .28);
  border-radius: 50%;
  background: rgba(255, 255, 255, .10);
  color: #fbf4ea;
  line-height: 1;
  box-sizing: border-box;
}
.account-avatar::after { border: 0; }
.account-avatar[disabled] { opacity: .55; }
.account-avatar-image { width: 100%; height: 100%; }
.account-avatar-plus { color: #fbf4ea; font-family: Georgia, serif; font-size: 40rpx; line-height: 1; }
.profile-enter {
  display: flex;
  width: 56rpx;
  height: 56rpx;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgba(255, 255, 255, .16);
  border-radius: 50%;
  background: rgba(255, 255, 255, .08);
  color: #fbf4ea;
  font-family: Georgia, serif;
  font-size: 34rpx;
  line-height: 1;
  box-sizing: border-box;
}
.guest-monogram {
  display: flex;
  width: 120rpx;
  height: 120rpx;
  align-items: center;
  justify-content: center;
  border: 2rpx solid rgba(255, 255, 255, .26);
  border-radius: 50%;
  background: rgba(255, 255, 255, .08);
  color: #fbf4ea;
  font-family: Georgia, serif;
  font-size: 27rpx;
  letter-spacing: 2rpx;
  box-sizing: border-box;
}
.guest-note {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-top: 28rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid rgba(255, 255, 255, .14);
  color: rgba(251, 244, 234, .56);
  font-size: 19rpx;
  line-height: 1.5;
}

.profile-stats {
  position: relative;
  z-index: 1;
  display: grid;
  grid-template-columns: minmax(0, 1fr) 1rpx minmax(0, 1fr);
  align-items: center;
  gap: 24rpx;
  margin-top: 28rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid rgba(255, 255, 255, .14);
}
.stat { display: grid; grid-template-columns: auto minmax(0, 1fr); align-items: center; gap: 16rpx; min-width: 0; }
.stat-value {
  min-width: 62rpx;
  color: #fbf4ea;
  font-family: Georgia, serif;
  font-size: 44rpx;
  line-height: 1;
  text-align: center;
}
.stat-copy { display: grid; gap: 4rpx; min-width: 0; }
.stat-label { color: rgba(251, 244, 234, .88); font-size: 23rpx; line-height: 1.4; }
.stat-note { color: rgba(251, 244, 234, .56); font-size: 19rpx; line-height: 1.4; }
.stat-rule { width: 1rpx; height: 52rpx; background: rgba(255, 255, 255, .14); }

.profile-primary {
  position: relative;
  z-index: 1;
  display: flex;
  width: 100%;
  min-height: 84rpx;
  align-items: center;
  justify-content: center;
  margin-top: 22rpx;
  padding: 0 24rpx;
  border-radius: 18rpx;
  background: #f4e7d8;
  color: #663124;
  font-size: 26rpx;
  font-weight: 600;
  line-height: 1.4;
  letter-spacing: 1rpx;
  box-sizing: border-box;
}
.profile-primary[disabled] { opacity: .5; }

/* 账户错误 */
.inline-alert {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  margin-top: 16rpx;
  padding: 18rpx 22rpx;
  border: 1rpx solid rgba(165, 63, 50, .12);
  border-radius: 18rpx;
  background: #f7e9e2;
}
.inline-alert-copy { flex: 1; min-width: 0; color: #8f3d2e; font-size: 21rpx; line-height: 1.6; }
.inline-alert-action {
  flex: 0 0 auto;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: #8f3d2e;
  color: #fffaf4;
  font-size: 20rpx;
  line-height: 1.5;
}

/* 模块卡 */
.section-card,
.settings-card {
  margin-top: 22rpx;
  padding: 30rpx;
  border: 1rpx solid rgba(92, 73, 60, .12);
  border-radius: 28rpx;
  background: #fbf7ef;
  box-shadow: 0 10rpx 30rpx rgba(74, 48, 34, .05);
  box-sizing: border-box;
}
.section-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 14rpx;
}
.section-heading {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  min-width: 0;
}
.section-heading-copy { display: grid; gap: 4rpx; min-width: 0; }
.section-number {
  display: flex;
  width: 48rpx;
  height: 48rpx;
  flex: 0 0 48rpx;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgba(102, 49, 36, .22);
  border-radius: 50%;
  background: #f6eee3;
  color: #8b5a45;
  font-family: Georgia, serif;
  font-size: 19rpx;
  line-height: 1;
  box-sizing: border-box;
}
.section-kicker {
  color: #8f7b6b;
  font-size: 18rpx;
  letter-spacing: 3rpx;
  line-height: 1.5;
  text-transform: uppercase;
}
.section-title {
  display: block;
  overflow: hidden;
  color: #3d332c;
  font-family: "MYRIAD Song", Georgia, "Songti SC", serif;
  font-size: 34rpx;
  font-weight: 600;
  line-height: 1.4;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.section-action {
  display: flex;
  flex: 0 0 auto;
  align-items: center;
  gap: 8rpx;
  padding: 10rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(102, 49, 36, .06);
  color: #663124;
  font-size: 20rpx;
  line-height: 1.3;
}
.section-arrow { color: #8b5a45; font-family: Georgia, serif; font-size: 22rpx; line-height: 1; }
.section-count { display: block; color: #8b6b58; font-family: "MYRIAD Song", Georgia, "Songti SC", serif; font-size: 21rpx; line-height: 1.5; }
.section-count-tail { flex: 0 0 auto; align-self: center; }
.section-note { max-width: 58%; color: #8f7d6e; font-size: 18rpx; line-height: 1.5; text-align: right; }

.section-body { margin-top: 22rpx; }
.section-meta { display: flex; align-items: baseline; justify-content: space-between; gap: 16rpx; }
.section-state,
.section-state-error {
  margin-top: 20rpx;
  color: #7c6e62;
  font-size: 22rpx;
  line-height: 1.7;
}
.section-state-error { color: #9b4033; }
.section-state-error .section-link { margin-top: 8rpx; }

.section-empty {
  margin-top: 22rpx;
  padding: 26rpx;
  border-radius: 20rpx;
  background: #f6eee3;
}
.section-empty-title {
  display: block;
  color: #3d332c;
  font-family: "MYRIAD Song", Georgia, "Songti SC", serif;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.5;
}
.section-empty-copy {
  display: block;
  margin-top: 8rpx;
  color: #7c6e62;
  font-size: 22rpx;
  line-height: 1.75;
}
.section-link {
  display: flex;
  min-height: 72rpx;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid rgba(92, 73, 60, .12);
  color: #663124;
  font-size: 24rpx;
  line-height: 1.5;
}
.section-empty .section-link { min-height: 60rpx; margin-top: 6rpx; padding-top: 10rpx; border-top: 0; }
.section-link-compact { min-height: 52rpx; padding-top: 6rpx; border-top: 0; }
.section-link-copy { color: #663124; font-size: 24rpx; line-height: 1.5; }
.section-footnote {
  display: block;
  margin-top: 18rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid rgba(92, 73, 60, .10);
  color: #8f7d6e;
  font-size: 19rpx;
  line-height: 1.7;
}

/* 观察记录 */
.record-list { display: grid; gap: 14rpx; margin-top: 22rpx; }
.record-row {
  position: relative;
  padding: 22rpx 22rpx 20rpx;
  overflow: hidden;
  border: 1rpx solid rgba(92, 73, 60, .10);
  border-radius: 20rpx;
  background: #fffdf8;
}
.record-row::before {
  content: "";
  position: absolute;
  top: 22rpx;
  bottom: 22rpx;
  left: 0;
  width: 4rpx;
  border-radius: 0 4rpx 4rpx 0;
  background: #c9a58c;
}
.record-top { display: flex; align-items: baseline; justify-content: space-between; gap: 16rpx; padding-left: 6rpx; }
.record-method { color: #8b5a45; font-size: 19rpx; letter-spacing: 1rpx; line-height: 1.5; }
.record-date { color: #a08c7b; font-size: 19rpx; line-height: 1.5; }
.record-preview {
  margin-top: 10rpx;
  padding-left: 6rpx;
  color: #3d332c;
  font-family: "MYRIAD Song", Georgia, "Songti SC", serif;
  font-size: 29rpx;
  font-weight: 600;
  line-height: 1.55;
}
.record-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 12rpx;
  padding-left: 6rpx;
  color: #9c8b7d;
  font-size: 19rpx;
  line-height: 1.5;
}
.record-status { padding: 2rpx 12rpx; border-radius: 999rpx; background: #f1e8dc; color: #8b6b58; }
.record-status.is-draft { background: #f6e9d8; color: #8a5a2b; }

/* 已保存经历 */
.contribution {
  margin-top: 16rpx;
  padding: 22rpx;
  border: 1rpx solid rgba(92, 73, 60, .10);
  border-radius: 20rpx;
  background: #fffdf8;
}
.contribution-meta { display: flex; align-items: center; justify-content: space-between; gap: 14rpx; }
.contribution-issue { color: #8b5a45; font-family: Georgia, "Songti SC", serif; font-size: 20rpx; line-height: 1.5; }
.status-pill {
  flex: 0 0 auto;
  padding: 3rpx 14rpx;
  border-radius: 999rpx;
  font-size: 18rpx;
  line-height: 1.5;
}
.status-pending { background: #f7ead6; color: #8a5a2b; }
.status-handled { background: #eaf2ec; color: #3f6b4f; }
.status-dismissed { background: #f1e8dc; color: #8b6b58; }
.contribution-body {
  margin-top: 12rpx;
  color: #4a3d34;
  font-family: "MYRIAD Song", Georgia, "Songti SC", serif;
  font-size: 24rpx;
  line-height: 1.75;
  white-space: pre-wrap;
}
.contribution-actions {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 14rpx;
  padding-top: 12rpx;
  border-top: 1rpx solid rgba(92, 73, 60, .08);
}
.contribution-note { color: #9c8b7d; font-size: 18rpx; line-height: 1.5; }
.contribution-delete,
.contribution-continue { color: #663124; font-size: 19rpx; line-height: 1.5; }
.contribution-delete { opacity: .72; }
.contribution-continue text { margin-left: 6rpx; }
.legacy-group { margin-top: 26rpx; padding-top: 18rpx; border-top: 1rpx solid rgba(92, 73, 60, .10); }
.legacy-label { color: #a08c7b; font-size: 18rpx; letter-spacing: 1rpx; line-height: 1.6; }

/* 设置 */
.settings-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}
.settings-main { display: flex; align-items: center; gap: 16rpx; min-width: 0; }
.settings-copy { display: grid; gap: 4rpx; min-width: 0; }
.settings-title {
  display: block;
  color: #3d332c;
  font-family: "MYRIAD Song", Georgia, "Songti SC", serif;
  font-size: 32rpx;
  font-weight: 600;
  line-height: 1.45;
}
.settings-value { display: block; color: #8b6b58; font-size: 21rpx; line-height: 1.5; }
.settings-arrow { flex: 0 0 auto; color: #663124; font-family: Georgia, serif; font-size: 32rpx; line-height: 1; }

/* 页脚 */
.mine-footer { margin-top: 56rpx; padding-bottom: 18rpx; text-align: center; }
.mine-footer-mark { color: #a08c7b; font-family: Georgia, serif; font-size: 18rpx; line-height: 1.6; letter-spacing: 6rpx; }
.mine-footer-copy { margin-top: 6rpx; color: #b0a092; font-size: 19rpx; line-height: 1.6; letter-spacing: 3rpx; }

.mine-page [role="button"]:active { opacity: .72; }

@import "../../app.wxss";

page { background: #e7dfd1; }

.season-page {
  min-height: 100vh;
  padding: 0 36rpx 160rpx;
  background: #e7dfd1;
  color: #4a3f38;
  box-sizing: border-box;
  font-family: "MYRIAD Song", "Source Han Serif CN", "Source Han Serif SC", "Songti SC", STSong, serif;
}

/* 顶栏 */
.season-topbar {
  position: sticky;
  z-index: 10;
  top: 0;
  margin: 0 -36rpx;
  border-bottom: 1rpx solid rgba(92, 73, 60, .18);
  background: #e7dfd1;
  box-sizing: content-box;
}
.season-nav-row { position: relative; display: flex; height: 56px; align-items: center; justify-content: center; }
.season-nav-title {
  color: #5c493c;
  font-size: 31rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
}
.season-back, .season-more {
  position: absolute;
  top: 0;
  display: flex;
  width: 76rpx;
  height: 56px;
  align-items: center;
  justify-content: center;
  color: #5c493c;
  line-height: 1;
}
.season-back { left: 16rpx; font-family: Georgia, serif; font-size: 56rpx; padding-bottom: 6rpx; }
.season-more { right: 16rpx; font-family: Georgia, serif; font-size: 30rpx; letter-spacing: 2rpx; }
.season-back:active, .season-more:active { opacity: .58; }

/* 页眉 */
.season-meta {
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
  margin-top: 30rpx;
  padding-bottom: 6rpx;
  color: #8b6b58;
  font-size: 22rpx;
  letter-spacing: 1rpx;
  line-height: 1.5;
}
.season-meta text:last-child { color: #7b5a45; }

/* 标题区 */
.season-hero { margin-top: 44rpx; }
.season-headline-line { display: block; }
.season-headline {
  color: #4a3f38;
  font-size: 58rpx;
  font-weight: 600;
  line-height: 1.42;
  letter-spacing: .5rpx;
}
.season-lead {
  margin-top: 34rpx;
  color: #4a3f38;
  font-size: 27rpx;
  line-height: 1.85;
}

/* 生日选择 */
.season-form { margin-top: 46rpx; }
.season-label { color: #4a3f38; font-size: 26rpx; font-weight: 600; line-height: 1.5; }
.birth-row { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 56rpx; margin-top: 26rpx; }
.birth-field { display: block; }
.birth-caption { color: #8b6b58; font-size: 22rpx; line-height: 1.4; }
.birth-value {
  margin-top: 14rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #b9a794;
  color: #4a3f38;
  font-size: 30rpx;
  line-height: 1.4;
}
.birth-value.is-placeholder { color: #a1907f; }
.birth-note { margin-top: 22rpx; color: #8b6b58; font-size: 22rpx; line-height: 1.6; }

/* 记住生日 */
.remember-row { display: flex; align-items: flex-start; gap: 16rpx; margin-top: 44rpx; }
.remember-box {
  flex: 0 0 28rpx;
  width: 28rpx;
  height: 28rpx;
  margin-top: 6rpx;
  border: 1rpx solid #8b6b58;
  box-sizing: border-box;
  background: transparent;
}
.remember-box.is-checked { border-color: #663124; background: #663124; box-shadow: inset 0 0 0 5rpx #e7dfd1; }
.remember-copy { display: grid; gap: 6rpx; min-width: 0; }
.remember-title { color: #4a3f38; font-size: 26rpx; line-height: 1.5; }
.remember-note { color: #8b6b58; font-size: 21rpx; line-height: 1.6; }

/* 主按钮 */
.season-primary {
  display: flex;
  min-height: 96rpx;
  align-items: center;
  justify-content: center;
  margin-top: 34rpx;
  border-radius: 4rpx;
  background: #663124;
  color: #fffaf4;
  font-size: 29rpx;
  letter-spacing: 1rpx;
}
.season-primary:active { opacity: .88; }

.season-divider { height: 1rpx; margin: 52rpx 0 0; background: rgba(92, 73, 60, .2); }

/* 说明折叠 */
.season-guide-toggle {
  display: flex;
  align-items: center;
  gap: 16rpx;
  min-height: 104rpx;
  margin-top: 16rpx;
  padding: 8rpx 0;
  color: #4a3f38;
  font-size: 31rpx;
  letter-spacing: .5rpx;
}
.season-guide-toggle:active { opacity: .68; }
.guide-caret { color: #663124; font-size: 26rpx; line-height: 1; }
/* 说明正文：不加底色、不拉伸字距，按页面对齐方式自然换行 */
.season-guide-body {
  display: grid;
  gap: 16rpx;
  margin-top: 2rpx;
  padding-bottom: 4rpx;
}
.season-guide-paragraph {
  color: #5b4c42;
  font-size: 25rpx;
  line-height: 1.95;
  letter-spacing: 0;
  text-align: left;
}
.season-guide-steps {
  margin-top: 2rpx;
  color: #7b5a45;
  font-size: 24rpx;
  line-height: 1.7;
  letter-spacing: 1rpx;
}

/* 次要操作 */
.season-secondary {
  display: flex;
  min-height: 92rpx;
  align-items: center;
  justify-content: center;
  margin-top: 44rpx;
  border: 1rpx solid #7c6552;
  border-radius: 4rpx;
  color: #4a3f38;
  font-size: 28rpx;
}
.season-secondary:active { opacity: .7; }
.season-skip {
  margin-top: 42rpx;
  color: #8b6b58;
  font-size: 24rpx;
  letter-spacing: 1rpx;
  text-align: center;
}
.season-skip:active { opacity: .6; }

.season-page [role="button"]:active { opacity: .72; }

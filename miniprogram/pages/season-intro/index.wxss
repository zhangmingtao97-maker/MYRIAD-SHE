@import "../../app.wxss";

page { background: #e7dfd1; }

.season-page {
  min-height: 100vh;
  padding: 0 36rpx calc(200rpx + env(safe-area-inset-bottom));
  background: #e7dfd1;
  color: #4a3f38;
  box-sizing: border-box;
  font-family: "MYRIAD Garamond", "MYRIAD Song", serif;
}

/* 顶栏 */
.season-topbar {
  position: sticky;
  z-index: 10;
  top: 0;
  margin: 0 -36rpx;
  border-bottom: 1rpx solid rgba(92, 73, 60, .18);
  background: #e7dfd1;
  box-sizing: content-box;
}
.season-nav-row { position: relative; display: flex; height: 56px; align-items: center; justify-content: center; }
.season-nav-title {
  color: #5c493c;
  font-size: 31rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
}
.season-back, .season-more {
  position: absolute;
  top: 0;
  display: flex;
  width: 76rpx;
  height: 56px;
  align-items: center;
  justify-content: center;
  color: #5c493c;
  line-height: 1;
}
.season-back { left: 16rpx; font-family: "MYRIAD Garamond", "MYRIAD Song", serif; font-size: 56rpx; padding-bottom: 6rpx; }
.season-more { right: 16rpx; font-family: "MYRIAD Garamond", "MYRIAD Song", serif; font-size: 30rpx; letter-spacing: 2rpx; }
.season-back:active, .season-more:active { opacity: .58; }

/* 页眉 */
.season-meta {
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
  margin-top: 30rpx;
  padding-bottom: 6rpx;
  color: #8b6b58;
  font-size: 22rpx;
  letter-spacing: 1rpx;
  line-height: 1.5;
}
.season-meta text:last-child { color: #7b5a45; }

/* 标题区 */
.season-hero { margin-top: 44rpx; }
.season-headline-line { display: block; }
.season-headline {
  color: #4a3f38;
  font-size: 58rpx;
  font-weight: 600;
  line-height: 1.42;
  letter-spacing: .5rpx;
}
.season-lead {
  margin-top: 34rpx;
  color: #4a3f38;
  font-size: 27rpx;
  line-height: 1.85;
}

/* 方法说明：放在生日选择之前并默认展开，先读说明再开始 */
.season-intro-guide {
  margin-top: 46rpx;
  padding: 22rpx 0 30rpx;
  border-top: 1rpx solid rgba(92, 73, 60, .2);
  border-bottom: 1rpx solid rgba(92, 73, 60, .2);
}

/* 生日选择 */
.season-form { margin-top: 40rpx; transition: opacity .18s ease; }
.season-form.is-locked { opacity: .5; }
.season-label { color: #4a3f38; font-size: 26rpx; font-weight: 600; line-height: 1.5; }
.birth-row { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 56rpx; margin-top: 26rpx; }
.birth-field { display: block; }
.birth-caption { color: #8b6b58; font-size: 22rpx; line-height: 1.4; }
.birth-value {
  margin-top: 14rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #b9a794;
  color: #4a3f38;
  font-size: 30rpx;
  line-height: 1.4;
}
.birth-value.is-placeholder { color: #a1907f; }
.birth-value { display: flex; align-items: baseline; gap: 8rpx; }
.birth-number { flex: 0 0 auto; color: #4a3f38; font-size: 30rpx; line-height: 1.4; }
.birth-inline-copy { display: inline-flex; }
.birth-note { margin-top: 22rpx; color: #8b6b58; font-size: 22rpx; line-height: 1.6; }

/* 记住生日 */
.remember-row { display: flex; align-items: flex-start; gap: 16rpx; margin-top: 44rpx; }
.remember-box {
  flex: 0 0 28rpx;
  width: 28rpx;
  height: 28rpx;
  margin-top: 6rpx;
  border: 1rpx solid #8b6b58;
  box-sizing: border-box;
  background: transparent;
}
.remember-box.is-checked { border-color: #663124; background: #663124; box-shadow: inset 0 0 0 5rpx #e7dfd1; }
.remember-copy { display: grid; gap: 6rpx; min-width: 0; }
.remember-title { color: #4a3f38; font-size: 26rpx; line-height: 1.5; }
.remember-note { color: #8b6b58; font-size: 21rpx; line-height: 1.6; }

/* 主按钮 */
.season-primary {
  display: flex;
  min-height: 96rpx;
  align-items: center;
  justify-content: center;
  margin-top: 34rpx;
  border-radius: 4rpx;
  background: #663124;
  color: #fffaf4;
  font-size: 29rpx;
  letter-spacing: 1rpx;
}
.season-primary:active { opacity: .88; }
.season-primary.is-locked { background: #a08f80; }

/* 说明折叠 */
.season-guide-toggle {
  display: flex;
  align-items: center;
  gap: 16rpx;
  min-height: 76rpx;
  margin-top: 0;
  padding: 0;
  color: #4a3f38;
  font-size: 31rpx;
  letter-spacing: .5rpx;
}
.season-guide-toggle:active { opacity: .68; }
.season-guide-title { flex: 1; min-width: 0; }
.guide-caret { flex: 0 0 auto; color: #663124; font-size: 52rpx; line-height: 1; }
.season-guide-state {
  flex: 0 0 auto;
  margin-left: auto;
  padding: 5rpx 13rpx;
  border: 1rpx solid rgba(102, 49, 36, .34);
  border-radius: 999rpx;
  color: #663124;
  font-size: 20rpx;
  line-height: 1.2;
  letter-spacing: 1rpx;
}
.season-guide-state.is-read { border-color: rgba(92, 73, 60, .2); color: #8b6b58; }
/* 说明正文：不加底色、不拉伸字距，按页面对齐方式自然换行 */
.season-guide-body {
  display: grid;
  gap: 16rpx;
  margin-top: 18rpx;
  padding-bottom: 0;
}
.season-guide-paragraph {
  color: #5b4c42;
  font-size: 25rpx;
  line-height: 1.95;
  letter-spacing: 0;
  text-align: inherit;
}
.season-guide-steps {
  margin-top: 2rpx;
  color: #7b5a45;
  font-size: 24rpx;
  line-height: 1.7;
  letter-spacing: 1rpx;
}
.season-guide-gate { display: grid; gap: 18rpx; margin-top: 16rpx; padding-top: 24rpx; border-top: 1rpx solid rgba(92, 73, 60, .18); }
.season-guide-gate-note { color: #7b5a45; font-size: 22rpx; line-height: 1.65; }
.season-guide-confirm {
  display: flex;
  min-height: 84rpx;
  align-items: center;
  justify-content: center;
  border-radius: 4rpx;
  background: #663124;
  color: #fffaf4;
  font-size: 27rpx;
  letter-spacing: 1rpx;
}
.season-guide-confirm:active { opacity: .82; }

/* 次要操作 */
.season-secondary {
  display: flex;
  min-height: 92rpx;
  align-items: center;
  justify-content: center;
  margin-top: 44rpx;
  border: 1rpx solid #7c6552;
  border-radius: 4rpx;
  color: #4a3f38;
  font-size: 28rpx;
}
.season-secondary:active { opacity: .7; }
.season-skip {
  display: flex;
  width: 100%;
  min-height: 88rpx;
  align-items: center;
  justify-content: center;
  margin: 24rpx 0 0;
  padding: 12rpx 0;
  border: 0;
  border-radius: 0;
  background: transparent;
  color: #8b6b58;
  font-family: inherit;
  font-size: 26rpx;
  font-weight: 400;
  line-height: 1.5;
  letter-spacing: 1rpx;
  text-align: center;
  box-sizing: border-box;
}
.season-skip:active { opacity: .6; }

.season-page [role="button"]:active { opacity: .72; }

/* 整页排版由后台控制；按钮内部始终居中，避免可点击区域随文字偏移。 */
.season-align-center .season-meta { justify-content: center; gap: 42rpx; }
.season-align-right .season-meta { justify-content: flex-end; gap: 42rpx; }
.season-align-center .season-hero,
.season-align-center .season-lead,
.season-align-center .season-guide-body,
.season-align-center .season-form,
.season-align-center .remember-copy,
.season-align-center .birth-row { text-align: center; }
.season-align-right .season-hero,
.season-align-right .season-lead,
.season-align-right .season-guide-body,
.season-align-right .season-form,
.season-align-right .remember-copy,
.season-align-right .birth-row { text-align: right; }
.season-align-center .remember-row { justify-content: center; }
.season-align-right .remember-row { justify-content: flex-end; }
.season-align-center .birth-value { justify-content: center; }
.season-align-right .birth-value { justify-content: flex-end; }

.season-spacing-compact .season-hero { margin-top: 28rpx; }
.season-spacing-compact .season-lead { margin-top: 22rpx; }
.season-spacing-compact .season-intro-guide { margin-top: 30rpx; padding-top: 14rpx; padding-bottom: 20rpx; }
.season-spacing-compact .season-guide-body { gap: 10rpx; margin-top: 10rpx; }
.season-spacing-compact .season-guide-gate { gap: 12rpx; padding-top: 16rpx; }
.season-spacing-compact .season-form { margin-top: 26rpx; }
.season-spacing-compact .birth-row { margin-top: 18rpx; }
.season-spacing-compact .birth-note { margin-top: 14rpx; }
.season-spacing-compact .remember-row { margin-top: 30rpx; }
.season-spacing-compact .season-primary { margin-top: 24rpx; }
.season-spacing-compact .season-secondary { margin-top: 30rpx; }
.season-spacing-compact .season-skip { margin-top: 12rpx; }

.season-spacing-roomy .season-hero { margin-top: 62rpx; }
.season-spacing-roomy .season-lead { margin-top: 44rpx; }
.season-spacing-roomy .season-intro-guide { margin-top: 62rpx; padding-top: 28rpx; padding-bottom: 38rpx; }
.season-spacing-roomy .season-guide-body { gap: 24rpx; margin-top: 26rpx; }
.season-spacing-roomy .season-guide-gate { gap: 24rpx; padding-top: 32rpx; }
.season-spacing-roomy .season-form { margin-top: 54rpx; }
.season-spacing-roomy .birth-row { margin-top: 34rpx; }
.season-spacing-roomy .birth-note { margin-top: 30rpx; }
.season-spacing-roomy .remember-row { margin-top: 58rpx; }
.season-spacing-roomy .season-primary { margin-top: 48rpx; }
.season-spacing-roomy .season-secondary { margin-top: 58rpx; }
.season-spacing-roomy .season-skip { margin-top: 34rpx; }

/* ---------- 阅读确认与表单解锁轻量动效 ---------- */
.season-guide-body {
  animation: season-guide-enter .24s cubic-bezier(.22, 1, .36, 1) both;
}
.season-form {
  transform: translateY(0);
  transition: opacity .22s ease, transform .22s cubic-bezier(.22, 1, .36, 1);
}
.season-form.is-locked {
  opacity: .5;
  transform: translateY(8rpx);
}
.birth-number {
  animation: season-value-enter .22s cubic-bezier(.22, 1, .36, 1) both;
}
.season-primary {
  transform: translateY(0);
  transition: background-color .2s ease, opacity .18s ease, transform .22s cubic-bezier(.22, 1, .36, 1), box-shadow .2s ease;
}
.season-primary.is-locked {
  transform: translateY(6rpx);
}
@keyframes season-guide-enter {
  from { opacity: .35; transform: translateY(12rpx); }
  to { opacity: 1; transform: translateY(0); }
}
@keyframes season-value-enter {
  from { opacity: 0; transform: translateY(5rpx); }
  to { opacity: 1; transform: translateY(0); }
}
@media (prefers-reduced-motion: reduce) {
  .season-guide-body, .birth-number { animation: none; transform: none; }
  .season-form, .season-primary { transition: none; transform: none; }
  .season-form.is-locked, .season-primary.is-locked { transform: none; }
}

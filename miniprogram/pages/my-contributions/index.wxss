@import "../../app.wxss";

.contributions-page {
  min-height: 100vh;
  padding: 0 36rpx calc(80rpx + env(safe-area-inset-bottom));
  background: #e7dfd1;
  color: #3d332c;
  box-sizing: border-box;
}
.contributions-topbar {
  position: sticky;
  z-index: 10;
  top: 0;
  margin: 0 -36rpx;
  padding-right: 36rpx;
  padding-left: 36rpx;
  border-bottom: 1rpx solid rgba(92, 73, 60, .20);
  background: #e7dfd1;
  box-sizing: content-box;
}
.contributions-nav {
  position: relative;
  display: flex;
  height: 56px;
  align-items: center;
  justify-content: center;
}
.contributions-back {
  position: absolute;
  top: 0;
  left: -20rpx;
  display: flex;
  width: 72rpx;
  height: 56px;
  align-items: center;
  justify-content: center;
  padding-bottom: 6rpx;
  color: #5c493c;
  font-family: "MYRIAD Garamond", "MYRIAD Song", serif;
  font-size: 56rpx;
  line-height: 1;
}
.contributions-title {
  color: #5c493c;
  font-family: "MYRIAD Garamond", "MYRIAD Song", serif;
  font-size: 31rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
}
.contributions-count {
  position: absolute;
  right: 2rpx;
  color: #8e493c;
  font-family: "MYRIAD Garamond", "MYRIAD Song", serif;
  font-size: 23rpx;
}
.contributions-content { padding-top: 32rpx; }
.contributions-intro {
  display: grid;
  gap: 8rpx;
  padding: 0 2rpx 26rpx;
  border-bottom: 1rpx solid rgba(92, 73, 60, .12);
}
.contributions-kicker {
  color: #9a816f;
  font-family: "MYRIAD Garamond", "MYRIAD Song", serif;
  font-size: 17rpx;
  letter-spacing: 4rpx;
  line-height: 1.5;
}
.contributions-heading {
  color: #3d332c;
  font-family: "MYRIAD Garamond", "MYRIAD Song", serif;
  font-size: 40rpx;
  font-weight: 600;
  line-height: 1.4;
}
.contributions-note {
  color: #8b6b58;
  font-size: 21rpx;
  line-height: 1.7;
}
.contributions-state {
  display: grid;
  gap: 22rpx;
  margin-top: 28rpx;
  padding: 40rpx 28rpx;
  border: 1rpx solid rgba(92, 73, 60, .10);
  border-radius: 24rpx;
  background: rgba(255, 253, 248, .62);
  color: #76695f;
  font-size: 22rpx;
  line-height: 1.7;
}
.contributions-error { color: #9b4033; }
.contributions-retry,
.contributions-current {
  display: flex;
  min-height: 82rpx;
  align-items: center;
  justify-content: center;
  padding: 14rpx 28rpx;
  border: 1rpx solid #c6b09d;
  border-radius: 999rpx;
  background: rgba(255, 253, 248, .68);
  color: #663124;
  font-size: 24rpx;
  line-height: 1.5;
  box-sizing: border-box;
  text-align: center;
}
.contribution-card {
  margin-top: 18rpx;
  padding: 24rpx;
  border: 1rpx solid rgba(92, 73, 60, .10);
  border-radius: 22rpx;
  background: #fffdf8;
  box-shadow: 0 8rpx 24rpx rgba(78, 56, 44, .04);
}
.contribution-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}
.contribution-issue {
  color: #8b5a45;
  font-family: "MYRIAD Garamond", "MYRIAD Song", serif;
  font-size: 20rpx;
  line-height: 1.5;
}
.status-pill {
  flex: 0 0 auto;
  padding: 3rpx 14rpx;
  border-radius: 999rpx;
  font-size: 18rpx;
  line-height: 1.5;
}
.status-pending { background: #f7ead6; color: #8a5a2b; }
.status-handled { background: #eaf2ec; color: #3f6b4f; }
.status-dismissed { background: #f1e8dc; color: #8b6b58; }
.contribution-body {
  margin-top: 14rpx;
  color: #4a3d34;
  font-family: "MYRIAD Garamond", "MYRIAD Song", serif;
  font-size: 25rpx;
  line-height: 1.75;
  white-space: pre-wrap;
  overflow-wrap: anywhere;
}
.contribution-actions {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  margin-top: 16rpx;
  padding-top: 13rpx;
  border-top: 1rpx solid rgba(92, 73, 60, .08);
}
.contribution-note { color: #9c8b7d; font-size: 18rpx; line-height: 1.5; }
.contribution-delete,
.contribution-continue {
  min-height: 48rpx;
  padding: 8rpx 0;
  color: #663124;
  font-size: 19rpx;
  line-height: 1.5;
}
.contribution-delete { opacity: .72; }
.contribution-delete[aria-disabled="true"] { opacity: .4; }
.contributions-empty {
  display: grid;
  gap: 14rpx;
  justify-items: center;
  margin-top: 28rpx;
  padding: 54rpx 32rpx;
  border: 1rpx solid rgba(92, 73, 60, .10);
  border-radius: 24rpx;
  background: rgba(255, 253, 248, .58);
  text-align: center;
}
.contributions-empty-title {
  color: #3d332c;
  font-family: "MYRIAD Garamond", "MYRIAD Song", serif;
  font-size: 30rpx;
  font-weight: 600;
}
.contributions-empty-copy { color: #8b6b58; font-size: 21rpx; line-height: 1.7; }
.contributions-empty .contributions-current { width: 100%; margin-top: 10rpx; }
.legacy-group {
  margin-top: 30rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid rgba(92, 73, 60, .12);
}
.legacy-label {
  color: #a08c7b;
  font-size: 18rpx;
  letter-spacing: 1rpx;
  line-height: 1.6;
}
.contributions-footer {
  display: grid;
  gap: 18rpx;
  margin-top: 30rpx;
}
.contributions-footnote {
  padding: 0 18rpx;
  color: #8f7d6e;
  font-size: 19rpx;
  line-height: 1.7;
  text-align: center;
}
.contributions-page [role="button"]:active { opacity: .7; }
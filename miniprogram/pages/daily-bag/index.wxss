page { height: 100vh; overflow: hidden; background: #e7dfd1; color: #5c493c; font-family: Georgia, "Songti SC", serif; }
.bag-frame { display: flex; width: 100%; height: 100vh; flex-direction: column; overflow: hidden; background: #e7dfd1; }
.bag-topbar { position: relative; z-index: 2; display: flex; flex: 0 0 auto; height: 56px; align-items: center; justify-content: center; box-sizing: content-box; border-bottom: 1rpx solid rgba(92,73,60,.23); background: #e7dfd1; }
.bag-topbar-title { color: #5c493c; font-family: Georgia, "Songti SC", serif; font-size: 31rpx; font-weight: 600; letter-spacing: 1rpx; }
.bag-topbar-action { position: absolute; top: 0; display: flex; width: 76rpx; height: 56px; align-items: center; justify-content: center; color: #5c493c; font-family: Georgia, serif; }
.bag-back { left: 20rpx; padding-bottom: 6rpx; font-size: 56rpx; line-height: 1; }
.bag-more { right: 20rpx; padding-bottom: 18rpx; font-size: 31rpx; letter-spacing: 2rpx; }
.bag-back:active, .bag-action:active, .bag-tab:active { opacity: .62; }
.bag-scroll { flex: 1 1 0; width: 100%; height: 0; min-height: 0; }
.bag-access-state { display: flex; flex: 1 1 0; align-items: center; justify-content: center; padding: 48rpx; color: #5c493c; font-size: 28rpx; text-align: center; }
.bag-content { box-sizing: border-box; min-height: 100%; padding: 48rpx 52rpx 76rpx; color: #5c493c; font-family: Georgia, "Songti SC", serif; }
.bag-eyebrow { display: block; color: #663124; font-family: Georgia, "Times New Roman", serif; font-size: 22rpx; line-height: 1.4; letter-spacing: .12em; }
.bag-title { display: block; margin-top: 42rpx; color: #5c493c; font-size: 48rpx; font-weight: 600; line-height: 1.35; letter-spacing: -.025em; }
.bag-intro { display: block; margin-top: 28rpx; color: #40362f; font-size: 26rpx; line-height: 1.8; }
.bag-empty { margin-top: 142rpx; }
.bag-rule { width: 64rpx; height: 2rpx; margin-bottom: 62rpx; background: #663124; }
.bag-empty-title { display: block; color: #5c493c; font-size: 38rpx; font-weight: 600; line-height: 1.5; }
.bag-empty-copy { display: block; margin-top: 28rpx; color: #40362f; font-size: 24rpx; line-height: 1.8; }
.bag-action { display: flex; min-height: 92rpx; align-items: center; justify-content: space-between; margin-top: 58rpx; padding: 0 32rpx; background: #663124; color: #f5f0e8; font-size: 26rpx; line-height: 1.5; }
.bag-action text { margin-left: 20rpx; color: #f5f0e8; font-family: Georgia, serif; font-size: 28rpx; }
.bag-footer { margin-top: 52rpx; padding-top: 28rpx; border-top: 1rpx solid rgba(92,73,60,.23); color: #5c493c; font-size: 20rpx; line-height: 1.8; }
.bag-tabbar { position: relative; z-index: 5; display: flex; flex: 0 0 auto; height: calc(120rpx + env(safe-area-inset-bottom)); padding: 0 24rpx env(safe-area-inset-bottom); border-top: 1rpx solid rgba(92,73,60,.23); background: #e7dfd1; box-sizing: border-box; }
.bag-tab { display: flex; flex: 1; min-width: 0; min-height: 112rpx; flex-direction: column; align-items: center; justify-content: center; gap: 8rpx; color: #928276; }
.bag-tab.selected { color: #663124; }
.bag-tab-icon { position: relative; display: flex; width: 40rpx; height: 40rpx; align-items: center; justify-content: center; color: inherit; }
.bag-home-icon, .bag-mine-icon { border: 2rpx solid currentColor; border-radius: 50%; }
.bag-home-icon view { width: 8rpx; height: 8rpx; border-radius: 50%; background: currentColor; }
.bag-practice-icon { flex-direction: column; justify-content: space-around; }
.bag-practice-icon view { width: 26rpx; height: 7rpx; border: 2rpx solid currentColor; border-right: 0; border-left: 0; border-radius: 50%; }
.bag-mine-icon { overflow: hidden; }
.bag-mine-head { position: absolute; top: 6rpx; left: 12rpx; width: 9rpx; height: 9rpx; border: 2rpx solid currentColor; border-radius: 50%; }
.bag-mine-body { position: absolute; bottom: -7rpx; left: 6rpx; width: 21rpx; height: 16rpx; border: 2rpx solid currentColor; border-radius: 50% 50% 0 0; }
.bag-tab text { color: inherit; font-size: 22rpx; line-height: 1.2; }

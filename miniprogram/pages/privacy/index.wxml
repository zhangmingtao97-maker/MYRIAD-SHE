<view class="privacy-page">
  <view class="privacy-topbar" style="padding-top: {{statusBarHeight}}px"><view class="topbar-row"><view class="icon-button" aria-label="返回" bindtap="handleBack" role="button" tabindex="0">‹</view><text class="topbar-title">通知与隐私</text><view class="icon-button" aria-label="更多" bindtap="handleMore" role="button" tabindex="0">···</view></view></view>
  <view wx:if="{{loading}}" class="privacy-state">正在读取个人设置…</view>
  <view wx:elif="{{accountDeleted}}" class="privacy-state">账户已删除，请回到“我的”页面确认是否创建新账户。</view>
  <view wx:elif="{{loadError}}" class="privacy-state error-state"><text>{{loadError}}</text><view class="text-button" bindtap="load" role="button" tabindex="0">重新加载</view></view>
  <block wx:else>
    <view class="privacy-content">
      <view class="privacy-meta"><text>我的</text><text>PRIVACY &amp; CHOICES</text></view>
      <view class="privacy-hero"><text class="privacy-hero-title">方法应当由你使用，<br/>而不是反过来定义你。</text><text class="privacy-hero-intro">隐私与方法偏好始终由你决定。</text></view>
      <view class="privacy-section first-section"><view class="section-index"><text>01</text><text>隐私</text></view><view class="privacy-row"><view class="row-copy"><text class="row-title">观察记录默认私密</text><text class="row-desc">仅你本人可查看和管理</text></view><text class="row-status">已开启</text></view></view>
      <view class="privacy-section"><view class="section-index"><text>02</text><text>方法选择</text></view><view class="privacy-row method-row"><view class="row-copy"><text class="row-title">暂不使用四时气韵</text><text class="row-desc">你可以随时重新开启这一种观察方式</text></view><switch color="#8e493c" checked="{{settings.preferences.seasonEnabled === true}}" disabled="{{saving}}" bindchange="toggleMethod" /></view></view>
      <view class="privacy-section"><view class="section-index"><text>03</text><text>提醒与关于</text></view><view class="privacy-row" bindtap="toggleNotifications"><view class="row-copy"><text class="row-title">活动提醒</text><text class="row-desc">共同实践开放时再向你询问</text></view><text class="row-arrow">{{settings.notificationsEnabled ? '已开启' : '未开启'}}</text></view><view class="privacy-row" bindtap="handleMore"><view class="row-copy"><text class="row-title">关于 MYRIAD SHE</text><text class="row-desc">品牌介绍、内容来源与联系方式</text></view><text class="row-arrow">→</text></view><view class="privacy-row" bindtap="openUserAgreement"><view class="row-copy"><text class="row-title">用户协议</text><text class="row-desc">了解服务使用条款</text></view><text class="row-arrow">→</text></view><view class="privacy-row" bindtap="openPrivacyPolicy"><view class="row-copy"><text class="row-title">隐私政策</text><text class="row-desc">了解我们如何处理信息</text></view><text class="row-arrow">→</text></view></view>
      <view class="privacy-section local-section"><view class="section-index"><text>本地数据</text></view><text class="local-title">清除只影响这台设备，且无法恢复。</text><text class="row-desc local-copy">云端观察记录和账户数据不会因此删除。</text><view class="privacy-action" bindtap="clearLocalData"><text>清除本地登录状态</text><text class="row-arrow">→</text></view></view>
      <view class="privacy-footer"><text>停用四时气韵不会自动删除历史记录。是否保留，由你决定。</text></view>
      <view class="privacy-actions"><view class="text-button" disabled="{{exporting}}" bindtap="exportData" role="button" tabindex="0">{{exporting ? '准备中…' : '复制云端数据'}}</view><view class="text-button danger-text" disabled="{{submittingDeletion || cancellingDeletion}}" bindtap="requestDeletion" role="button" tabindex="0">申请删除云端数据</view><view wx:if="{{deletion && deletion.status === 'pending' && deletion.canCancel}}" class="text-button" disabled="{{cancellingDeletion}}" bindtap="cancelDeletion" role="button" tabindex="0">取消删除申请</view></view>
    </view>
  </block>
  <view wx:if="{{message}}" class="privacy-message" role="status">{{message}}</view><view wx:if="{{error && !loading}}" class="privacy-error" role="alert">{{error}}</view>
  <view class="privacy-tabbar"><view class="tab-item" data-index="0" bindtap="switchTab"><text class="tab-icon">○</text><text>首页</text></view><view class="tab-item" data-index="1" bindtap="switchTab"><text class="tab-icon">≡</text><text>实践</text></view><view class="tab-item selected" data-index="2" bindtap="switchTab"><text class="tab-icon">◎</text><text>我的</text></view></view>
</view>

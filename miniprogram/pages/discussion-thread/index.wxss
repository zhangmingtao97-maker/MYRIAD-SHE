@import "../discussion/index.wxss";

.thread-intro { padding: 48rpx 0 40rpx; }
.thread-title { margin-top: 40rpx; color: #4a3f38; font-size: 46rpx; font-weight: 600; line-height: 1.5; white-space: pre-line; letter-spacing: .5rpx; }
.thread-lead { margin-top: 40rpx; color: #4a3f38; font-size: 27rpx; font-weight: 600; line-height: 1.85; }
.thread-note { margin-top: 36rpx; color: #8b6b58; font-size: 21rpx; line-height: 1.7; }
.thread-origin { padding: 46rpx 0 18rpx; border-top: 1rpx solid rgba(92, 73, 60, .26); }
.thread-actions { display: flex; min-height: 88rpx; align-items: center; justify-content: space-between; margin-top: 6rpx; }
.thread-replies { padding-top: 12rpx; border-top: 1rpx solid rgba(92, 73, 60, .26); }
.thread-section-title { padding: 40rpx 0 6rpx; color: #5c493c; font-size: 29rpx; font-weight: 700; }
.thread-reply { margin: 26rpx 0 0 8rpx; padding: 4rpx 0 12rpx 28rpx; border-left: 2rpx solid rgba(92, 73, 60, .45); }
.thread-reply-meta { display: flex; align-items: baseline; gap: 18rpx; color: #4a3f38; font-size: 24rpx; line-height: 1.5; }
.thread-reply-to { margin-top: 10rpx; color: #8b6b58; font-size: 21rpx; line-height: 1.6; }
.thread-reply-body { margin-top: 16rpx; color: #4a3f38; font-size: 25rpx; font-weight: 500; line-height: 1.95; }
.thread-reply-local { border-left-color: rgba(102, 49, 36, .5); }
.thread-footer { margin-top: 8rpx; }
.thread-footer-primary { display: flex; min-height: 96rpx; align-items: center; justify-content: space-between; margin-top: 34rpx; border-bottom: 1rpx solid rgba(92, 73, 60, .55); color: #4a3f38; font-size: 27rpx; font-weight: 600; }
.thread-footer-secondary { display: flex; min-height: 92rpx; align-items: center; justify-content: space-between; color: #4a3f38; font-size: 26rpx; font-weight: 600; }
.thread-footer text { color: #663124; font-family: Georgia, serif; font-size: 30rpx; }

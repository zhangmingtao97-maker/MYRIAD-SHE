<view class="discussion-page">
  <view class="discussion-topbar" style="padding-top: {{statusBarHeight}}px">
    <view class="discussion-control discussion-back" style="top: {{statusBarHeight}}px" role="button" aria-label="返回" tabindex="0" bindtap="handleBack">‹</view>
    <text class="discussion-nav-title">一段对话</text>
    <view class="discussion-control discussion-more" style="top: {{statusBarHeight}}px" role="button" aria-label="更多讨论选项" tabindex="0" bindtap="handleMore">···</view>
  </view>
  <view wx:if="{{loading}}" class="discussion-state" role="status" aria-live="polite">正在读取这段对话…</view>
  <view wx:elif="{{error}}" class="discussion-state discussion-error" role="alert"><text>{{error}}</text><view class="discussion-retry" role="button" aria-label="重新读取这段对话" tabindex="0" bindtap="load">重新读取</view></view>
  <block wx:elif="{{thread}}">
    <view class="thread-intro">
      <view class="discussion-meta"><text class="discussion-number">{{number}}</text><text class="discussion-kicker">本期讨论 · 一段对话</text></view>
      <view class="thread-title">从这一段经历，
继续谈起。</view>
      <view class="thread-lead">{{intro}}</view>
      <view class="thread-note">示例内容 · 新写的经历会进入运营后台，不会自动公开。</view>
    </view>
    <view class="thread-origin">
      <view class="discussion-thread-meta"><text class="discussion-author">{{thread.author}}</text><text class="discussion-example-label">示例</text></view>
      <view class="discussion-thread-body">{{thread.body}}</view>
      <view class="thread-actions">
        <view class="discussion-reply-action" role="button" aria-label="回应{{thread.author}}" tabindex="0" data-author="{{thread.author}}" bindtap="replyTo">回应{{thread.author}} <text>↗</text></view>
        <view class="discussion-report" role="button" aria-label="{{reported ? '已举报' : '举报'}}{{thread.author}}" tabindex="0" bindtap="reportThread">{{reported ? '已举报' : '举报'}}</view>
      </view>
    </view>
    <view wx:if="{{thread.replies.length || localReplies.length}}" class="thread-replies">
      <view class="thread-section-title">接着这段经历</view>
      <view wx:for="{{thread.replies}}" wx:key="id" class="thread-reply">
        <view class="thread-reply-meta"><text class="discussion-author">{{item.author}}</text><text class="discussion-example-label">示例</text></view>
        <view class="thread-reply-to">回应 {{thread.author}} 的示例</view>
        <view class="thread-reply-body">{{item.body}}</view>
        <view class="thread-actions">
          <view class="discussion-reply-action" role="button" aria-label="回应{{item.author}}" tabindex="0" data-author="{{item.author}}" bindtap="replyTo">回应{{item.author}} <text>↗</text></view>
          <view class="discussion-report" role="button" aria-label="{{reported ? '已举报' : '举报'}}{{item.author}}" tabindex="0" bindtap="reportThread">{{reported ? '已举报' : '举报'}}</view>
        </view>
      </view>
      <view wx:for="{{localReplies}}" wx:for-item="reply" wx:key="id" class="thread-reply thread-reply-local">
        <view class="thread-reply-meta"><text class="discussion-author">你</text><text class="discussion-example-label">本机</text></view>
        <view class="thread-reply-to">回应 {{thread.author}} 的示例</view>
        <view class="thread-reply-body">{{reply.body}}</view>
      </view>
    </view>
    <view class="thread-footer">
      <view class="thread-footer-primary" role="button" aria-label="接着谈谈" tabindex="0" bindtap="continueTalk">接着谈谈 <text>→</text></view>
      <view class="thread-footer-secondary" role="button" aria-label="查看本期其他经历" tabindex="0" bindtap="viewOtherThreads">查看本期其他经历 <text>→</text></view>
    </view>
  </block>
  <view class="discussion-tabbar" role="tablist" aria-label="小程序底部导航">
    <view class="discussion-tab selected" role="tab" aria-label="首页" aria-selected="true" tabindex="0" data-index="0" bindtap="switchTab"><view class="discussion-tab-icon discussion-home-icon"><view></view></view><text>首页</text></view>
    <view class="discussion-tab" role="tab" aria-label="实践" aria-selected="false" tabindex="0" data-index="1" bindtap="switchTab"><view class="discussion-tab-icon discussion-practice-icon"><view></view><view></view></view><text>实践</text></view>
    <view class="discussion-tab" role="tab" aria-label="我的" aria-selected="false" tabindex="0" data-index="2" bindtap="switchTab"><view class="discussion-tab-icon discussion-mine-icon"><view class="discussion-mine-head"></view><view class="discussion-mine-body"></view></view><text>我的</text></view>
  </view>
</view>

<view class="page practice-page">
  <view class="brand-topbar" style="padding-top: {{statusBarHeight}}px"><view class="brand-topbar-copy" aria-label="MYRIAD SHE">MYRIAD SHE</view></view>
  <view class="practice-meta"><rich-text class="eyebrow practice-meta-copy" nodes="{{metaLeftRichText}}" style="font-size: {{metaLeftFontSize}}px; color: {{metaLeftColor}};" /><rich-text class="practice-meta-label practice-meta-copy" nodes="{{metaRightRichText}}" style="font-size: {{metaRightFontSize}}px; color: {{metaRightColor}};" /></view>
  <rich-text class="practice-kicker" nodes="{{titleRichText}}" style="font-size: {{titleFontSize}}px; color: {{titleColor}};" />
  <rich-text class="title" nodes="{{introRichText}}" style="font-size: {{introFontSize}}px; color: {{introColor}};" />
  <view class="practice-intro">不是要求自己平静，而是看清正在发生什么，然后再选择下一步。</view>

  <view wx:if="{{loading}}" class="practice-directory practice-skeleton" role="status" aria-label="正在读取实践目录">
    <view class="skeleton-heading"></view>
    <view wx:for="{{[1, 2, 3]}}" wx:key="*this" class="skeleton-entry"><view class="skeleton-line"></view><view class="skeleton-line short"></view></view>
  </view>
  <view wx:elif="{{error}}" class="error-state" role="alert"><view class="error-text">{{error}}</view><view class="button secondary" role="button" aria-label="重新读取实践内容" tabindex="0" bindtap="load">重新读取</view></view>
  <view wx:else class="practice-directory" aria-label="实践目录">
    <view class="directory-heading"><view class="eyebrow">实践目录</view><view class="page-code">PRACTICE</view></view>
    <block wx:for="{{entries}}" wx:key="key">
      <view class="practice-entry entry-enter {{item.enabled ? 'active-entry' : 'disabled-entry'}}" role="button" aria-label="{{item.title}}，{{item.enabled ? item.description : '暂未开放'}}" aria-disabled="{{!item.enabled}}" tabindex="0" bindtap="handleEntryTap" data-key="{{item.key}}" style="animation-delay: {{index * 60}}ms;">
        <text class="entry-number">{{index + 1 < 10 ? '0' + (index + 1) : index + 1}}</text>
        <view class="entry-copy">
          <rich-text class="entry-context" nodes="{{item.contextRichText}}" style="font-size: {{item.contextFontSize}}px; color: {{item.contextColor}};" />
          <rich-text class="entry-title" nodes="{{item.titleRichText}}" style="font-size: {{item.titleFontSize}}px; color: {{item.titleColor}};" />
          <rich-text class="entry-desc" nodes="{{item.descriptionRichText}}" style="font-size: {{item.descriptionFontSize}}px; color: {{item.descriptionColor}};" />
        </view>
        <text class="entry-arrow">→</text>
      </view>
    </block>
  </view>

  <view class="practice-refresh-status" role="status" aria-live="polite">
    <view wx:if="{{refreshError}}">暂未更新，当前目录仍可查看。<text class="refresh-retry" role="button" bindtap="load" aria-label="重试刷新实践目录">重试</text></view>
  </view>
  <view class="page-signature" aria-label="实践页页尾文案">
    <view class="signature-grid">
      <rich-text class="signature-kicker signature-brand" nodes="{{footerCopy.brand.richText}}" style="font-size: {{footerCopy.brand.fontSize}}px; color: {{footerCopy.brand.color}};" />
      <rich-text class="signature-line" nodes="{{footerCopy.line1.richText}}" style="font-size: {{footerCopy.line1.fontSize}}px; color: {{footerCopy.line1.color}};" />
      <rich-text class="signature-kicker" nodes="{{footerCopy.label.richText}}" style="font-size: {{footerCopy.label.fontSize}}px; color: {{footerCopy.label.color}};" />
      <rich-text class="signature-line" nodes="{{footerCopy.line2.richText}}" style="font-size: {{footerCopy.line2.fontSize}}px; color: {{footerCopy.line2.color}};" />
    </view>
    <image class="signature-flower" src="/assets/brand/practice-signature-flower.svg" mode="aspectFit" aria-hidden="true" />
  </view>

</view>

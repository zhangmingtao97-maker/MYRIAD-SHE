.webview-state { display: flex; min-height: 70vh; align-items: center; justify-content: center; flex-direction: column; gap: 28rpx; padding: 48rpx 36rpx; color: #5c493c; font-family: "Source Han Serif CN", "Source Han Serif SC", "Noto Serif CJK SC", "Songti SC", STSong, serif; }
.webview-error { font-size: 28rpx; line-height: 1.8; text-align: center; }
.webview-back { padding: 18rpx 32rpx; border: 1rpx solid rgba(92, 73, 60, .36); border-radius: 999rpx; color: #663124; font-size: 26rpx; line-height: 1.4; }

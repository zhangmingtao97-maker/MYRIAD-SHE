<web-view wx:if="{{url}}" src="{{url}}" bindload="handleLoad" binderror="handleError"></web-view>
<view wx:else class="webview-state">
  <view class="webview-error">{{error || '网页暂时无法打开'}}</view>
  <view wx:if="{{targetUrl}}" class="webview-url">{{targetUrl}}</view>
  <view wx:if="{{targetUrl}}" class="webview-actions">
    <view class="webview-action" role="button" tabindex="0" bindtap="copyLink">复制链接</view>
    <view class="webview-action webview-action-primary" role="button" tabindex="0" bindtap="handleBack">返回上一页</view>
  </view>
</view>

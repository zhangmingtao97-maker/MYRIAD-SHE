<view class="policy-page">
  <view class="policy-topbar" style="padding-top: {{statusBarHeight}}px">
    <view class="topbar-row">
      <view class="icon-button" aria-label="返回" bindtap="handleBack" role="button" tabindex="0">‹</view>
      <text class="topbar-title">{{label}}</text>
      <view class="icon-button" aria-label="更多" bindtap="handleMore" role="button" tabindex="0">···</view>
    </view>
  </view>

  <view wx:if="{{loading}}" class="policy-state" role="status" aria-live="polite">正在读取{{label}}…</view>
  <view wx:elif="{{error}}" class="policy-state error-state" role="alert">
    <text>{{error}}</text>
    <view class="text-button" bindtap="load" role="button" tabindex="0">重新读取</view>
  </view>
  <view wx:elif="{{content}}" class="policy-content">
    <rich-text class="policy-title" nodes="{{content.title.richText}}"></rich-text>
    <rich-text wx:if="{{content.intro.richText}}" class="policy-intro" nodes="{{content.intro.richText}}"></rich-text>
    <view class="policy-dates">
      <text wx:if="{{content.updatedDate}}">更新 {{content.updatedDate}}</text>
      <text>生效 {{content.effectiveDate}} · 版本 {{content.version}}</text>
    </view>
    <text wx:if="{{content.updateNotes}}" class="policy-update-notes">本次更新：{{content.updateNotes}}</text>
    <view class="policy-body"><rich-text nodes="{{bodyNodes}}"></rich-text></view>
  </view>
  <view wx:if="{{content}}" class="policy-footer" aria-hidden="true">MYRIAD SHE</view>
</view>

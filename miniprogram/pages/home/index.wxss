.audio-kicker { display: grid; grid-template-columns: 88rpx 1fr auto; align-items: center; color: #663124; font-family: Garamond, "Times New Roman", "Source Han Serif SC", "Songti SC", STSong, serif; font-size: 24rpx; line-height: 1.4; letter-spacing: .12em; }

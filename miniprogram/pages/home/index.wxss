.module-question { margin: 0 8rpx; padding: 44rpx 0 76rpx; border-top-color: rgba(92, 73, 60, .24); color: #5c493c; font-family: "Source Han Serif CN", "Source Han Serif SC", "Noto Serif CJK SC", "Songti SC", STSong, serif; letter-spacing: .01em; }
.question-kicker { display: grid; grid-template-columns: 88rpx 1fr; align-items: baseline; color: #663124; font-family: Garamond, "Times New Roman", "Source Han Serif SC", "Songti SC", STSong, serif; font-size: 24rpx; line-height: 1.4; letter-spacing: .12em; }
.question-label { letter-spacing: .12em; }

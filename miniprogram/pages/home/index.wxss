@import "../../app.wxss";
page { --home-paper: #e9e0d2; background: var(--home-paper); }
.home-page { position: relative; padding: 0 48rpx 160rpx; background: var(--home-paper); color: #40362f; text-align: left; text-indent: 0; }
.home-background, .home-background-scrim { position: fixed; top: 0; right: 0; bottom: 0; left: 0; width: 100%; height: 100%; pointer-events: none; }
.home-background { z-index: 0; }
.home-background-scrim { z-index: 1; background: rgba(233, 224, 210, .82); }
.home-content { position: relative; z-index: 2; }
.home-content rich-text { display: block; min-width: 0; text-indent: 0; overflow-wrap: anywhere; }
.home-page .brand-topbar { margin: 0 -48rpx; padding-right: 48rpx; padding-left: 48rpx; border-bottom-color: #d8cbbb; background: var(--home-paper); }
.home-intro { margin-top: 20rpx; color: #67594e; font-size: 26rpx; line-height: 1.7; }
.home-content .eyebrow { font-size: 24rpx; line-height: 1.5; }
.home-content .muted { color: #67594e; font-size: 32rpx; line-height: 1.8; }
.home-page [role="button"]:active { background-color: rgba(102, 49, 36, .06); }
.home-page [role="button"]:focus { outline: 2rpx solid #956b55; outline-offset: 5rpx; }
.issue-meta { display: flex; flex-direction: column; align-items: flex-start; gap: 10rpx; padding: 16rpx 0 28rpx; font-size: 32rpx; line-height: 1.4; }
.issue-meta-kicker { color: #8b6b58; font-family: "MYRIAD Garamond", "MYRIAD Song", serif; font-size: 24rpx; line-height: 1.5; letter-spacing: 4rpx; }
.issue-meta-number { color: inherit; font-family: "MYRIAD Garamond", "MYRIAD Song", serif; font-size: 1em; letter-spacing: 2rpx; text-transform: uppercase; }
.issue-meta-edition { color: #8b6b58; font-family: "MYRIAD Garamond", "MYRIAD Song", serif; font-size: 24rpx; line-height: 1.5; letter-spacing: 2rpx; text-transform: uppercase; }
.issue-meta-rich-text { display: block; width: 100%; color: inherit; line-height: 1.5; }
.loading-state, .error-state { padding: 70rpx 0; }
.error-state { color: #a53f32; }
.error-text { line-height: 1.7; }
.issue-cover { display: block; width: 100%; height: 960rpx; object-fit: cover; }
.detail-image { display: block; width: 100%; height: 720rpx; object-fit: cover; }
.cover-empty { display: flex; align-items: center; justify-content: center; height: 960rpx; background: #e9e0d5; color: #88786b; font-family: "MYRIAD Garamond", "MYRIAD Song", serif; font-size: 34rpx; }
.cover-caption { display: flex; align-items: center; justify-content: space-between; gap: 24rpx; min-height: 58rpx; margin: 0; padding: 16rpx 48rpx; box-sizing: border-box; background: transparent; color: #806854; font-family: "MYRIAD Garamond", "MYRIAD Song", serif; font-size: 26rpx; line-height: 1.7; }
.cover-caption-left, .cover-caption-right { min-width: 0; overflow-wrap: anywhere; }
.cover-caption-right { text-align: right; }
.hero-copy { padding: 72rpx 0; }
.hero-title { margin: 32rpx 0 28rpx; font-family: "MYRIAD Garamond", "MYRIAD Song", serif; color: #40362f; font-size: 48rpx; line-height: 1.5; }
.editorial-section { padding: 72rpx 0; border-top: 1rpx solid #cdbbae; }
.section-number { color: #8b6b58; font-family: "MYRIAD Garamond", "MYRIAD Song", serif; font-size: 24rpx; letter-spacing: 2rpx; }
.section-title { margin: 32rpx 0 28rpx; color: #40362f; font-family: "MYRIAD Garamond", "MYRIAD Song", serif; font-size: 48rpx; font-weight: 600; line-height: 1.5; }
.section-copy { color: #67594e; font-size: 32rpx; line-height: 1.8; }
.text-button { display: inline-flex; align-items: center; gap: 24rpx; min-height: 88rpx; margin-top: 32rpx; padding: 0; border: 0; background: transparent; color: #663124; font-size: 32rpx; text-align: left; }
.text-button text { font-size: 34rpx; }
.detail-image-wrap { margin: 0 -48rpx; }
.voice-player { width: 100%; margin: 18rpx 0 12rpx; }
.observation-section .button { margin-top: 34rpx; }
.contents-section { padding: 42rpx 0 20rpx; border-top: 1rpx solid #cdbbae; }
.contents-row { display: grid; grid-template-columns: 72rpx 1fr 48rpx; align-items: center; width: 100%; min-height: 96rpx; padding: 18rpx 0; border: 0; border-bottom: 1rpx solid #e4dbd1; background: transparent; color: #40362f; text-align: left; }
.contents-number { color: #8b6b58; font-family: "MYRIAD Garamond", "MYRIAD Song", serif; font-size: 22rpx; }
.contents-label { font-family: "MYRIAD Garamond", "MYRIAD Song", serif; font-size: 31rpx; }
.contents-arrow { color: #663124; font-size: 34rpx; text-align: right; }
.module-issueMeta { padding: 0 0 18rpx; border-top: 0; }
.module-cover, .module-image { margin-right: -48rpx; margin-left: -48rpx; padding-top: 0; border-top: 0; }
.module-cover .issue-cover, .module-image .issue-cover, .module-cover .cover-empty, .module-image .cover-empty { height: 960rpx; }
.module-coverStory { margin: 0 -48rpx; padding: 0; border-top: 0; }
.cover-story-image-wrap .issue-cover, .cover-story-image-wrap .cover-empty { height: 960rpx; }
.cover-story-caption { display: flex; align-items: center; justify-content: space-between; gap: 24rpx; min-height: 58rpx; padding: 16rpx 48rpx; background: transparent; color: #67594e; font-family: "MYRIAD Garamond", "MYRIAD Song", serif; font-size: 26rpx; line-height: 1.7; }
.cover-story-caption rich-text { display: block; min-width: 0; }
.cover-story-caption rich-text:last-child { text-align: right; }
.cover-story-copy { padding: 72rpx 48rpx; background: transparent; }
.cover-story-copy .eyebrow { color: #976e59; font-family: "MYRIAD Garamond", "MYRIAD Song", serif; font-size: 24rpx; letter-spacing: 2rpx; }
.cover-story-title { margin-top: 32rpx; color: #59483d; font-family: "MYRIAD Garamond", "MYRIAD Song", serif; font-size: 72rpx; font-weight: 600; line-height: 1.17; white-space: pre-wrap; }
.cover-story-description { margin-top: 28rpx; color: #40362f; font-family: "MYRIAD Garamond", "MYRIAD Song", serif; font-size: 32rpx; font-weight: 400; line-height: 1.8; white-space: pre-wrap; }
.cover-story-byline { margin-top: 32rpx; color: #8a6755; font-family: "MYRIAD Garamond", "MYRIAD Song", serif; font-size: 26rpx; line-height: 1.7; letter-spacing: 1rpx; }
.module-body { margin-top: 28rpx; white-space: pre-wrap; }
.module-story { margin: 0; border-top-color: #c3b4a4; color: #5c493c; font-family: "MYRIAD Garamond", "MYRIAD Song", serif; letter-spacing: .01em; }
.story-kicker { display: grid; grid-template-columns: 88rpx minmax(0, 1fr); align-items: baseline; }
.story-kicker .section-number, .story-kicker .eyebrow { margin: 0; color: #663124; font-family: "MYRIAD Garamond", "MYRIAD Song", serif; font-size: 24rpx; font-weight: 400; line-height: 1.4; letter-spacing: .12em; }
.story-quote { margin: 32rpx 0 28rpx; color: #40362f; font-size: 48rpx; font-weight: 600; line-height: 1.5; white-space: pre-wrap; }
.story-body { color: #51443a; font-size: 32rpx; font-weight: 400; line-height: 1.8; white-space: pre-wrap; }
.story-text-link { display: flex; align-items: center; justify-content: space-between; gap: 24rpx; min-height: 88rpx; margin-top: 32rpx; color: #663124; font-size: 32rpx; font-weight: 600; line-height: 1.5; }
.story-link-arrow { font-family: "MYRIAD Garamond", "MYRIAD Song", serif; }
.story-image-wrap { margin-top: 48rpx; }
.story-image { display: block; width: 100%; height: 462rpx; object-fit: cover; object-position: 78% 74%; }
.story-caption { display: grid; grid-template-columns: minmax(0, 1fr); align-items: start; gap: 12rpx; margin-top: 24rpx; color: #67594e; font-size: 26rpx; line-height: 1.7; }
.story-caption rich-text { display: block; min-width: 0; }
.story-caption rich-text:first-child { color: #663124; font-family: "MYRIAD Garamond", "MYRIAD Song", serif; font-size: 24rpx; line-height: 1.55; }
.story-caption rich-text:last-child { text-align: left; }
.story-action { position: relative; min-height: 92rpx; padding: 30rpx 72rpx 30rpx 0; border-top: 1rpx solid #cdbbae; border-bottom: 1rpx solid #cdbbae; color: #66564c; }
.story-action .section-title { margin: 0; color: #663124; font-family: "MYRIAD Garamond", "MYRIAD Song", serif; font-size: 32rpx; font-weight: 600; }
.story-action .section-copy { margin-top: 8rpx; font-size: 26rpx; line-height: 1.7; }
.story-action-arrow { position: absolute; top: 28rpx; right: 4rpx; color: #8c604b; font-family: "MYRIAD Garamond", "MYRIAD Song", serif; font-size: 36rpx; }
.module-quote { color: #663124; font-family: "MYRIAD Garamond", "MYRIAD Song", serif; font-size: 48rpx; line-height: 1.5; text-align: left; }
.home-content .module-quote-copy { display: inline; }
.module-quote .section-copy { margin-top: 28rpx; font-size: 26rpx; text-align: left; }
.module-audio { margin: 0; border-top-color: rgba(92, 73, 60, .24); color: #5c493c; font-family: "MYRIAD Garamond", "MYRIAD Song", serif; }
.audio-kicker { display: grid; grid-template-columns: 88rpx minmax(0, 1fr) auto; align-items: center; color: #663124; font-family: "MYRIAD Garamond", "MYRIAD Song", serif; font-size: 24rpx; line-height: 1.4; letter-spacing: .12em; }
.audio-number, .audio-label, .audio-duration { min-width: 0; }
.audio-kicker-meta { display: flex; min-width: 0; align-items: center; justify-content: flex-end; gap: 18rpx; }
.audio-duration { text-align: right; letter-spacing: .04em; }
.audio-progress { min-width: 0; margin: 24rpx 0 0 88rpx; }
.audio-progress-hit { padding: 20rpx 0; margin: -20rpx 0; }
.audio-progress-track { position: relative; height: 4rpx; border-radius: 4rpx; background: rgba(92, 73, 60, .2); }
.audio-progress-fill { height: 100%; border-radius: 4rpx; background: #663124; transition: width 200ms linear; }
.audio-progress-thumb { position: absolute; top: 50%; width: 18rpx; height: 18rpx; margin: -9rpx 0 0 -9rpx; border-radius: 50%; background: #663124; box-shadow: 0 0 0 6rpx rgba(102, 49, 36, .12); transition: left 200ms linear; }
.audio-seek-active .audio-progress-fill, .audio-seek-active .audio-progress-thumb { transition: none; }
.audio-progress-times { display: flex; justify-content: space-between; margin-top: 10rpx; color: #8a6755; font-family: "MYRIAD Garamond", "MYRIAD Song", serif; font-size: 22rpx; line-height: 1.3; letter-spacing: .04em; }
.audio-play { display: flex; width: 88rpx; height: 56rpx; align-items: center; justify-content: flex-start; padding-top: 0; color: #5c493c; font-family: "MYRIAD Garamond", "MYRIAD Song", serif; font-size: 28rpx; line-height: 1.5; box-sizing: border-box; }
.audio-play:active { opacity: .62; }
.audio-player { display: grid; grid-template-columns: 88rpx minmax(0, 1fr); align-items: center; margin-top: 24rpx; }
.audio-player .audio-play { height: 56rpx; align-items: center; padding-top: 0; font-size: 28rpx; }
.audio-player-main { min-width: 0; }
.audio-player-main .audio-progress { margin: 0; }
.audio-player-main .audio-progress-times { margin-top: 8rpx; }
.audio-video { display: block; width: 100%; height: 340rpx; margin-top: 24rpx; background: #231d19; }
.audio-copy { margin: 32rpx 0 0; }
.audio-quote { color: #40362f; font-size: 48rpx; font-weight: 600; line-height: 1.5; white-space: pre-wrap; }
.audio-subtitle { margin-top: 24rpx; color: #67594e; font-size: 26rpx; font-weight: 400; line-height: 1.7; }
.audio-media-kind { display: inline-block; padding: 3rpx 14rpx; border: 1rpx solid rgba(102, 49, 36, .28); border-radius: 999rpx; color: #663124; font-family: "MYRIAD Garamond", "MYRIAD Song", serif; font-size: 20rpx; line-height: 1.5; letter-spacing: .08em; }
.audio-enter-actions { display: flex; align-items: stretch; gap: 24rpx; margin: 32rpx 0 0; border-top: 1rpx solid rgba(92, 73, 60, .2); }
.audio-enter { display: flex; min-width: 0; min-height: 88rpx; flex: 1; align-items: center; padding: 16rpx 0; justify-content: space-between; gap: 24rpx; color: #663124; font-size: 32rpx; font-weight: 600; line-height: 1.5; }
.audio-enter text:last-child { font-family: "MYRIAD Garamond", "MYRIAD Song", serif; font-size: 30rpx; }
.audio-enter:active { opacity: .62; }
.audio-transcript { margin: 28rpx 0 0; color: #51443a; font-size: 32rpx; line-height: 1.8; white-space: pre-wrap; }
.module-question { margin: 0; border-top-color: rgba(92, 73, 60, .24); color: #5c493c; font-family: "MYRIAD Garamond", "MYRIAD Song", serif; letter-spacing: .01em; }
.question-kicker { display: grid; grid-template-columns: 88rpx minmax(0, 1fr); align-items: baseline; color: #663124; font-family: "MYRIAD Garamond", "MYRIAD Song", serif; font-size: 24rpx; line-height: 1.4; letter-spacing: .12em; }
.question-label { letter-spacing: .12em; }
.question-intro { margin: 32rpx 0 0; color: #67594e; font-family: "MYRIAD Garamond", "MYRIAD Song", serif; font-size: 26rpx; line-height: 1.7; letter-spacing: .04em; text-align: left; }
.question-title { margin: 32rpx 0 0; color: #40362f; font-size: 48rpx; font-weight: 600; line-height: 1.5; letter-spacing: .01em; text-align: left; white-space: pre-wrap; }
.question-intro + .question-title { margin-top: 24rpx; }
.question-body { margin: 28rpx 0 0; color: #51443a; font-size: 32rpx; font-weight: 400; line-height: 1.8; white-space: pre-wrap; }
.question-actions { margin-top: 32rpx; padding: 0; border: 0; border-radius: 0; background: transparent; }
.question-action { display: flex; min-height: 112rpx; align-items: center; justify-content: space-between; gap: 24rpx; padding: 28rpx 0; border-bottom: 1rpx solid #ded3c5; color: #40362f; box-sizing: border-box; }
.question-action:last-child { border-bottom: 0; }
.question-action-main { flex: 1; min-width: 0; }
.question-action-title { color: #663124; font-size: 32rpx; font-weight: 600; line-height: 1.5; text-align: left; }
.question-action-copy { margin-top: 8rpx; color: #67594e; font-size: 26rpx; line-height: 1.7; text-align: left; }
.question-action-arrow { flex: 0 0 auto; padding-top: 2rpx; color: #663124; font-family: "MYRIAD Garamond", "MYRIAD Song", serif; font-size: 30rpx; line-height: 1.4; text-align: right; }
.question-action:active { background-color: #f4ebe0; }
.module-action { border-bottom: 1rpx solid #cdbbae; }
.module-action .section-title { font-size: 48rpx; }
.module-contents { margin: 0; }
.contents-heading { display: flex; align-items: baseline; justify-content: space-between; gap: 32rpx; margin-bottom: 32rpx; color: #663124; font-family: "MYRIAD Garamond", "MYRIAD Song", serif; font-size: 24rpx; line-height: 1.5; letter-spacing: .11em; }
.contents-title { color: #663124; }
.contents-english { color: #663124; font-family: "MYRIAD Garamond", "MYRIAD Song", serif; font-size: 24rpx; letter-spacing: .11em; }
.contents-row { display: grid; grid-template-columns: 88rpx 180rpx minmax(0, 1fr); align-items: center; min-height: 120rpx; gap: 0; padding: 24rpx 0; border-bottom: 1rpx solid rgba(92, 73, 60, .24); box-sizing: border-box; }
.contents-number { color: #663124; font-family: "MYRIAD Garamond", "MYRIAD Song", serif; font-size: 24rpx; letter-spacing: .04em; }
.contents-label { min-width: 0; color: #40362f; font-family: "MYRIAD Garamond", "MYRIAD Song", serif; font-size: 32rpx; font-weight: 500; line-height: 1.5; }
.contents-summary { min-width: 0; color: #67594e; font-family: "MYRIAD Garamond", "MYRIAD Song", serif; font-size: 26rpx; line-height: 1.65; }
.contents-row:active { background-color: #eee4d8; }
.module-archive { min-height: 0; margin: 0; color: #5c493c; }
.archive-heading { color: #8a6755; font-family: "MYRIAD Garamond", "MYRIAD Song", serif; font-size: 24rpx; line-height: 1.5; }
.archive-entry { display: grid; gap: 16rpx; margin-top: 32rpx; padding-bottom: 28rpx; border-bottom: 1rpx solid rgba(92, 73, 60, .24); }
.archive-entry-label { color: #8a6755; font-family: "MYRIAD Garamond", "MYRIAD Song", serif; font-size: 24rpx; line-height: 1.5; letter-spacing: .04em; }
.archive-entry-title { display: flex; align-items: baseline; justify-content: space-between; gap: 24rpx; color: #5c493c; font-family: "MYRIAD Garamond", "MYRIAD Song", serif; font-size: 32rpx; font-weight: 600; line-height: 1.5; }
.archive-entry-title text { flex: 0 0 auto; color: #663124; font-family: "MYRIAD Garamond", "MYRIAD Song", serif; font-size: 34rpx; line-height: 1; }
.module-brandFooter { margin: 0; padding: 0; border-top: 0; }
.footer-signature { position: relative; min-height: 520rpx; margin: 0; padding: 72rpx 0 24rpx; overflow: hidden; border-top: 1rpx solid #cdbbae; box-sizing: border-box; }
.footer-brand { color: #663124; font-family: "MYRIAD Garamond", "MYRIAD Song", serif; font-size: 42rpx; font-weight: 400; line-height: 1.35; }
.footer-title { margin-top: 64rpx; color: #5c493c; font-family: "MYRIAD Garamond", "MYRIAD Song", serif; font-size: 48rpx; font-weight: 600; line-height: 1.5; }
.footer-copy { position: relative; z-index: 1; max-width: 620rpx; margin-top: 28rpx; color: #40362f; font-family: "MYRIAD Garamond", "MYRIAD Song", serif; font-size: 32rpx; font-weight: 400; line-height: 1.8; }
.footer-flower { position: absolute; right: 8rpx; bottom: 0; width: 150rpx; height: 150rpx; opacity: .36; }
.footer-flower view { position: absolute; width: 58rpx; height: 76rpx; background: #a99181; border-radius: 58% 42% 62% 38%; }
.footer-flower view:nth-child(1) { top: 0; left: 46rpx; }
.footer-flower view:nth-child(2) { top: 37rpx; left: 83rpx; transform: rotate(90deg); }
.footer-flower view:nth-child(3) { top: 74rpx; left: 46rpx; transform: rotate(180deg); }
.footer-flower view:nth-child(4) { top: 37rpx; left: 9rpx; transform: rotate(270deg); }
.text-button::after, .contents-row::after { border: 0; }

.module-link { display: flex; min-height: 88rpx; align-items: center; justify-content: space-between; gap: 24rpx; margin: 32rpx 0 0; padding: 16rpx 0; border-top: 1rpx solid rgba(92, 73, 60, .24); color: #663124; font-family: "MYRIAD Garamond", "MYRIAD Song", serif; font-size: 32rpx; line-height: 1.5; box-sizing: border-box; }
.module-link:active { opacity: .62; }
.module-link-arrow { flex: 0 0 auto; font-size: 30rpx; line-height: 1.2; }

/* One reveal per section; content remains readable if observation is unavailable. */
.editorial-reveal.is-revealed { animation: editorial-arrive .34s cubic-bezier(.22,1,.36,1) both; }
@keyframes editorial-arrive { from { opacity: .65; transform: translateY(12rpx); } to { opacity: 1; transform: none; } }
.editorial-image { opacity: .25; background: #dcd2c5; transition: opacity .32s ease; }
.editorial-image.image-ready { opacity: 1; }
.audio-playback-status { min-height: 40rpx; margin: 12rpx 0 0; color: #67594e; font-size: 26rpx; line-height: 1.5; }
.audio-buffer-spinner { width: 24rpx; height: 24rpx; border: 3rpx solid rgba(102,49,36,.2); border-top-color: #663124; border-radius: 50%; animation: audio-buffer-turn .9s linear infinite; }
@keyframes audio-buffer-turn { to { transform: rotate(360deg); } }
.is-revealed .footer-flower { transform-origin: 50% 85%; animation: flower-unfold 1.4s cubic-bezier(.22,1,.36,1) both; }
@keyframes flower-unfold { from { opacity: .15; transform: rotate(-7deg) scale(.94); } to { opacity: .36; transform: rotate(0) scale(1); } }
@media (prefers-reduced-motion: reduce) {
  .editorial-reveal.is-revealed, .is-revealed .footer-flower, .audio-buffer-spinner { animation: none; transform: none; }
  .editorial-image { transition: none; }
}

.home-update-notice { position: fixed; z-index: 25; right: 24rpx; bottom: calc(140rpx + env(safe-area-inset-bottom)); left: 24rpx; display: flex; align-items: center; justify-content: space-between; gap: 16rpx; padding: 16rpx 24rpx; border: 1rpx solid #cdbbae; background: var(--home-paper); color: #5c493c; font-size: 24rpx; box-shadow: 0 6rpx 24rpx rgba(64,54,47,.08); }
.home-update-action { flex: 0 0 auto; min-height: 88rpx; margin: 0; padding: 0 12rpx; border: 0; background: transparent; color: #663124; font-size: 24rpx; line-height: 88rpx; }
.home-update-action::after { border: 0; }

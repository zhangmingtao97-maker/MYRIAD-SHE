@import "../../app.wxss";

page { min-height: 100vh; background: #e7dfd1; color: #5c493c; }
.discussion-page { min-height: 100vh; padding: 0 40rpx calc(160rpx + env(safe-area-inset-bottom)); box-sizing: border-box; background: #e7dfd1; color: #5c493c; font-family: "MYRIAD Song", "Source Han Serif CN", "Songti SC", serif; }
.discussion-topbar { position: sticky; z-index: 10; top: 0; display: flex; height: 44px; align-items: center; justify-content: center; margin: 0 -40rpx; border-bottom: 1rpx solid rgba(92, 73, 60, .23); background: #e7dfd1; box-sizing: content-box; }
.discussion-nav-title { color: #5c493c; font-size: 32rpx; font-weight: 700; line-height: 1.4; }
.discussion-control { position: absolute; display: flex; width: 88rpx; height: 44px; align-items: center; justify-content: center; color: #5c493c; }
.discussion-back { left: 20rpx; padding-bottom: 5rpx; font-family: Georgia, serif; font-size: 56rpx; line-height: 1; }
.discussion-more { right: 20rpx; padding-bottom: 17rpx; font-family: Georgia, serif; font-size: 30rpx; letter-spacing: 2rpx; }
.discussion-topbar [role="button"]:active, .discussion-page [role="button"]:active { opacity: .62; }
.discussion-intro { padding: 48rpx 0 78rpx; }
.discussion-meta { display: flex; align-items: baseline; gap: 36rpx; min-height: 30rpx; color: #8b6b58; font-size: 20rpx; line-height: 1.5; letter-spacing: 1rpx; }
.discussion-number { color: #663124; font-family: Georgia, serif; }
.discussion-issue-line { margin-top: 44rpx; color: #8b6b58; font-size: 20rpx; line-height: 1.5; letter-spacing: 1rpx; }
.discussion-title { margin-top: 40rpx; color: #4a3f38; font-size: 46rpx; font-weight: 600; line-height: 1.5; white-space: pre-line; letter-spacing: .5rpx; }
.discussion-lead { margin-top: 40rpx; color: #4a3f38; font-size: 27rpx; font-weight: 600; line-height: 1.85; }
.discussion-description { margin-top: 30rpx; color: #5c493c; font-size: 24rpx; font-weight: 400; line-height: 1.9; }
.discussion-write { display: flex; min-height: 76rpx; align-items: center; justify-content: space-between; gap: 24rpx; margin-top: 46rpx; border-bottom: 1rpx solid rgba(92, 73, 60, .55); color: #4a3f38; font-size: 27rpx; font-weight: 600; }
.discussion-external { font-family: Georgia, serif; font-size: 32rpx; }
.discussion-voices { margin-top: 0; border-top: 1rpx solid rgba(92, 73, 60, .26); }
.discussion-section-heading { display: flex; align-items: baseline; justify-content: space-between; gap: 20rpx; padding: 42rpx 0 24rpx; color: #5c493c; font-size: 31rpx; font-weight: 700; }
.discussion-example-badge { flex-shrink: 0; color: #663124; font-size: 21rpx; font-weight: 400; }
.discussion-example-note { color: #75675d; font-size: 22rpx; line-height: 1.8; }
.discussion-thread { padding: 46rpx 0 42rpx; border-bottom: 1rpx solid rgba(92, 73, 60, .26); }
.discussion-thread-meta { display: flex; align-items: baseline; gap: 20rpx; color: #4a3f38; font-size: 25rpx; line-height: 1.5; }
.discussion-author { font-weight: 600; }
.discussion-example-label, .discussion-reply-meta { color: #8b6b58; font-size: 21rpx; }
.discussion-thread-body { margin-top: 18rpx; color: #4a3f38; font-size: 26rpx; font-weight: 500; line-height: 1.95; }
.discussion-thread-actions { display: flex; align-items: center; justify-content: space-between; min-height: 88rpx; margin-top: 12rpx; }
.discussion-reply-action, .discussion-report { display: flex; min-height: 84rpx; align-items: center; color: #663124; font-size: 22rpx; }
.discussion-reply-action { gap: 10rpx; }
.discussion-reply-action text { font-size: 22rpx; }
.discussion-report { justify-content: flex-end; padding-left: 24rpx; color: #8b6b58; }
.discussion-replies { padding-left: 34rpx; border-left: 1rpx solid rgba(92, 73, 60, .24); }
.discussion-reply { padding: 34rpx 0 8rpx; }
.discussion-reply-meta { line-height: 1.6; }
.discussion-reply-body { margin-top: 14rpx; color: #5c493c; font-size: 25rpx; font-weight: 600; line-height: 1.85; }
.local-reply { border-top: 1rpx solid rgba(92, 73, 60, .16); }
.discussion-expand { display: flex; min-height: 84rpx; align-items: center; gap: 22rpx; margin-top: 20rpx; color: #663124; font-size: 26rpx; font-weight: 700; }
.discussion-expand text, .discussion-private-action text { font-family: Georgia, serif; font-size: 30rpx; }
.discussion-my-posts { border-bottom: 1rpx solid rgba(92, 73, 60, .26); }
.discussion-my-post { padding: 24rpx 0 36rpx; }
.discussion-private { margin-top: 72rpx; padding: 48rpx 8rpx 70rpx; border-top: 1rpx solid rgba(92, 73, 60, .26); }
.discussion-private-eyebrow { color: #8b6b58; font-size: 21rpx; line-height: 1.6; }
.discussion-private-title { margin-top: 48rpx; color: #5c493c; font-size: 44rpx; font-weight: 700; line-height: 1.65; white-space: pre-line; }
.discussion-private-body { margin-top: 30rpx; color: #5c493c; font-size: 25rpx; font-weight: 600; line-height: 1.8; }
.discussion-private-action { display: flex; min-height: 84rpx; align-items: center; justify-content: space-between; margin-top: 28rpx; color: #663124; font-size: 27rpx; font-weight: 700; }
.discussion-state { padding: 72rpx 0; color: #8b6b58; font-size: 26rpx; line-height: 1.8; }
.discussion-error { color: #8c4035; }
.discussion-retry { display: inline-flex; min-height: 88rpx; align-items: center; margin-top: 24rpx; border-bottom: 1rpx solid #cdbbae; color: #663124; }
.discussion-tabbar { position: fixed; z-index: 30; right: 0; bottom: 0; left: 0; display: flex; height: calc(120rpx + env(safe-area-inset-bottom)); padding: 0 24rpx env(safe-area-inset-bottom); border-top: 1rpx solid rgba(92, 73, 60, .23); background: #e7dfd1; box-sizing: border-box; }
.discussion-tab { display: flex; flex: 1; min-width: 0; min-height: 112rpx; flex-direction: column; align-items: center; justify-content: center; gap: 8rpx; color: #928276; }
.discussion-tab.selected { color: #663124; }
.discussion-tab-icon { position: relative; display: flex; width: 40rpx; height: 40rpx; align-items: center; justify-content: center; color: inherit; }
.discussion-home-icon { border: 2rpx solid currentColor; border-radius: 50%; }
.discussion-home-icon view { width: 8rpx; height: 8rpx; border-radius: 50%; background: currentColor; }
.discussion-practice-icon { flex-direction: column; justify-content: space-around; }
.discussion-practice-icon view { width: 26rpx; height: 7rpx; border: 2rpx solid currentColor; border-right: 0; border-left: 0; border-radius: 50%; }
.discussion-mine-icon { overflow: hidden; border: 2rpx solid currentColor; border-radius: 50%; }
.discussion-mine-head { position: absolute; top: 6rpx; left: 12rpx; width: 9rpx; height: 9rpx; border: 2rpx solid currentColor; border-radius: 50%; }
.discussion-mine-body { position: absolute; bottom: -7rpx; left: 6rpx; width: 21rpx; height: 16rpx; border: 2rpx solid currentColor; border-radius: 50% 50% 0 0; }
.discussion-tab text { color: inherit; font-size: 24rpx; line-height: 1.2; }
@media (prefers-reduced-motion: reduce) { .discussion-page [role="button"] { transition: none; transform: none; } }

/* 编辑追问 / 回应：左侧竖线引用块（对齐设计稿） */
.discussion-reply {
  position: relative;
  margin: 30rpx 0 0 8rpx;
  padding: 4rpx 0 4rpx 28rpx;
  border-left: 2rpx solid rgba(92, 73, 60, .45);
}
.discussion-reply-meta {
  color: #8b6b58;
  font-size: 21rpx;
  line-height: 1.5;
  letter-spacing: .5rpx;
}
.discussion-reply-body {
  margin-top: 14rpx;
  color: #5c493c;
  font-size: 24rpx;
  font-weight: 400;
  line-height: 1.95;
}
.discussion-reply.local-reply { border-left-color: rgba(102, 49, 36, .5); }
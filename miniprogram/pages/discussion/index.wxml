<view class="discussion-page">
  <view class="discussion-topbar" style="padding-top: {{statusBarHeight}}px">
    <view class="discussion-control discussion-back" style="top: {{statusBarHeight}}px" role="button" aria-label="返回" tabindex="0" bindtap="handleBack">‹</view>
    <text class="discussion-nav-title">本期讨论</text>
    <view class="discussion-control discussion-more" style="top: {{statusBarHeight}}px" role="button" aria-label="更多讨论选项" tabindex="0" bindtap="handleMore">···</view>
  </view>
  <view wx:if="{{loading}}" class="discussion-state" role="status" aria-live="polite">正在读取本期讨论…</view>
  <view wx:elif="{{error}}" class="discussion-state discussion-error" role="alert"><text>{{error}}</text><view class="discussion-retry" role="button" aria-label="重新读取本期讨论" tabindex="0" bindtap="load">重新读取</view></view>
  <block wx:elif="{{content}}">
    <view class="discussion-intro">
      <view class="discussion-meta"><rich-text class="discussion-number" nodes="{{copyHtml.number}}"></rich-text><rich-text class="discussion-kicker" nodes="{{copyHtml.kicker}}"></rich-text></view>
      <rich-text class="discussion-issue-line" nodes="{{copyHtml.issueLine}}"></rich-text>
      <rich-text class="discussion-title" nodes="{{copyHtml.title}}"></rich-text>
      <rich-text class="discussion-lead" nodes="{{copyHtml.intro}}"></rich-text>
      <rich-text class="discussion-description" nodes="{{copyHtml.paragraph1}}"></rich-text>
      <rich-text class="discussion-description" nodes="{{copyHtml.paragraph2}}"></rich-text>
      <rich-text class="discussion-description" nodes="{{copyHtml.paragraph3}}"></rich-text>
      <view class="discussion-write" role="button" aria-label="{{content.copy.writeAction}}" tabindex="0" bindtap="writeExperience"><rich-text class="discussion-action-copy" nodes="{{copyHtml.writeAction}}"></rich-text><text class="discussion-external" aria-hidden="true">↗</text></view>
      <view wx:if="{{draft}}" class="discussion-draft" role="button" aria-label="继续未完成的草稿" tabindex="0" bindtap="continueDraft"><text>继续未完成的草稿</text><text class="discussion-draft-arrow" aria-hidden="true">→</text></view>
    </view>
    <view class="discussion-voices">
      <view class="discussion-section-heading"><rich-text class="discussion-section-title" nodes="{{copyHtml.voicesTitle}}"></rich-text><rich-text class="discussion-example-badge" nodes="{{copyHtml.exampleBadge}}"></rich-text></view>
      <rich-text class="discussion-example-note" nodes="{{copyHtml.exampleNotice}}"></rich-text>
      <view wx:for="{{threads}}" wx:key="id" class="discussion-thread">
        <view class="discussion-thread-meta"><text class="discussion-author">{{item.author}}</text><text class="discussion-example-label">{{item.source === 'community' ? '读者分享' : '示例'}}</text><text wx:if="{{item.featured}}" class="discussion-featured-label">精华</text></view>
        <rich-text class="discussion-thread-body" nodes="{{item.bodyHtml}}"></rich-text>
        <view class="discussion-thread-actions"><view class="discussion-reply-action" role="button" aria-label="回复{{item.author}}" tabindex="0" data-thread-id="{{item.id}}" bindtap="replyToThread">回复{{item.author}} <text>↗</text></view><view class="discussion-report" role="button" aria-label="{{item.reported ? '已举报' : '举报'}}{{item.author}}" tabindex="0" data-thread-id="{{item.id}}" bindtap="reportThread">{{item.reported ? '已举报' : '举报'}}</view></view>
        <view wx:if="{{item.replies.length}}" class="discussion-expand" role="button" aria-label="查看{{item.author}}这段对话" tabindex="0" data-thread-id="{{item.id}}" bindtap="openConversation">查看这段对话<text>→</text></view>
      </view>
    </view>
    <view class="discussion-my-posts" wx:if="{{myPosts.length}}">
      <view class="discussion-section-heading"><text>我的本机发言</text><text class="discussion-example-badge">{{myPosts.length}} 条</text></view>
      <view wx:for="{{myPosts}}" wx:key="id" class="discussion-my-post"><view class="discussion-reply-meta">你 · 本机演示</view><rich-text class="discussion-reply-body" nodes="{{item.bodyHtml}}"></rich-text></view>
    </view>
    <view class="discussion-private">
      <rich-text class="discussion-private-eyebrow" nodes="{{copyHtml.selfEyebrow}}"></rich-text>
      <rich-text class="discussion-private-title" nodes="{{copyHtml.selfTitle}}"></rich-text>
      <rich-text class="discussion-private-body" nodes="{{copyHtml.selfBody}}"></rich-text>
      <view class="discussion-private-action" role="button" aria-label="{{content.copy.selfAction}}" tabindex="0" bindtap="openPrivateObservation"><rich-text class="discussion-action-copy" nodes="{{copyHtml.selfAction}}"></rich-text><text>→</text></view>
    </view>
  </block>
  <view class="discussion-tabbar" role="tablist" aria-label="小程序底部导航">
    <view class="discussion-tab selected" role="tab" aria-label="首页" aria-selected="true" tabindex="0" data-index="0" bindtap="switchTab"><view class="discussion-tab-icon discussion-home-icon"><view></view></view><text>首页</text></view>
    <view class="discussion-tab" role="tab" aria-label="实践" aria-selected="false" tabindex="0" data-index="1" bindtap="switchTab"><view class="discussion-tab-icon discussion-practice-icon"><view></view><view></view></view><text>实践</text></view>
    <view class="discussion-tab" role="tab" aria-label="我的" aria-selected="false" tabindex="0" data-index="2" bindtap="switchTab"><view class="discussion-tab-icon discussion-mine-icon"><view class="discussion-mine-head"></view><view class="discussion-mine-body"></view></view><text>我的</text></view>
  </view>
</view>

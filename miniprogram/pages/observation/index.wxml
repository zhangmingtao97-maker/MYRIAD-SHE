<view class="page observation-page">
  <view class="observation-topbar" style="padding-top: {{statusBarHeight}}px">
    <view class="observation-nav-row">
      <view class="observation-back" role="button" aria-label="返回上一级" tabindex="0" bindtap="handleBack">‹</view>
      <view class="observation-nav-title">{{navTitle}}</view>
    </view>
  </view>
  <view class="observation-content">
  <view wx:if="{{accountDeleted}}" class="panel account-deleted"><view class="eyebrow">云端账户</view><view class="title">账户已删除</view><view class="muted">此微信身份对应的云端账户已删除，当前观察不会继续保存。请回到“我的”页面确认是否创建新账户。</view><view wx:if="{{error}}" class="error-text" role="alert">{{error}}</view></view>
  <view wx:elif="{{phase === 'choose' && !saving && !error}}">
    <view class="choice-meta"><view><rich-text nodes="{{observationCopy.metaLeft.richText}}"></rich-text></view><view><rich-text nodes="{{observationCopy.metaRight.richText}}"></rich-text></view></view>
    <view class="choice-intro">
      <view class="title"><rich-text nodes="{{observationCopy.introTitle.richText}}"></rich-text></view>
      <view class="muted"><rich-text nodes="{{observationCopy.introDescription.richText}}"></rich-text></view>
    </view>
    <view wx:if="{{issueLoading}}" class="prompt-context"><view class="muted">正在读取关联问题…</view></view>
    <view wx:elif="{{issueQuestion}}" class="prompt-context"><view class="eyebrow">{{issueLabel || '观察来源'}}</view><view class="prompt-question">{{issueQuestion}}</view><view class="prompt-note">它会作为本次观察的起点，不会自动写入你的回答。</view></view>
    <view wx:if="{{issueError}}" class="issue-load-error"><view class="error-text" role="alert">{{issueError}}</view><view class="text-action" role="button" aria-label="重新读取关联问题" tabindex="0" bindtap="retryIssueContext">重新读取</view></view>

    <view class="method-section method-reality">
      <view class="method-index"><text>01</text><view class="method-context"><rich-text nodes="{{observationCopy.realityContext.richText}}"></rich-text></view></view>
      <view class="method-copy">
        <view class="method-title"><rich-text nodes="{{observationCopy.realityTitle.richText}}"></rich-text></view>
        <view class="method-description"><rich-text nodes="{{observationCopy.realityDescription.richText}}"></rich-text></view>
      </view>
      <view class="method-action" role="button" aria-label="从现实处境开始观察" aria-disabled="{{issueLoading}}" tabindex="0" bindtap="beginMethod" data-method="reality"><rich-text nodes="{{observationCopy.realityAction.richText}}"></rich-text> <text>→</text></view>
    </view>

    <view class="method-section method-season">
      <view class="method-index"><text>02</text><view class="method-context"><rich-text nodes="{{observationCopy.seasonContext.richText}}"></rich-text></view></view>
      <view class="method-copy">
        <view class="method-title"><rich-text nodes="{{observationCopy.seasonTitle.richText}}"></rich-text></view>
        <view class="method-description"><rich-text nodes="{{observationCopy.seasonDescription.richText}}"></rich-text></view>
        <view class="guide-action" role="button" aria-label="{{seasonGuideRead ? '复习四时气韵说明' : '必读：了解四时气韵是什么'}}" tabindex="0" bindtap="openSeasonGuide"><text class="guide-required {{seasonGuideRead ? 'is-read' : ''}}">{{seasonGuideRead ? '已读' : '必读'}}</text><rich-text nodes="{{observationCopy.seasonGuide.richText}}"></rich-text><text>↗</text></view>
      </view>
      <view class="method-action" role="button" aria-label="{{seasonPaused ? '四时气韵已暂停使用，点击重新开始' : '从四时气韵开始观察'}}" aria-disabled="{{issueLoading}}" tabindex="0" bindtap="beginMethod" data-method="season">
        <view wx:if="{{seasonPaused}}" class="season-action-paused">已暂停使用，重新开始</view>
        <rich-text wx:else nodes="{{observationCopy.seasonAction.richText}}"></rich-text><text>→</text>
      </view>
    </view>

    <view class="privacy-note"><view class="privacy-label"><rich-text nodes="{{observationCopy.privacyLabel.richText}}"></rich-text></view><view class="privacy-copy"><rich-text nodes="{{observationCopy.privacyCopy.richText}}"></rich-text></view></view>
  </view>
  <view wx:elif="{{saving && !selected}}" class="loading-state"><view class="eyebrow">云端草稿</view><view class="title">正在恢复草稿</view><view class="muted">读取完成后会回到上次尚未填写的步骤。</view></view>
  <view wx:elif="{{error && !selected && !saving}}" class="loading-state"><view class="eyebrow">云端草稿</view><view class="title">草稿未能打开</view><view class="error-text">{{error}}</view><view class="button" role="button" aria-label="重新读取草稿" tabindex="0" bindtap="retryRestore">重新读取</view><view class="button secondary" role="button" aria-label="返回选择观察方式" tabindex="0" bindtap="restart">返回选择观察方式</view></view>
  <view wx:elif="{{phase === 'form'}}">
    <view class="reality-stepper" aria-label="观察进度">
      <view wx:for="{{selected === 'reality' ? realitySteps : seasonSteps}}" wx:key="key" class="reality-stepper-item {{step === index ? 'active' : (step > index ? 'passed' : '')}}" aria-current="{{step === index ? 'step' : 'false'}}">
        <text class="reality-stepper-number">0{{index + 1}}</text><rich-text wx:if="{{selected === 'reality'}}" class="reality-stepper-label" nodes="{{item.copy.richText}}" style="font-size: {{item.copy.fontSize * 2}}rpx; color: {{item.copy.color}};"></rich-text><text wx:else class="reality-stepper-label">{{item.label}}</text>
      </view>
    </view>
    <view wx:if="{{selected === 'reality'}}" class="progress">0{{step + 1}} / 04 · <rich-text class="progress-stage-label" nodes="{{currentRealityStage.stageLabel.richText}}" style="font-size: {{currentRealityStage.stageLabel.fontSize * 2}}rpx; color: {{currentRealityStage.stageLabel.color}};"></rich-text></view>
    <view wx:if="{{issueQuestion}}" class="prompt-context"><view class="eyebrow">{{issueLabel || '观察来源'}}</view><view class="prompt-question">{{issueQuestion}}</view><view class="prompt-note">云端草稿保留创建时的问题；后续期刊更新不会改写这次观察的起点。</view></view>
    <block wx:if="{{selected === 'reality'}}">
      <view wx:if="{{step === 0}}" class="step reality-step reality-stage-body align-{{currentRealityStage.align}} spacing-{{currentRealityStage.spacing}}">
        <view class="title" style="font-size: {{currentRealityStage.title.fontSize * 2}}rpx; color: {{currentRealityStage.title.color}};"><rich-text nodes="{{currentRealityStage.title.richText}}"></rich-text></view>
        <view class="muted" style="font-size: {{currentRealityStage.description.fontSize * 2}}rpx; color: {{currentRealityStage.description.color}};"><rich-text nodes="{{currentRealityStage.description.richText}}"></rich-text></view>
        <view class="answer-label" style="font-size: {{currentRealityStage.inputLabel.fontSize * 2}}rpx; color: {{currentRealityStage.inputLabel.color}};"><rich-text nodes="{{currentRealityStage.inputLabel.richText}}"></rich-text></view>
        <textarea class="reality-answer" disabled="{{saving || advancing}}" maxlength="1000" data-field="situation" value="{{answers.situation}}" bindinput="handleInput" placeholder="{{currentRealityStagePlaceholder}}" placeholder-style="color: {{currentRealityStage.placeholder.color}}; font-size: {{currentRealityStage.placeholder.fontSize * 2}}rpx;" aria-label="写下此刻真实发生的事" />
      </view>
      <view wx:elif="{{step === 1}}" class="step reality-step reality-stage-body align-{{currentRealityStage.align}} spacing-{{currentRealityStage.spacing}}">
        <view class="title" style="font-size: {{currentRealityStage.title.fontSize * 2}}rpx; color: {{currentRealityStage.title.color}};"><rich-text nodes="{{currentRealityStage.title.richText}}"></rich-text></view>
        <view class="muted" style="font-size: {{currentRealityStage.description.fontSize * 2}}rpx; color: {{currentRealityStage.description.color}};"><rich-text nodes="{{currentRealityStage.description.richText}}"></rich-text></view>
        <view class="choice-grid" aria-label="选择此刻的感受"><view wx:for="{{feelingOptions}}" wx:key="*this" class="choice-option {{answers.body === item ? 'selected' : ''}}" role="button" aria-pressed="{{answers.body === item}}" aria-disabled="{{saving || advancing}}" tabindex="0" data-field="body" data-value="{{item}}" bindtap="selectOption">{{item}}</view></view>
        <view class="answer-label" style="font-size: {{currentRealityStage.inputLabel.fontSize * 2}}rpx; color: {{currentRealityStage.inputLabel.color}};"><rich-text nodes="{{currentRealityStage.inputLabel.richText}}"></rich-text></view>
        <textarea class="reality-answer" disabled="{{saving || advancing}}" maxlength="1000" data-field="body" value="{{answers.body}}" bindinput="handleInput" placeholder="{{currentRealityStagePlaceholder}}" placeholder-style="color: {{currentRealityStage.placeholder.color}}; font-size: {{currentRealityStage.placeholder.fontSize * 2}}rpx;" aria-label="用自己的话写下此刻的感受" />
      </view>
      <view wx:elif="{{step === 2}}" class="step reality-step reality-stage-body align-{{currentRealityStage.align}} spacing-{{currentRealityStage.spacing}}">
        <view class="title" style="font-size: {{currentRealityStage.title.fontSize * 2}}rpx; color: {{currentRealityStage.title.color}};"><rich-text nodes="{{currentRealityStage.title.richText}}"></rich-text></view>
        <view class="muted" style="font-size: {{currentRealityStage.description.fontSize * 2}}rpx; color: {{currentRealityStage.description.color}};"><rich-text nodes="{{currentRealityStage.description.richText}}"></rich-text></view>
        <view class="choice-grid" aria-label="选择一个现在可以选择的方向"><view wx:for="{{choiceOptions}}" wx:key="*this" class="choice-option {{answers.need === item ? 'selected' : ''}}" role="button" aria-pressed="{{answers.need === item}}" aria-disabled="{{saving || advancing}}" tabindex="0" data-field="need" data-value="{{item}}" bindtap="selectOption">{{item}}</view></view>
        <view class="answer-label" style="font-size: {{currentRealityStage.inputLabel.fontSize * 2}}rpx; color: {{currentRealityStage.inputLabel.color}};"><rich-text nodes="{{currentRealityStage.inputLabel.richText}}"></rich-text></view>
        <textarea class="reality-answer" disabled="{{saving || advancing}}" maxlength="1000" data-field="need" value="{{answers.need}}" bindinput="handleInput" placeholder="{{currentRealityStagePlaceholder}}" placeholder-style="color: {{currentRealityStage.placeholder.color}}; font-size: {{currentRealityStage.placeholder.fontSize * 2}}rpx;" aria-label="用自己的话写下一个现在可以选择的方向" />
      </view>
      <view wx:else class="step reality-step reality-stage-body align-{{currentRealityStage.align}} spacing-{{currentRealityStage.spacing}}">
        <view class="title" style="font-size: {{currentRealityStage.title.fontSize * 2}}rpx; color: {{currentRealityStage.title.color}};"><rich-text nodes="{{currentRealityStage.title.richText}}"></rich-text></view>
        <view class="muted" style="font-size: {{currentRealityStage.description.fontSize * 2}}rpx; color: {{currentRealityStage.description.color}};"><rich-text nodes="{{currentRealityStage.description.richText}}"></rich-text></view>
        <view class="answer-label" style="font-size: {{currentRealityStage.inputLabel.fontSize * 2}}rpx; color: {{currentRealityStage.inputLabel.color}};"><rich-text nodes="{{currentRealityStage.inputLabel.richText}}"></rich-text></view>
        <textarea class="reality-answer" disabled="{{saving || advancing}}" maxlength="1000" data-field="nextAction" value="{{answers.nextAction}}" bindinput="handleInput" placeholder="{{currentRealityStagePlaceholder}}" placeholder-style="color: {{currentRealityStage.placeholder.color}}; font-size: {{currentRealityStage.placeholder.fontSize * 2}}rpx;" aria-label="写下接下来七天愿意做的一件小事" />
      </view>
    </block>
    <block wx:else>
      <view wx:if="{{step === 0}}" class="step card-step season-step align-{{seasonCard.align}} spacing-{{seasonCard.spacing}}">
        <view class="card-meta" style="font-size: {{seasonCard.stageLabel.fontSize * 2}}rpx; color: {{seasonCard.stageLabel.color}};"><rich-text nodes="{{seasonCard.stageLabel.richText}}"></rich-text></view>
        <view wx:if="{{lifeCardLoading}}" class="muted">正在读取这一天的文案…</view>
        <view wx:elif="{{lifeCardError}}" class="error-text" role="alert">{{lifeCardError}}</view>
        <view wx:elif="{{!lifeCard}}" class="card-empty">
          <view class="muted" style="font-size: {{seasonCard.emptyLabel.fontSize * 2}}rpx; color: {{seasonCard.emptyLabel.color}};"><rich-text nodes="{{seasonCard.emptyLabel.richText}}"></rich-text></view>
          <view class="card-edit card-edit-standalone" role="button" aria-label="{{seasonCard.chooseBirthday.richText}}" tabindex="0" bindtap="changeBirthday" style="font-size: {{seasonCard.chooseBirthday.fontSize * 2}}rpx; color: {{seasonCard.chooseBirthday.color}};"><rich-text nodes="{{seasonCard.chooseBirthday.richText}}"></rich-text></view>
        </view>
        <block wx:elif="{{lifeCard}}">
          <view class="card-row">
            <view class="card-face"><text class="card-rank">{{lifeCard.rank}}</text><text class="card-suit">{{lifeCard.suitSymbol}}</text></view>
            <view class="card-when">
              <view class="card-date" style="font-size: {{seasonCard.birthdayLabel.fontSize * 2}}rpx; color: {{seasonCard.birthdayLabel.color}};"><rich-text nodes="{{seasonCard.birthdayLabel.richText}}"></rich-text><text> · </text><text>{{lifeCard.month}} 月 {{lifeCard.day}} 日</text></view>
              <view class="card-edit" role="button" aria-label="{{seasonCard.changeBirthday.richText}}" tabindex="0" bindtap="changeBirthday" style="font-size: {{seasonCard.changeBirthday.fontSize * 2}}rpx; color: {{seasonCard.changeBirthday.color}};"><rich-text nodes="{{seasonCard.changeBirthday.richText}}"></rich-text></view>
            </view>
          </view>
          <view class="card-rule" aria-hidden="true"></view>
          <view class="card-eyebrow" style="font-size: {{seasonCard.eyebrow.fontSize * 2}}rpx; color: {{seasonCard.eyebrow.color}};"><rich-text nodes="{{seasonCard.eyebrow.richText}}"></rich-text></view>
          <view class="card-title">{{lifeCard.title}}</view>
          <view class="card-summary">{{lifeCard.summary}}</view>
          <view class="card-label" style="font-size: {{seasonCard.themePrefix.fontSize * 2}}rpx; color: {{seasonCard.themePrefix.color}};"><rich-text nodes="{{seasonCard.themePrefix.richText}}"></rich-text><text>{{lifeCard.theme}}</text></view>
          <view class="card-prompt">{{lifeCard.prompt}}</view>
          <view class="card-footnote" style="font-size: {{seasonCard.footnote.fontSize * 2}}rpx; color: {{seasonCard.footnote.color}};"><rich-text nodes="{{seasonCard.footnote.richText}}"></rich-text></view>
          <view class="card-rule card-rule-bottom" aria-hidden="true"></view>
          <view class="card-note-label" style="font-size: {{seasonCard.noteLabel.fontSize * 2}}rpx; color: {{seasonCard.noteLabel.color}};"><rich-text nodes="{{seasonCard.noteLabel.richText}}"></rich-text></view>
          <view class="card-note">{{lifeCard.note}}</view>
          <view class="card-source-toggle" role="button" aria-expanded="{{cardSourceOpen}}" tabindex="0" bindtap="toggleCardSource" style="font-size: {{seasonCard.sourceToggle.fontSize * 2}}rpx; color: {{seasonCard.sourceToggle.color}};">
            <text class="guide-caret" aria-hidden="true">{{cardSourceOpen ? '▾' : '▸'}}</text>
            <rich-text nodes="{{seasonCard.sourceToggle.richText}}"></rich-text>
          </view>
          <view wx:if="{{cardSourceOpen}}" class="card-source">
            <view wx:for="{{lifeCard.sourceParagraphs}}" wx:key="*this">{{item}}</view>
          </view>
        </block>
      </view>
      <view wx:elif="{{step === 1 && seasonStage === 0}}" class="step season-step align-{{seasonNow.align}} spacing-{{seasonNow.spacing}}">
        <view class="step-index" style="font-size: {{seasonNowRecent.stepLabel.fontSize * 2}}rpx; color: {{seasonNowRecent.stepLabel.color}};"><rich-text nodes="{{seasonNowRecent.stepLabel.richText}}"></rich-text></view>
        <view class="season-headline">
          <view class="season-headline-line" style="font-size: {{seasonNowRecent.titleLine1.fontSize * 2}}rpx; color: {{seasonNowRecent.titleLine1.color}};"><rich-text nodes="{{seasonNowRecent.titleLine1.richText}}"></rich-text></view>
          <view class="season-headline-line" style="font-size: {{seasonNowRecent.titleLine2.fontSize * 2}}rpx; color: {{seasonNowRecent.titleLine2.color}};"><rich-text nodes="{{seasonNowRecent.titleLine2.richText}}"></rich-text></view>
        </view>
        <view class="season-lead" style="font-size: {{seasonNowRecent.description.fontSize * 2}}rpx; color: {{seasonNowRecent.description.color}};"><rich-text nodes="{{seasonNowRecent.description.richText}}"></rich-text></view>

        <view class="season-field">
          <view class="season-label" style="font-size: {{seasonNowRecent.experienceLabel.fontSize * 2}}rpx; color: {{seasonNowRecent.experienceLabel.color}};"><rich-text nodes="{{seasonNowRecent.experienceLabel.richText}}"></rich-text></view>
          <textarea class="season-input-box" auto-height disabled="{{saving || advancing}}" maxlength="1000" data-field="experience" value="{{answers.experience}}" bindinput="handleInput" placeholder="{{seasonExperiencePlaceholder}}" placeholder-style="color: {{seasonNowRecent.experiencePlaceholder.color}}; font-size: {{seasonNowRecent.experiencePlaceholder.fontSize * 2}}rpx;" />
        </view>

        <view class="season-field">
          <view class="season-label" style="font-size: {{seasonNowRecent.relationLabel.fontSize * 2}}rpx; color: {{seasonNowRecent.relationLabel.color}};"><rich-text nodes="{{seasonNowRecent.relationLabel.richText}}"></rich-text></view>
          <view class="season-choices" aria-label="选择与底色的关系">
            <view wx:for="{{seasonLinkOptions}}" wx:key="key" class="season-choice {{answers.season === item.key ? 'selected' : ''}}" role="button" aria-label="{{item.labelText}}" aria-pressed="{{answers.season === item.key}}" aria-disabled="{{saving || advancing}}" tabindex="0" data-value="{{item.key}}" bindtap="selectSeasonLink" style="font-size: {{item.label.fontSize * 2}}rpx; color: {{item.label.color}};"><rich-text nodes="{{item.label.richText}}"></rich-text></view>
          </view>
        </view>

        <view class="season-field">
          <view class="season-label" style="font-size: {{seasonNowRecent.noteLabel.fontSize * 2}}rpx; color: {{seasonNowRecent.noteLabel.color}};"><rich-text nodes="{{seasonNowRecent.noteLabel.richText}}"></rich-text><view class="season-optional" style="font-size: {{seasonNowRecent.optionalLabel.fontSize * 2}}rpx; color: {{seasonNowRecent.optionalLabel.color}};"><rich-text nodes="{{seasonNowRecent.optionalLabel.richText}}"></rich-text></view></view>
          <textarea class="season-input-box" auto-height disabled="{{saving || advancing}}" maxlength="1000" data-field="seasonNote" value="{{answers.seasonNote}}" bindinput="handleInput" placeholder="{{seasonNotePlaceholder}}" placeholder-style="color: {{seasonNowRecent.notePlaceholder.color}}; font-size: {{seasonNowRecent.notePlaceholder.fontSize * 2}}rpx;" />
        </view>
      </view>
      <view wx:elif="{{step === 1 && seasonStage === 1}}" class="step season-step align-{{seasonNow.align}} spacing-{{seasonNow.spacing}}">
        <view class="step-index" style="font-size: {{seasonNowChange.stepLabel.fontSize * 2}}rpx; color: {{seasonNowChange.stepLabel.color}};"><rich-text nodes="{{seasonNowChange.stepLabel.richText}}"></rich-text></view>
        <view class="season-headline">
          <view class="season-headline-line" style="font-size: {{seasonNowChange.titleLine1.fontSize * 2}}rpx; color: {{seasonNowChange.titleLine1.color}};"><rich-text nodes="{{seasonNowChange.titleLine1.richText}}"></rich-text></view>
          <view class="season-headline-line" style="font-size: {{seasonNowChange.titleLine2.fontSize * 2}}rpx; color: {{seasonNowChange.titleLine2.color}};"><rich-text nodes="{{seasonNowChange.titleLine2.richText}}"></rich-text></view>
        </view>
        <view class="season-lead" style="font-size: {{seasonNowChange.description.fontSize * 2}}rpx; color: {{seasonNowChange.description.color}};"><rich-text nodes="{{seasonNowChange.description.richText}}"></rich-text></view>

        <view class="season-state-list">
          <view wx:for="{{seasonStateView}}" wx:key="key" class="season-state {{item.selected ? 'open' : ''}} {{item.isNote ? 'season-state--note' : ''}}">
            <view class="season-state-head" role="checkbox" aria-label="{{item.labelText}} {{item.hintText}}" aria-checked="{{item.selected}}" aria-disabled="{{saving || advancing}}" tabindex="0" data-key="{{item.key}}" bindtap="toggleSeasonState">
              <text class="season-state-key">{{item.key}}</text>
              <view class="season-state-main">
                <view class="season-state-label" style="font-size: {{item.label.fontSize * 2}}rpx; color: {{item.label.color}};"><rich-text nodes="{{item.label.richText}}"></rich-text></view>
                <view wx:if="{{item.hintText}}" class="season-state-hint" style="font-size: {{item.hint.fontSize * 2}}rpx; color: {{item.hint.color}};"><rich-text nodes="{{item.hint.richText}}"></rich-text></view>
              </view>
              <text class="season-state-mark" aria-hidden="true">{{item.selected ? '✓' : '+'}}</text>
            </view>
          </view>
        </view>

        <view class="season-field">
          <view class="season-label season-label--soft" style="font-size: {{seasonNowChange.insightLabel.fontSize * 2}}rpx; color: {{seasonNowChange.insightLabel.color}};"><rich-text nodes="{{seasonNowChange.insightLabel.richText}}"></rich-text><view class="season-optional" style="font-size: {{seasonNowChange.optionalLabel.fontSize * 2}}rpx; color: {{seasonNowChange.optionalLabel.color}};"><rich-text nodes="{{seasonNowChange.optionalLabel.richText}}"></rich-text></view></view>
          <textarea class="season-input-box" auto-height disabled="{{saving || advancing}}" maxlength="1000" data-field="seasonInsight" value="{{answers.seasonInsight}}" bindinput="handleInput" placeholder="{{seasonInsightPlaceholder}}" placeholder-style="color: {{seasonNowChange.insightPlaceholder.color}}; font-size: {{seasonNowChange.insightPlaceholder.fontSize * 2}}rpx;" />
        </view>

        <view class="season-footnote" style="font-size: {{seasonNowChange.footer.fontSize * 2}}rpx; color: {{seasonNowChange.footer.color}};"><rich-text nodes="{{seasonNowChange.footer.richText}}"></rich-text></view>
      </view>
      <view wx:elif="{{step === 1}}" class="step season-step">
        <view class="season-field"><view class="season-label">（正在载入）</view></view>
      </view>
      <view wx:elif="{{step === 2}}" class="step season-step align-{{seasonChoice.align}} spacing-{{seasonChoice.spacing}}">
        <view class="step-index" style="font-size: {{seasonChoice.stepLabel.fontSize * 2}}rpx; color: {{seasonChoice.stepLabel.color}};"><rich-text nodes="{{seasonChoice.stepLabel.richText}}"></rich-text></view>
        <view class="season-headline">
          <view class="season-headline-line" style="font-size: {{seasonChoice.titleLine1.fontSize * 2}}rpx; color: {{seasonChoice.titleLine1.color}};"><rich-text nodes="{{seasonChoice.titleLine1.richText}}"></rich-text></view>
          <view class="season-headline-line" style="font-size: {{seasonChoice.titleLine2.fontSize * 2}}rpx; color: {{seasonChoice.titleLine2.color}};"><rich-text nodes="{{seasonChoice.titleLine2.richText}}"></rich-text></view>
        </view>
        <view class="season-lead">
          <view class="season-lead-line" style="font-size: {{seasonChoice.leadLine1.fontSize * 2}}rpx; color: {{seasonChoice.leadLine1.color}};"><rich-text nodes="{{seasonChoice.leadLine1.richText}}"></rich-text></view>
          <view class="season-lead-line" style="font-size: {{seasonChoice.leadLine2.fontSize * 2}}rpx; color: {{seasonChoice.leadLine2.color}};"><rich-text nodes="{{seasonChoice.leadLine2.richText}}"></rich-text></view>
        </view>

        <view class="season-field">
          <view class="season-label season-label--line" style="font-size: {{seasonChoice.keepLabel.fontSize * 2}}rpx; color: {{seasonChoice.keepLabel.color}};"><rich-text nodes="{{seasonChoice.keepLabel.richText}}"></rich-text></view>
          <textarea class="season-input-box" auto-height disabled="{{saving || advancing}}" maxlength="1000" data-field="keepUnderstanding" value="{{answers.keepUnderstanding}}" bindinput="handleInput" placeholder="{{seasonKeepPlaceholder}}" placeholder-style="color: {{seasonChoice.keepPlaceholder.color}}; font-size: {{seasonChoice.keepPlaceholder.fontSize * 2}}rpx;" />
        </view>

        <view class="season-field">
          <view class="season-label season-label--line" style="font-size: {{seasonChoice.rejectLabel.fontSize * 2}}rpx; color: {{seasonChoice.rejectLabel.color}};"><rich-text nodes="{{seasonChoice.rejectLabel.richText}}"></rich-text><view class="season-optional" style="font-size: {{seasonChoice.optionalLabel.fontSize * 2}}rpx; color: {{seasonChoice.optionalLabel.color}};"><rich-text nodes="{{seasonChoice.optionalLabel.richText}}"></rich-text></view></view>
          <textarea class="season-input-box" auto-height disabled="{{saving || advancing}}" maxlength="1000" data-field="rejectUnderstanding" value="{{answers.rejectUnderstanding}}" bindinput="handleInput" placeholder="{{seasonRejectPlaceholder}}" placeholder-style="color: {{seasonChoice.rejectPlaceholder.color}}; font-size: {{seasonChoice.rejectPlaceholder.fontSize * 2}}rpx;" />
        </view>
      </view>
      <view wx:else class="step season-step align-{{seasonAction.align}} spacing-{{seasonAction.spacing}}">
        <view class="step-index" style="font-size: {{seasonAction.stepLabel.fontSize * 2}}rpx; color: {{seasonAction.stepLabel.color}};"><rich-text nodes="{{seasonAction.stepLabel.richText}}"></rich-text></view>
        <view class="season-headline">
          <view class="season-headline-line" style="font-size: {{seasonAction.titleLine1.fontSize * 2}}rpx; color: {{seasonAction.titleLine1.color}};"><rich-text nodes="{{seasonAction.titleLine1.richText}}"></rich-text></view>
          <view class="season-headline-line" style="font-size: {{seasonAction.titleLine2.fontSize * 2}}rpx; color: {{seasonAction.titleLine2.color}};"><rich-text nodes="{{seasonAction.titleLine2.richText}}"></rich-text></view>
        </view>
        <view class="season-lead">
          <view class="season-lead-line" style="font-size: {{seasonAction.leadLine1.fontSize * 2}}rpx; color: {{seasonAction.leadLine1.color}};"><rich-text nodes="{{seasonAction.leadLine1.richText}}"></rich-text></view>
          <view class="season-lead-line" style="font-size: {{seasonAction.leadLine2.fontSize * 2}}rpx; color: {{seasonAction.leadLine2.color}};"><rich-text nodes="{{seasonAction.leadLine2.richText}}"></rich-text></view>
        </view>

        <view class="season-field">
          <view class="season-label season-label--tint" style="font-size: {{seasonAction.actionLabel.fontSize * 2}}rpx; color: {{seasonAction.actionLabel.color}};"><rich-text nodes="{{seasonAction.actionLabel.richText}}"></rich-text></view>
          <textarea class="season-input-box" auto-height disabled="{{saving || advancing || restFirst}}" maxlength="1000" data-field="sevenDayAction" value="{{answers.sevenDayAction}}" bindinput="handleInput" placeholder="{{seasonActionPlaceholder}}" placeholder-style="color: {{seasonAction.actionPlaceholder.color}}; font-size: {{seasonAction.actionPlaceholder.fontSize * 2}}rpx;" />
        </view>

        <view class="rest-toggle {{restFirst ? 'active' : ''}}" role="checkbox" aria-checked="{{restFirst}}" aria-disabled="{{saving || advancing}}" tabindex="0" bindtap="toggleRestFirst">
          <view class="rest-toggle-copy" style="font-size: {{seasonAction.restLabel.fontSize * 2}}rpx; color: {{seasonAction.restLabel.color}};"><rich-text nodes="{{seasonAction.restLabel.richText}}"></rich-text></view>
          <text class="rest-toggle-mark" aria-hidden="true">{{restFirst ? '✓' : ''}}</text>
        </view>

        <view wx:if="{{!answers.sevenDayAction}}" class="season-preview">
          <view class="season-preview-label" style="font-size: {{seasonAction.previewLabel.fontSize * 2}}rpx; color: {{seasonAction.previewLabel.color}};"><rich-text nodes="{{seasonAction.previewLabel.richText}}"></rich-text></view>
          <view class="season-preview-value muted" style="font-size: {{seasonAction.previewEmpty.fontSize * 2}}rpx; color: {{seasonAction.previewEmpty.color}};"><rich-text nodes="{{seasonAction.previewEmpty.richText}}"></rich-text></view>
        </view>

        <view class="season-footnote" style="font-size: {{seasonAction.footer.fontSize * 2}}rpx; color: {{seasonAction.footer.color}};"><rich-text nodes="{{seasonAction.footer.richText}}"></rich-text></view>
      </view>
    </block>
    <view wx:if="{{syncState === 'pending'}}" class="sync-status pending" role="status" aria-live="polite">有未同步的改动</view><view wx:elif="{{syncState === 'saving'}}" class="sync-status" role="status" aria-live="polite">正在保存到云端…</view><view wx:elif="{{syncState === 'conflict'}}" class="sync-status error" role="alert">云端草稿已在其他位置更新</view><view wx:elif="{{syncState === 'error'}}" class="sync-status error" role="alert">{{error || '云端保存失败，请重试'}}</view>
    <view wx:if="{{validationError}}" class="validation-error" role="alert">{{validationError}}</view>
    <view class="actions season-actions align-{{currentSeasonAlign}}">
      <view wx:if="{{step > 0}}" class="button secondary" role="button" aria-label="{{selected === 'season' ? currentSeasonPreviousLabel : currentRealityStagePreviousLabel}}" aria-disabled="{{saving || advancing}}" tabindex="0" bindtap="previous" style="{{selected === 'reality' ? 'color: ' + currentRealityStage.previousLabel.color + '; border-color: ' + currentRealityStage.previousLabel.color + ';' : 'color: ' + currentSeasonPreviousCopy.color + '; border-color: ' + currentSeasonPreviousCopy.color + ';'}}">
        <rich-text wx:if="{{selected === 'reality'}}" nodes="{{currentRealityStage.previousLabel.richText}}" style="font-size: {{currentRealityStage.previousLabel.fontSize * 2}}rpx;"></rich-text>
        <rich-text wx:else nodes="{{currentSeasonPreviousCopy.richText}}" style="font-size: {{currentSeasonPreviousCopy.fontSize * 2}}rpx;"></rich-text>
      </view>
      <view wx:if="{{selected === 'reality'}}" class="button" role="button" aria-label="{{saving || advancing ? '同步中' : currentRealityStageNextLabel}}" aria-disabled="{{saving || advancing || issueLoading || conflict}}" tabindex="0" bindtap="next" style="background: {{currentRealityStage.nextLabel.color}}; color: {{currentRealityStageNextTextColor}};">
        <rich-text wx:if="{{!saving && !advancing}}" nodes="{{currentRealityStage.nextLabel.richText}}" style="font-size: {{currentRealityStage.nextLabel.fontSize * 2}}rpx;"></rich-text>
        <text wx:else>同步中…</text>
      </view>
      <view wx:else class="button" role="button" aria-label="{{saving || advancing ? '同步中' : currentSeasonNextLabel}}" aria-disabled="{{saving || advancing || issueLoading || conflict}}" tabindex="0" bindtap="next" style="background: {{currentSeasonNextCopy.color}}; color: {{currentSeasonNextTextColor}};">
        <rich-text wx:if="{{!saving && !advancing}}" nodes="{{currentSeasonNextCopy.richText}}" style="font-size: {{currentSeasonNextCopy.fontSize * 2}}rpx;"></rich-text>
        <text wx:else>同步中…</text>
      </view>
    </view>
    <view wx:if="{{syncState === 'error'}}" class="actions retry-actions"><view class="button secondary" role="button" aria-label="重试保存" aria-disabled="{{saving || advancing}}" tabindex="0" bindtap="retrySave">重试保存</view></view><view wx:if="{{syncState === 'conflict'}}" class="actions conflict-actions"><view class="button secondary" role="button" aria-label="载入云端" aria-disabled="{{saving}}" tabindex="0" bindtap="loadCloudVersion">载入云端</view><view class="button destructive" role="button" aria-label="确认用本机覆盖" aria-disabled="{{saving}}" tabindex="0" bindtap="keepLocalVersion">{{saving ? '核对中…' : '确认用本机覆盖'}}</view></view><view wx:if="{{error}}" class="error-text" role="alert">{{error}}</view>
    <view wx:if="{{selected === 'reality'}}" class="draft-note reality-stage-footer align-{{currentRealityStage.align}}" style="font-size: {{currentRealityStage.footer.fontSize * 2}}rpx; color: {{currentRealityStage.footer.color}};"><rich-text nodes="{{currentRealityStage.footer.richText}}"></rich-text></view>
    <view wx:elif="{{selected === 'season' && currentSeasonFooter}}" class="draft-note season-draft-note align-{{currentSeasonAlign}}" style="font-size: {{currentSeasonFooter.fontSize * 2}}rpx; color: {{currentSeasonFooter.color}};"><rich-text nodes="{{currentSeasonFooter.richText}}"></rich-text></view>
  </view>
  <view wx:else class="complete"><view class="eyebrow">观察已保存</view><view class="title">给自己留了一处可以回来的地方。</view><view class="muted">这次观察已经保存到你的云端记录，仅自己可见。</view><view class="button" role="button" aria-label="查看本次记录" tabindex="0" bindtap="viewSavedRecord">查看本次记录</view><view class="button secondary" role="button" aria-label="再观察一次" tabindex="0" bindtap="restart">再观察一次</view></view>
  </view>
  <view wx:if="{{seasonGuideOpen}}" class="guide-backdrop" role="button" aria-label="关闭四时气韵说明" bindtap="closeSeasonGuide" catchtouchmove="noop">
    <view class="guide-sheet" role="dialog" aria-modal="true" aria-label="四时气韵说明" catchtap="noop">
      <image class="guide-mark" src="/assets/brand/flower-mark.svg" mode="aspectFit" aria-hidden="true" />
      <view class="guide-eyebrow">MYRIAD SHE · 一种观察方法</view>
      <view class="guide-title">四时气韵是什么？</view>
      <view class="guide-copy">它从生日对应的生命牌提供一个观察线索，再回到真实经历。借生、长、收、藏的变化，辨认一件事中什么正在开始、值得培育、需要收束或应当休息。</view>
      <view class="guide-copy">它不是测试，也不定义你。你可以采纳、保留，或完全不同意。</view>
      <view class="guide-actions">
        <view class="button" role="button" aria-label="进一步了解四时气韵" tabindex="0" bindtap="openSeasonIntro">进一步了解</view>
        <view class="button secondary" role="button" aria-label="先从现实处境开始" tabindex="0" bindtap="startRealityFromGuide">先从现实处境开始</view>
      </view>
    </view>
  </view>
  <app-tab-bar />
</view>

page {
  background: #e9e1d4;
  color: #3d332c;
}

.profile-page {
  min-height: 100vh;
  padding: 0 24rpx calc(60rpx + env(safe-area-inset-bottom));
  background: #e9e1d4;
  box-sizing: border-box;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
}

/* 顶栏 */
.profile-topbar {
  margin: 0 -24rpx;
  padding: 0 24rpx;
  border-bottom: 1rpx solid rgba(92, 73, 60, .14);
  background: #e9e1d4;
  box-sizing: content-box;
}
.profile-topbar-row {
  display: flex;
  height: 92rpx;
  align-items: center;
  justify-content: space-between;
}
.profile-icon-button {
  width: 68rpx;
  height: 68rpx;
  margin: 0;
  padding: 0;
  border: 0;
  background: transparent;
  color: #663124;
  font-family: Georgia, serif;
  font-size: 54rpx;
  line-height: 62rpx;
  text-align: left;
}
.profile-icon-button::after { border: 0; }
.profile-topbar-title {
  color: #3d332c;
  font-family: "MYRIAD Song", Georgia, "Songti SC", serif;
  font-size: 31rpx;
  font-weight: 600;
}
.profile-topbar-spacer { width: 68rpx; }

/* 账户卡：整页只保留这一块深色底 */
.profile-content { padding-top: 24rpx; }
.profile-hero {
  padding: 30rpx 28rpx 32rpx;
  overflow: hidden;
  border-radius: 26rpx;
  background: #663124;
  box-shadow: 0 18rpx 42rpx rgba(68, 38, 27, .16);
  color: #fbf4ea;
  box-sizing: border-box;
}
.hero-eyebrow {
  color: rgba(251, 244, 234, .58);
  font-family: Georgia, serif;
  font-size: 18rpx;
  letter-spacing: 3rpx;
  line-height: 1.5;
}
.hero-main {
  display: flex;
  align-items: center;
  gap: 22rpx;
  margin-top: 20rpx;
}
.profile-avatar-button {
  display: flex;
  width: 112rpx;
  height: 112rpx;
  flex: 0 0 112rpx;
  align-items: center;
  justify-content: center;
  margin: 0;
  padding: 0;
  overflow: hidden;
  border: 2rpx solid rgba(255, 255, 255, .26);
  border-radius: 50%;
  background: rgba(255, 255, 255, .10);
  color: #fbf4ea;
  line-height: 1;
  box-sizing: border-box;
}
.profile-avatar-button::after { border: 0; }
.profile-avatar-button[disabled] { opacity: .55; }
.profile-avatar { width: 100%; height: 100%; object-fit: cover; }
.profile-avatar-placeholder {
  color: #fbf4ea;
  font-family: Georgia, serif;
  font-size: 38rpx;
  line-height: 1;
}
.hero-copy { min-width: 0; }
.hero-name {
  overflow-wrap: anywhere;
  color: #fbf4ea;
  font-family: "MYRIAD Song", Georgia, "Songti SC", serif;
  font-size: 38rpx;
  font-weight: 600;
  line-height: 1.4;
}
.hero-meta {
  margin-top: 6rpx;
  color: rgba(251, 244, 234, .66);
  font-size: 21rpx;
  line-height: 1.6;
}

/* 分组卡 */
.profile-group { margin-top: 30rpx; }
.group-title {
  margin: 0 8rpx 10rpx;
  color: #8f7b6b;
  font-size: 19rpx;
  letter-spacing: 2rpx;
  line-height: 1.5;
}
.group-card {
  overflow: hidden;
  border: 1rpx solid rgba(92, 73, 60, .12);
  border-radius: 22rpx;
  background: #fbf7ef;
  box-sizing: border-box;
}
.profile-row {
  display: flex;
  min-height: 102rpx;
  align-items: center;
  padding: 0 24rpx;
  border-bottom: 1rpx solid rgba(92, 73, 60, .10);
  box-sizing: border-box;
}
.profile-row:last-child { border-bottom: 0; }
.profile-row-label {
  flex: 1;
  min-width: 0;
  color: #3d332c;
  font-size: 27rpx;
  line-height: 1.5;
}
.profile-row-value {
  flex: 0 0 auto;
  max-width: 50%;
  color: #7c6e62;
  font-size: 25rpx;
  line-height: 1.5;
  text-align: right;
  overflow-wrap: anywhere;
}
.profile-muted { color: #9c8b7d; }
.profile-link { color: #663124; }
.profile-row-arrow {
  flex: 0 0 auto;
  margin-left: 10rpx;
  color: #a08c7b;
  font-family: Georgia, serif;
  font-size: 34rpx;
  line-height: 1;
}
.profile-action-row:active { opacity: .62; }

/* 昵称编辑：直接替换“用户名”这一行，避免多出一条分隔线 */
.profile-nickname-editor {
  display: flex;
  min-height: 102rpx;
  align-items: center;
  padding: 0 24rpx;
  border-bottom: 1rpx solid rgba(92, 73, 60, .10);
  box-sizing: border-box;
}
.profile-nickname-editor input {
  width: 100%;
  min-height: 76rpx;
  padding: 0 18rpx;
  border: 1rpx solid #d8cabb;
  border-radius: 10rpx;
  background: #fffdf8;
  color: #3d332c;
  font-size: 27rpx;
  box-sizing: border-box;
}

/* 加载与错误 */
.profile-state {
  margin: 24rpx 4rpx 0;
  padding: 70rpx 36rpx;
  border: 1rpx solid rgba(92, 73, 60, .12);
  border-radius: 22rpx;
  background: #fbf7ef;
  color: #7c6e62;
  font-size: 25rpx;
  line-height: 1.8;
  text-align: center;
  box-sizing: border-box;
}
.profile-error { display: grid; gap: 24rpx; }
.profile-retry {
  width: max-content;
  min-height: 64rpx;
  margin: 0 auto;
  padding: 0 30rpx;
  border: 1rpx solid #cdbbae;
  border-radius: 999rpx;
  color: #663124;
  font-size: 24rpx;
  line-height: 64rpx;
}

/* 退出登录：纯文字操作，不使用原生 button */
.logout-action {
  display: flex;
  min-height: 88rpx;
  align-items: center;
  justify-content: center;
  margin: 42rpx 8rpx 0;
  color: #663124;
  font-size: 24rpx;
  letter-spacing: 1rpx;
  line-height: 1.5;
}
.logout-action:active { opacity: .55; }

.profile-footer-links {
  display: flex;
  justify-content: center;
  gap: 44rpx;
  margin-top: 18rpx;
  padding-bottom: 18rpx;
  color: #8f7b6b;
  font-size: 21rpx;
  line-height: 1.5;
}
.profile-footer-links text:active { opacity: .55; }

page { background: #e7dfd1; color: #40362f; }
.profile-page { min-height: 100vh; padding-bottom: 54rpx; box-sizing: border-box; background: #e7dfd1; font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif; }
.profile-topbar { background: #e7dfd1; border-bottom: 1rpx solid #cdbbae; }
.profile-topbar-row { display: flex; align-items: center; justify-content: space-between; height: 92rpx; padding: 0 24rpx; }
.profile-icon-button { width: 68rpx; height: 68rpx; margin: 0; padding: 0; border: 0; background: transparent; color: #663124; font-family: Georgia, serif; font-size: 56rpx; line-height: 62rpx; text-align: left; }
.profile-icon-button::after { border: 0; }
.profile-topbar-title { color: #40362f; font-family: Georgia, "Songti SC", serif; font-size: 31rpx; font-weight: 600; }
.profile-topbar-spacer { width: 68rpx; }
.profile-card { margin: 18rpx 24rpx 0; padding: 0 24rpx; border: 1rpx solid #cdbbae; border-radius: 10rpx; background: #f5f0e8; }
.profile-row { display: flex; align-items: center; min-height: 104rpx; border-bottom: 1rpx solid #d8cabb; }
.profile-row:last-child { border-bottom: 0; }
.profile-row-label { flex: 1; min-width: 0; color: #75675d; font-size: 29rpx; }
.profile-row-value { flex: 0 0 auto; max-width: 48%; color: #40362f; font-size: 29rpx; text-align: right; overflow-wrap: anywhere; }
.profile-muted { color: #8b6b58; }
.profile-link { color: #663124; }
.profile-row-arrow { flex: 0 0 auto; margin-left: 12rpx; color: #8b6b58; font-family: Georgia, serif; font-size: 38rpx; line-height: 1; }
.profile-avatar-row { min-height: 142rpx; }
.profile-avatar-button { display: flex; align-items: center; justify-content: center; width: 78rpx; height: 78rpx; margin: 0; padding: 0; overflow: hidden; border: 1rpx solid #cdbbae; border-radius: 50%; background: #efe8dc; }
.profile-avatar-button::after { border: 0; }
.profile-avatar, .profile-avatar-placeholder { display: flex; align-items: center; justify-content: center; width: 100%; height: 100%; }
.profile-avatar { object-fit: cover; }
.profile-avatar-placeholder { color: #8b6b58; font-size: 36rpx; }
.profile-action-row:active, .profile-footer-links text:active { opacity: .62; }
.profile-nickname-editor { padding: 0 0 20rpx; border-bottom: 1rpx solid #d8cabb; }
.profile-nickname-editor input { width: 100%; min-height: 72rpx; padding: 0 18rpx; box-sizing: border-box; border: 1rpx solid #cdbbae; border-radius: 6rpx; background: #fffaf4; color: #40362f; font-size: 29rpx; }
.profile-state { padding: 90rpx 48rpx; color: #75675d; font-size: 27rpx; text-align: center; }
.profile-error { display: grid; gap: 22rpx; }
.profile-retry { width: max-content; min-height: 64rpx; margin: 0 auto; padding: 0 28rpx; border: 1rpx solid #cdbbae; border-radius: 8rpx; background: transparent; color: #663124; font-size: 26rpx; }
.profile-retry::after { border: 0; }
.logout-button { height: 88rpx; margin: 110rpx 32rpx 0; border: 0; border-radius: 48rpx; background: #663124; color: #fffaf4; font-size: 30rpx; line-height: 88rpx; }
.logout-button::after { border: 0; }
.profile-footer-links { display: flex; justify-content: center; gap: 54rpx; margin-top: 22rpx; color: #663124; font-size: 23rpx; }

<view class="audio-page">
  <view class="audio-topbar" style="padding-top: {{statusBarHeight}}px">
    <view class="audio-topbar-row">
      <view class="audio-control" role="button" aria-label="返回" tabindex="0" bindtap="handleBack">‹</view>
      <text class="audio-nav-title">微声音</text>
    </view>
  </view>

  <view wx:if="{{loading}}" class="audio-state" role="status">正在读取本期微声音…</view>
  <view wx:elif="{{error}}" class="audio-state audio-error" role="alert">
    <text>{{error}}</text>
    <view class="audio-retry" role="button" aria-label="重新读取本期微声音" tabindex="0" bindtap="loadContent">重新读取</view>
  </view>
  <block wx:else>
    <view class="audio-meta"><text>02 · 微声音</text><text>{{issueCode}}</text></view>
    <view class="audio-hero">
      <view class="audio-eyebrow">LISTEN / 本期微声音</view>
      <rich-text class="audio-title" nodes="{{audio.titleHtml}}"></rich-text>
      <rich-text wx:if="{{audio.subtitleHtml}}" class="audio-subtitle" nodes="{{audio.subtitleHtml}}"></rich-text>
    </view>

    <view class="audio-tracks">
      <view
        wx:for="{{audio.tracks}}"
        wx:key="id"
        class="audio-track audio-track-link" style="animation-delay: {{index * 60}}ms;"
        role="button"
        tabindex="0"
        aria-label="进入{{item.title}}详情"
        data-track-id="{{item.id}}"
        bindtap="openDetail"
      >
        <view class="audio-track-index">{{index + 1 < 10 ? '0' + (index + 1) : index + 1}}</view>
        <view class="audio-track-copy">
          <rich-text class="audio-track-title" nodes="{{item.titleHtml}}"></rich-text>
          <rich-text wx:if="{{item.subtitleHtml}}" class="audio-track-subtitle" nodes="{{item.subtitleHtml}}"></rich-text>
          <view class="audio-track-meta">
            <text class="audio-track-kind">{{item.mediaType === 'video' ? '视频' : '声音'}}</text>
            <text wx:if="{{item.duration}}" class="audio-track-duration">{{item.duration}}</text>
          </view>
        </view>
        <text class="audio-track-arrow" aria-hidden="true">→</text>
      </view>
    </view>

    <view class="audio-return" role="button" aria-label="回到当期策展" tabindex="0" bindtap="handleBack"><text>回到当期策展</text><text>←</text></view>
  </block>
</view>

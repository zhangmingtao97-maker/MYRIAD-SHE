@import "../../app.wxss";

page { min-height: 100vh; background: #e7dfd1; color: #5c493c; }
.audio-page { min-height: 100vh; padding-bottom: calc(170rpx + env(safe-area-inset-bottom)); background: #e7dfd1; color: #5c493c; font-family: "Source Han Serif CN", "Source Han Serif SC", "Noto Serif CJK SC", "Songti SC", STSong, serif; }
.audio-topbar { position: sticky; z-index: 10; top: 0; border-bottom: 1rpx solid rgba(92, 73, 60, .22); background: #e7dfd1; box-sizing: border-box; }
.audio-topbar-row { position: relative; display: flex; height: 88rpx; align-items: center; justify-content: center; padding: 0 120rpx; box-sizing: border-box; }
.audio-nav-title { color: #5c493c; font-size: 30rpx; font-weight: 600; line-height: 1.4; }
.audio-control { position: absolute; top: 0; left: 22rpx; display: flex; width: 72rpx; height: 88rpx; align-items: center; justify-content: center; color: #5c493c; font-family: Georgia, serif; font-size: 56rpx; line-height: 1; }
.audio-page [role="button"]:active { opacity: .65; }
.audio-state { padding: 80rpx 40rpx; color: #8a6755; font-size: 26rpx; line-height: 1.8; }
.audio-error { color: #8c4035; }
.audio-retry { display: inline-block; margin-top: 30rpx; padding: 18rpx 0; color: #663124; border-bottom: 1rpx solid rgba(92, 73, 60, .28); }
.audio-meta { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; margin: 0 40rpx; padding-top: 48rpx; color: #8a6755; font-family: Garamond, Georgia, "Songti SC", serif; font-size: 23rpx; line-height: 1.5; letter-spacing: 1rpx; }
.audio-meta text:last-child { color: #663124; white-space: nowrap; }
.audio-hero { padding: 72rpx 40rpx 64rpx; }
.audio-eyebrow { color: #8b6b58; font-family: Garamond, Georgia, "Songti SC", serif; font-size: 21rpx; line-height: 1.5; letter-spacing: 2rpx; }
.audio-title { margin-top: 26rpx; color: #5c493c; font-size: 58rpx; font-weight: 600; line-height: 1.35; white-space: pre-wrap; }
.audio-subtitle { margin-top: 26rpx; color: #5c493c; font-size: 28rpx; font-weight: 400; line-height: 1.8; white-space: pre-wrap; }
.audio-tracks { margin: 0 40rpx; border-top: 1rpx solid rgba(92, 73, 60, .24); }
.audio-track { padding: 34rpx 0; border-bottom: 1rpx solid rgba(92, 73, 60, .24); }
.audio-track-row { display: flex; align-items: center; gap: 22rpx; }
.audio-play { display: flex; flex: 0 0 64rpx; width: 64rpx; height: 64rpx; align-items: center; justify-content: center; border: 1rpx solid rgba(92, 73, 60, .35); border-radius: 50%; color: #663124; font-family: Georgia, serif; font-size: 24rpx; }
.audio-track-copy { min-width: 0; flex: 1; }
.audio-track-title { color: #5c493c; font-size: 29rpx; font-weight: 600; line-height: 1.55; }
.audio-track-subtitle { margin-top: 6rpx; color: #8a6755; font-size: 23rpx; line-height: 1.6; }
.audio-track-duration { flex: 0 0 auto; color: #8a6755; font-family: Garamond, Georgia, "Songti SC", serif; font-size: 23rpx; }
.audio-progress { margin: 26rpx 0 0 86rpx; }
.audio-progress-track { overflow: hidden; height: 2rpx; background: rgba(92, 73, 60, .18); }
.audio-progress-fill { height: 2rpx; background: #663124; transition: width .2s linear; }
.audio-progress-times { display: flex; justify-content: space-between; margin-top: 10rpx; color: #8a6755; font-family: Garamond, Georgia, "Songti SC", serif; font-size: 20rpx; }
.audio-track-quote { margin: 28rpx 0 0 86rpx; color: #5c493c; font-size: 29rpx; font-weight: 600; line-height: 1.7; white-space: pre-wrap; }
.audio-track-transcript { margin: 24rpx 0 0 86rpx; color: #5c493c; font-size: 26rpx; line-height: 1.85; white-space: pre-wrap; }
.audio-return { display: flex; min-height: 96rpx; align-items: center; gap: 24rpx; margin: 64rpx 40rpx 0; color: #5c493c; font-size: 28rpx; font-weight: 600; }
.audio-return text:last-child { color: #663124; font-family: Garamond, Georgia, serif; font-size: 34rpx; }

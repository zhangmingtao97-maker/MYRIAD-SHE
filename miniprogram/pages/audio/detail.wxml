<view class="voice-page">
  <view class="voice-topbar" style="padding-top: {{statusBarHeight}}px">
    <view class="voice-topbar-row">
      <view class="voice-control" role="button" aria-label="返回" tabindex="0" bindtap="handleBack">‹</view>
      <text class="voice-nav-title">微声音</text>
    </view>
  </view>

  <view wx:if="{{loading}}" class="voice-state" role="status">正在读取这段微声音…</view>
  <view wx:elif="{{error}}" class="voice-state voice-error" role="alert">
    <text>{{error}}</text>
    <view class="voice-retry" role="button" aria-label="重新读取这段微声音" tabindex="0" bindtap="loadContent">重新读取</view>
  </view>
  <block wx:else>
    <view class="voice-meta"><text>02 · 微声音</text><text>{{issueCode}}</text></view>

    <view class="voice-media">
      <block wx:if="{{track.mediaType === 'video'}}">
        <video
          class="voice-video"
          src="{{track.videoUrl}}"
          controls
          show-center-play-btn
          enable-progress-gesture
          object-fit="contain"
          aria-label="{{track.title}}视频"
        ></video>
      </block>
      <block wx:else>
        <view class="voice-audio-card {{playing && !buffering ? 'is-playing' : ''}}">
          <view class="voice-audio-kicker">LISTEN / 声音</view>
          <view class="voice-audio-main">
            <view class="voice-play" role="button" tabindex="0" aria-label="{{buffering ? '取消等待' : playing ? '暂停' : '播放'}}{{track.title}}" bindtap="toggleAudio">
              <view wx:if="{{buffering}}" class="voice-buffer-spinner" aria-hidden="true"></view>
              <view wx:elif="{{playing}}" class="voice-play-bars" aria-hidden="true">
                <view class="voice-play-bar"></view>
                <view class="voice-play-bar"></view>
                <view class="voice-play-bar"></view>
                <view class="voice-play-bar"></view>
              </view>
              <text wx:else>▶</text>
            </view>
            <view class="voice-audio-copy">
              <rich-text class="voice-audio-title" nodes="{{track.titleHtml}}"></rich-text>
              <rich-text wx:if="{{track.subtitleHtml}}" class="voice-audio-subtitle" nodes="{{track.subtitleHtml}}"></rich-text>
            </view>
          </view>
          <view class="voice-playback-status" role="status" aria-live="polite">{{buffering ? '正在准备声音…' : playbackError || (playing ? '正在播放' : '轻触播放，慢慢听')}}<text wx:if="{{playbackError}}" class="voice-playback-retry" role="button" bindtap="toggleAudio">重试</text></view>
          <view class="voice-progress">
            <view class="voice-progress-track"><view class="voice-progress-fill" style="width: {{progress}}%"></view></view>
            <view class="voice-progress-times"><text>{{currentLabel}}</text><text>{{durationLabel}}</text></view>
          </view>
        </view>
      </block>
    </view>

    <view wx:if="{{track.actions.length}}" class="voice-actions" aria-label="微声音操作">
      <view class="voice-action-list">
        <block wx:for="{{track.actions}}" wx:key="id">
          <button
            wx:if="{{item.kind === 'share'}}"
            class="voice-action"
            hover-class="voice-action--active"
            open-type="share"
            aria-label="{{item.label}}"
          ><rich-text class="voice-action-label" nodes="{{item.labelHtml}}"></rich-text></button>
          <button
            wx:else
            class="voice-action"
            hover-class="voice-action--active"
            data-index="{{index}}"
            bindtap="handleVoiceAction"
            aria-label="{{item.label}}"
          ><rich-text class="voice-action-label" nodes="{{item.labelHtml}}"></rich-text></button>
        </block>
      </view>
    </view>

    <view class="voice-article">
      <view class="voice-article-kicker">{{track.mediaType === 'video' ? 'WATCH / 本期影像' : 'LISTEN / 本期声音'}}</view>
      <rich-text class="voice-heading" nodes="{{headingHtml}}"></rich-text>
      <rich-text wx:if="{{descriptionHtml}}" class="voice-description" nodes="{{descriptionHtml}}"></rich-text>
      <rich-text wx:if="{{track.quoteHtml}}" class="voice-quote" nodes="{{track.quoteHtml}}"></rich-text>
      <rich-text wx:if="{{track.transcriptHtml && track.transcriptHtml !== descriptionHtml}}" class="voice-transcript" nodes="{{track.transcriptHtml}}"></rich-text>
    </view>

    <view class="voice-return" role="button" aria-label="回到当期策展" tabindex="0" bindtap="handleBack"><text>回到当期策展</text><text>←</text></view>
  </block>
</view>

@import "../../app.wxss";

page { min-height: 100vh; background: #e7dfd1; color: #5c493c; }
.voice-page { min-height: 100vh; padding-bottom: calc(170rpx + env(safe-area-inset-bottom)); background: #e7dfd1; color: #5c493c; font-family: "MYRIAD Garamond", "MYRIAD Song", serif; }
.voice-topbar { position: sticky; z-index: 10; top: 0; border-bottom: 1rpx solid rgba(92, 73, 60, .22); background: #e7dfd1; box-sizing: border-box; }
.voice-topbar-row { position: relative; display: flex; height: 88rpx; align-items: center; justify-content: center; padding: 0 120rpx; box-sizing: border-box; }
.voice-nav-title { color: #5c493c; font-size: 30rpx; font-weight: 600; line-height: 1.4; }
.voice-control { position: absolute; top: 0; left: 22rpx; display: flex; width: 72rpx; height: 88rpx; align-items: center; justify-content: center; color: #5c493c; font-family: "MYRIAD Garamond", "MYRIAD Song", serif; font-size: 56rpx; line-height: 1; }
.voice-page [role="button"]:active { opacity: .65; }
.voice-state { padding: 80rpx 40rpx; color: #8a6755; font-size: 26rpx; line-height: 1.8; }
.voice-error { color: #8c4035; }
.voice-retry { display: inline-block; margin-top: 30rpx; padding: 18rpx 0; color: #663124; border-bottom: 1rpx solid rgba(92, 73, 60, .28); }
.voice-meta { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; margin: 0 40rpx; padding-top: 48rpx; color: #8a6755; font-family: "MYRIAD Garamond", "MYRIAD Song", serif; font-size: 23rpx; line-height: 1.5; letter-spacing: 1rpx; }
.voice-meta text:last-child { color: #663124; white-space: nowrap; }
.voice-media { padding: 54rpx 40rpx 0; }
.voice-video { display: block; width: 100%; height: 420rpx; background: #171310; }
.voice-audio-card { padding: 40rpx 32rpx 34rpx; border: 1rpx solid rgba(92, 73, 60, .28); background: rgba(255, 253, 249, .45); box-sizing: border-box; }
.voice-audio-card.is-playing { border-color: rgba(102, 49, 36, .5); }
.voice-audio-kicker { color: #8b6b58; font-family: "MYRIAD Garamond", "MYRIAD Song", serif; font-size: 20rpx; line-height: 1.5; letter-spacing: 2rpx; }
.voice-audio-main { display: flex; align-items: center; gap: 24rpx; margin-top: 32rpx; }
.voice-play { display: flex; flex: 0 0 88rpx; width: 88rpx; height: 88rpx; align-items: center; justify-content: center; border: 1rpx solid rgba(102, 49, 36, .45); border-radius: 50%; color: #663124; font-family: "MYRIAD Garamond", "MYRIAD Song", serif; font-size: 28rpx; }
.voice-audio-copy { min-width: 0; flex: 1; }
.voice-audio-title { color: #5c493c; font-size: 31rpx; font-weight: 600; line-height: 1.55; }
.voice-audio-subtitle { margin-top: 8rpx; color: #8a6755; font-size: 23rpx; line-height: 1.65; }
.voice-progress { margin-top: 34rpx; }
.voice-progress-track { overflow: hidden; height: 2rpx; background: rgba(92, 73, 60, .18); }
.voice-progress-fill { height: 2rpx; background: #663124; transition: width .2s linear; }
.voice-progress-times { display: flex; justify-content: space-between; margin-top: 12rpx; color: #8a6755; font-family: "MYRIAD Garamond", "MYRIAD Song", serif; font-size: 20rpx; }
.voice-article { padding: 86rpx 40rpx 0; }
.voice-article-kicker { color: #8b6b58; font-family: "MYRIAD Garamond", "MYRIAD Song", serif; font-size: 21rpx; line-height: 1.5; letter-spacing: 2rpx; }
.voice-heading { margin-top: 26rpx; color: #5c493c; font-size: 54rpx; font-weight: 600; line-height: 1.35; white-space: pre-wrap; }
.voice-description { margin-top: 38rpx; color: #5c493c; font-size: 29rpx; font-weight: 400; line-height: 1.9; white-space: pre-wrap; }
.voice-quote { margin-top: 54rpx; padding-top: 34rpx; border-top: 1rpx solid rgba(92, 73, 60, .24); color: #5c493c; font-size: 34rpx; font-weight: 600; line-height: 1.65; white-space: pre-wrap; }
.voice-transcript { margin-top: 42rpx; color: #5c493c; font-size: 26rpx; line-height: 1.9; white-space: pre-wrap; }
.voice-actions { margin: 48rpx 40rpx 0; padding: 0; }
.voice-action-list { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 0; }
button.voice-action { display: flex; flex: 0 0 calc((100% - 36rpx) / 4); width: calc((100% - 36rpx) / 4); min-width: 0; min-height: 72rpx; align-items: center; justify-content: center; margin: 0; padding: 10rpx 8rpx; border: 1rpx solid rgba(102, 49, 36, .46); border-radius: 999rpx; background: rgba(255, 253, 249, .4); color: #663124; font-family: "MYRIAD Garamond", "MYRIAD Song", serif; font-size: 20rpx; font-weight: 500; line-height: 1.25; letter-spacing: 0; text-align: center; white-space: nowrap; box-sizing: border-box; overflow: hidden; appearance: none; -webkit-appearance: none; }
button.voice-action::after { border: 0 !important; }
.voice-action-label { display: block; max-width: 100%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.voice-action--active { background: rgba(102, 49, 36, .1) !important; opacity: .72; }
.voice-return { display: flex; min-height: 96rpx; align-items: center; gap: 24rpx; margin: 64rpx 40rpx 0; color: #5c493c; font-size: 28rpx; font-weight: 600; }
.voice-return text:last-child { color: #663124; font-family: "MYRIAD Garamond", "MYRIAD Song", serif; font-size: 34rpx; }

/* ---------- 播放态轻量动效 ---------- */
.voice-audio-card {
  transition: border-color .2s ease, background-color .2s ease, box-shadow .2s ease;
}
.voice-audio-card.is-playing {
  background-color: rgba(255, 253, 249, .58);
  box-shadow: 0 10rpx 30rpx rgba(102, 49, 36, .08);
}
.voice-play {
  transition: background-color .2s ease, box-shadow .2s ease, transform .18s ease;
}
.voice-audio-card.is-playing .voice-play {
  background-color: rgba(102, 49, 36, .08);
  box-shadow: 0 0 0 1rpx rgba(102, 49, 36, .12);
}
.voice-play:active { transform: scale(.96); }
.voice-play-bars {
  display: flex;
  width: 28rpx;
  height: 28rpx;
  align-items: center;
  justify-content: space-between;
}
.voice-play-bar {
  width: 3rpx;
  height: 24rpx;
  border-radius: 999rpx;
  background: currentColor;
  transform: scaleY(.55);
  transform-origin: center;
  animation: voice-bar-pulse .9s ease-in-out infinite alternate;
}
.voice-play-bar:nth-child(2) { animation-delay: -.55s; }
.voice-play-bar:nth-child(3) { animation-delay: -.3s; }
.voice-play-bar:nth-child(4) { animation-delay: -.72s; }
@keyframes voice-bar-pulse {
  from { transform: scaleY(.42); opacity: .72; }
  to { transform: scaleY(1); opacity: 1; }
}
@media (prefers-reduced-motion: reduce) {
  .voice-audio-card, .voice-play, .voice-progress-fill { transition: none; }
  .voice-play-bar { animation: none; transform: scaleY(.72); }
  .voice-play:active { transform: none; }
}

.voice-playback-status { min-height: 44rpx; margin-top: 20rpx; color: #88786b; font-size: 23rpx; line-height: 1.6; }
.voice-playback-retry { display: inline-flex; align-items: center; min-height: 88rpx; padding: 0 20rpx; color: #663124; }
.voice-buffer-spinner { width: 26rpx; height: 26rpx; border: 3rpx solid rgba(102,49,36,.2); border-top-color: currentColor; border-radius: 50%; animation: voice-buffer-turn .9s linear infinite; }
@keyframes voice-buffer-turn { to { transform: rotate(360deg); } }
@media (prefers-reduced-motion: reduce) { .voice-buffer-spinner { animation: none; } }

@import "../../app.wxss";

page { min-height: 100vh; background: #e7dfd1; color: #5c493c; }
.voice-page { min-height: 100vh; padding-bottom: calc(170rpx + env(safe-area-inset-bottom)); background: #e7dfd1; color: #5c493c; font-family: "Source Han Serif CN", "Source Han Serif SC", "Noto Serif CJK SC", "Songti SC", STSong, serif; }
.voice-topbar { position: sticky; z-index: 10; top: 0; border-bottom: 1rpx solid rgba(92, 73, 60, .22); background: #e7dfd1; box-sizing: border-box; }
.voice-topbar-row { position: relative; display: flex; height: 88rpx; align-items: center; justify-content: center; padding: 0 120rpx; box-sizing: border-box; }
.voice-nav-title { color: #5c493c; font-size: 30rpx; font-weight: 600; line-height: 1.4; }
.voice-control { position: absolute; top: 0; left: 22rpx; display: flex; width: 72rpx; height: 88rpx; align-items: center; justify-content: center; color: #5c493c; font-family: Georgia, serif; font-size: 56rpx; line-height: 1; }
.voice-page [role="button"]:active { opacity: .65; }
.voice-state { padding: 80rpx 40rpx; color: #8a6755; font-size: 26rpx; line-height: 1.8; }
.voice-error { color: #8c4035; }
.voice-retry { display: inline-block; margin-top: 30rpx; padding: 18rpx 0; color: #663124; border-bottom: 1rpx solid rgba(92, 73, 60, .28); }
.voice-meta { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; margin: 0 40rpx; padding-top: 48rpx; color: #8a6755; font-family: Garamond, Georgia, "Songti SC", serif; font-size: 23rpx; line-height: 1.5; letter-spacing: 1rpx; }
.voice-meta text:last-child { color: #663124; white-space: nowrap; }
.voice-media { padding: 54rpx 40rpx 0; }
.voice-video { display: block; width: 100%; height: 420rpx; background: #171310; }
.voice-audio-card { padding: 40rpx 32rpx 34rpx; border: 1rpx solid rgba(92, 73, 60, .28); background: rgba(255, 253, 249, .45); box-sizing: border-box; }
.voice-audio-card.is-playing { border-color: rgba(102, 49, 36, .5); }
.voice-audio-kicker { color: #8b6b58; font-family: Garamond, Georgia, "Songti SC", serif; font-size: 20rpx; line-height: 1.5; letter-spacing: 2rpx; }
.voice-audio-main { display: flex; align-items: center; gap: 24rpx; margin-top: 32rpx; }
.voice-play { display: flex; flex: 0 0 82rpx; width: 82rpx; height: 82rpx; align-items: center; justify-content: center; border: 1rpx solid rgba(102, 49, 36, .45); border-radius: 50%; color: #663124; font-family: Georgia, serif; font-size: 28rpx; }
.voice-audio-copy { min-width: 0; flex: 1; }
.voice-audio-title { color: #5c493c; font-size: 31rpx; font-weight: 600; line-height: 1.55; }
.voice-audio-subtitle { margin-top: 8rpx; color: #8a6755; font-size: 23rpx; line-height: 1.65; }
.voice-progress { margin-top: 34rpx; }
.voice-progress-track { overflow: hidden; height: 2rpx; background: rgba(92, 73, 60, .18); }
.voice-progress-fill { height: 2rpx; background: #663124; transition: width .2s linear; }
.voice-progress-times { display: flex; justify-content: space-between; margin-top: 12rpx; color: #8a6755; font-family: Garamond, Georgia, "Songti SC", serif; font-size: 20rpx; }
.voice-article { padding: 86rpx 40rpx 0; }
.voice-article-kicker { color: #8b6b58; font-family: Garamond, Georgia, "Songti SC", serif; font-size: 21rpx; line-height: 1.5; letter-spacing: 2rpx; }
.voice-heading { margin-top: 26rpx; color: #5c493c; font-size: 54rpx; font-weight: 600; line-height: 1.35; white-space: pre-wrap; }
.voice-description { margin-top: 38rpx; color: #5c493c; font-size: 29rpx; font-weight: 400; line-height: 1.9; white-space: pre-wrap; }
.voice-quote { margin-top: 54rpx; padding-top: 34rpx; border-top: 1rpx solid rgba(92, 73, 60, .24); color: #5c493c; font-size: 34rpx; font-weight: 600; line-height: 1.65; white-space: pre-wrap; }
.voice-transcript { margin-top: 42rpx; color: #5c493c; font-size: 26rpx; line-height: 1.9; white-space: pre-wrap; }
.voice-return { display: flex; min-height: 96rpx; align-items: center; gap: 24rpx; margin: 64rpx 40rpx 0; color: #5c493c; font-size: 28rpx; font-weight: 600; }
.voice-return text:last-child { color: #663124; font-family: Garamond, Georgia, serif; font-size: 34rpx; }

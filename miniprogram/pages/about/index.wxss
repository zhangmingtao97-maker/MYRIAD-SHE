page { background: #e7dfd1; color: #5c493c; }
.about-page { min-height: 100vh; padding-bottom: 150rpx; box-sizing: border-box; background: #e7dfd1; font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif; }
.about-topbar { border-bottom: 1rpx solid rgba(92,73,60,.22); }.topbar-row { height: 90rpx; display: flex; align-items: center; justify-content: space-between; padding: 0 28rpx; }
.icon-button { width: 64rpx; height: 64rpx; margin: 0; padding: 0; border: 0; background: transparent; color: #5c493c; font-family: Georgia, serif; font-size: 56rpx; line-height: 58rpx; }.icon-button::after { border: 0; }.topbar-title { color: #5c493c; font-family: Georgia, "Songti SC", serif; font-size: 32rpx; font-weight: 600; }
.about-content { padding: 54rpx 48rpx 70rpx; }.about-meta { display: flex; justify-content: space-between; color: #8b6b58; font-family: Georgia, serif; font-size: 24rpx; letter-spacing: 2rpx; }.about-title { display: block; margin-top: 94rpx; color: #5c493c; font-family: Georgia, "Songti SC", serif; font-size: 52rpx; font-weight: 600; line-height: 1.4; }.about-section { margin-top: 64rpx; padding-top: 28rpx; border-top: 1rpx solid rgba(92,73,60,.24); }.about-label { display: block; color: #8b6b58; font-family: Georgia, "Songti SC", serif; font-size: 24rpx; }.about-copy { display: block; margin-top: 24rpx; color: #5c493c; font-family: Georgia, "Songti SC", serif; font-size: 28rpx; line-height: 1.9; white-space: pre-wrap; }
.about-state, .about-fallback-note { padding: 50rpx 48rpx 0; color: #8b6b58; font-size: 23rpx; line-height: 1.7; }
.about-tabbar { position: fixed; right: 0; bottom: 0; left: 0; z-index: 20; display: flex; height: 116rpx; padding-bottom: env(safe-area-inset-bottom); border-top: 1rpx solid rgba(92,73,60,.22); background: rgba(231,223,209,.98); }.tab-item { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 4rpx; color: #9a8c80; font-family: Georgia, "Songti SC", serif; font-size: 22rpx; }.tab-item.selected { color: #663124; font-weight: 600; }.tab-icon { font-size: 34rpx; line-height: 1; }

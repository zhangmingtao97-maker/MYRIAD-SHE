@import "../../app.wxss";

page { min-height: 100vh; background: #e7dfd1; color: #5c493c; }
.compose-page { min-height: 100vh; padding: 0 40rpx calc(152rpx + env(safe-area-inset-bottom)); box-sizing: border-box; background: #e7dfd1; color: #5c493c; font-family: "MYRIAD Garamond", "MYRIAD Song", serif; }
.compose-topbar { position: sticky; z-index: 20; top: 0; display: flex; height: 44px; align-items: center; justify-content: center; margin: 0 -40rpx; border-bottom: 1rpx solid rgba(92, 73, 60, .23); background: #e7dfd1; box-sizing: content-box; }
.compose-nav-title { color: #5c493c; font-size: 32rpx; font-weight: 700; line-height: 1.4; }
.compose-control { position: absolute; display: flex; width: 88rpx; height: 44px; align-items: center; justify-content: center; color: #5c493c; }
.compose-back { left: 20rpx; padding-bottom: 5rpx; font-family: "MYRIAD Garamond", "MYRIAD Song", serif; font-size: 56rpx; line-height: 1; }
.compose-more { right: 20rpx; padding-bottom: 17rpx; font-family: "MYRIAD Garamond", "MYRIAD Song", serif; font-size: 30rpx; }
.compose-content { padding-bottom: 8rpx; }
.compose-meta { display: flex; align-items: baseline; gap: 54rpx; min-height: 32rpx; margin-top: 52rpx; color: #6b584a; font-size: 23rpx; line-height: 1.5; }
.compose-number { color: #663124; font-family: "MYRIAD Garamond", "MYRIAD Song", serif; }
.compose-heading { margin-top: 76rpx; color: #5c493c; font-size: 54rpx; font-weight: 700; line-height: 1.58; white-space: pre-line; }
.compose-intro { margin-top: 48rpx; color: #5c493c; font-size: 30rpx; font-weight: 600; line-height: 1.8; }
.compose-field-label { margin-top: 50rpx; padding-bottom: 22rpx; border-bottom: 1px solid rgba(92, 73, 60, .34); color: #663124; font-size: 25rpx; font-weight: 700; line-height: 1.6; }
.compose-input { display: block; width: 100%; height: 440rpx; min-height: 440rpx; padding: 28rpx 0 12rpx; border-bottom: 1px solid rgba(92, 73, 60, .34); color: #5c493c; font-size: 30rpx; line-height: 1.8; box-sizing: border-box; }
.compose-placeholder { color: #6b584a; }
.compose-input-wrap { position: relative; }
.compose-input-placeholder { position: absolute; top: 28rpx; right: 0; left: 0; overflow: hidden; color: #6b584a; font-size: 30rpx; line-height: 1.8; word-break: break-all; pointer-events: none; }
.compose-count { margin-top: 6rpx; color: #6b584a; font-family: "MYRIAD Garamond", "MYRIAD Song", serif; font-size: 21rpx; line-height: 1.6; text-align: right; }
.compose-notify { display: flex; align-items: center; justify-content: space-between; gap: 28rpx; padding: 24rpx 0 2rpx; color: #5c493c; }
.compose-notify-copy { min-width: 0; }
.compose-notify-title { font-size: 24rpx; font-weight: 600; line-height: 1.65; }
.compose-notify-hint { margin-top: 2rpx; color: #6b584a; font-size: 20rpx; font-weight: 500; line-height: 1.55; }
.compose-notify-toggle { position: relative; width: 72rpx; height: 40rpx; flex: 0 0 auto; border: 1rpx solid rgba(92, 73, 60, .34); border-radius: 999rpx; background: rgba(92, 73, 60, .08); transition: background .18s ease, border-color .18s ease; }
.compose-notify-toggle view { position: absolute; top: 4rpx; left: 4rpx; width: 30rpx; height: 30rpx; border-radius: 50%; background: #8b6b58; transition: transform .18s ease, background .18s ease; }
.compose-notify-toggle.is-on { border-color: #663124; background: #663124; }
.compose-notify-toggle.is-on view { background: #f5f0e8; transform: translateX(32rpx); }
.compose-preview { display: flex; box-sizing: border-box; min-height: 116rpx; align-items: center; justify-content: space-between; gap: 24rpx; margin-top: 46rpx; padding: 24rpx 28rpx; border: 1rpx solid #663124; border-radius: 2rpx; background: #663124; color: #f5f0e8; box-shadow: 0 10rpx 24rpx rgba(102, 49, 36, .14); }
.compose-preview-copy { display: flex; min-width: 0; flex-direction: column; gap: 4rpx; }
.compose-preview-label { color: #f5f0e8; font-size: 29rpx; font-weight: 700; line-height: 1.55; }
.compose-preview-hint { color: rgba(245, 240, 232, .78); font-size: 21rpx; font-weight: 500; line-height: 1.55; letter-spacing: .01em; }
.compose-arrow { flex: 0 0 auto; color: #f5f0e8; font-family: "MYRIAD Garamond", "MYRIAD Song", serif; font-size: 40rpx; line-height: 1; }
.compose-share-note { margin-top: 20rpx; color: #6b584a; font-size: 23rpx; font-weight: 500; line-height: 1.8; letter-spacing: .01em; }
.compose-preview-mode { margin: 0 8rpx; color: #5C4958; font-weight: 500; animation: compose-preview-in .22s ease-out both; }
.compose-preview-meta { display: flex; align-items: baseline; gap: 54rpx; min-height: 32rpx; margin-top: 52rpx; color: #5C4958; font-size: 23rpx; font-weight: 500; line-height: 1.5; }
.compose-preview-number { color: #5C4958; font-family: "MYRIAD Garamond", "MYRIAD Song", serif; }
.compose-preview-title { margin-top: 62rpx; color: #5C4958; font-size: 54rpx; font-weight: 600; line-height: 1.58; white-space: pre-line; }
.compose-preview-question { margin-top: 64rpx; color: #5C4958; font-size: 27rpx; font-weight: 600; line-height: 1.9; letter-spacing: .01em; }
.compose-preview-local { margin-top: 40rpx; color: #5C4958; font-size: 22rpx; font-weight: 500; line-height: 1.8; }
.compose-preview-heading { display: grid; grid-template-columns: 80rpx 1fr; margin-top: 62rpx; color: #5C4958; font-family: "MYRIAD Garamond", "MYRIAD Song", serif; font-size: 22rpx; line-height: 1.6; letter-spacing: .08em; }
.compose-preview-heading-title, .compose-preview-heading-hint { color: #5C4958; font-size: 22rpx; font-weight: 600; line-height: 1.6; }
.compose-preview-card { margin-top: 46rpx; padding-top: 38rpx; border-top: 1px solid #cdbbae; }
.compose-preview-byline { display: flex; align-items: baseline; gap: 24rpx; color: #5C4958; font-size: 26rpx; line-height: 1.6; }
.compose-preview-author { font-size: 26rpx; }
.compose-preview-kind { color: #5C4958; font-size: 20rpx; font-weight: 500; letter-spacing: .04em; }
.compose-preview-card-body { margin-top: 26rpx; color: #5C4958; font-size: 27rpx; font-weight: 600; line-height: 1.95; white-space: pre-wrap; overflow-wrap: anywhere; }
.compose-preview-confirm { display: grid; grid-template-columns: 30rpx 1fr; align-items: start; gap: 22rpx; margin: 52rpx 0; color: #5C4958; font-size: 23rpx; font-weight: 600; line-height: 1.8; }
.compose-preview-checkbox { width: 30rpx; height: 30rpx; margin-top: 6rpx; border: 2rpx solid #8b6b58; box-sizing: border-box; }
.compose-preview-checkbox.is-checked { border-color: #663124; background: #663124; box-shadow: inset 0 0 0 5rpx #e7dfd1; }
.compose-preview-confirm-text { color: #5C4958; font-size: 23rpx; line-height: 1.8; }
.compose-preview-primary { display: flex; box-sizing: border-box; min-height: 98rpx; align-items: center; justify-content: space-between; gap: 16rpx; padding: 22rpx 28rpx; border: 1rpx solid #663124; border-radius: 2rpx; background: #663124; color: #f5f0e8; font-size: 27rpx; font-weight: 700; line-height: 1.85; }
.compose-preview-primary.is-disabled { border-color: rgba(92, 73, 88, .3); background: rgba(92, 73, 88, .08); color: rgba(92, 73, 88, .55); box-shadow: none; }
.compose-preview-primary-arrow { flex: 0 0 auto; color: inherit; font-family: "MYRIAD Garamond", "MYRIAD Song", serif; font-size: 40rpx; line-height: 1; }
.compose-preview-back { display: flex; box-sizing: border-box; min-height: 76rpx; align-items: center; margin-top: 19rpx; padding: 8rpx 0; color: #5C4958; font-size: 26rpx; font-weight: 600; line-height: 1.7; }
.compose-preview-draft-row { display: flex; box-sizing: border-box; min-height: 76rpx; align-items: center; justify-content: space-between; gap: 10rpx; margin-top: 49rpx; color: #5C4958; font-size: 22rpx; font-weight: 500; line-height: 1.8; }
.compose-preview-draft-action { display: flex; box-sizing: border-box; min-height: 76rpx; align-items: center; padding: 8rpx 0; }
.compose-preview-draft-action:last-child { color: #5C4958; }
@keyframes compose-preview-in { from { transform: translateY(18rpx); } to { transform: translateY(0); } }
.compose-editor-draft-row { margin-top: 49rpx; }
.compose-error { margin-top: 12rpx; color: #8c4035; font-size: 23rpx; line-height: 1.7; }
.compose-access-state { display: flex; min-height: 360rpx; flex-direction: column; justify-content: center; gap: 20rpx; color: #8b6b58; font-size: 26rpx; line-height: 1.85; }
.compose-access-error { color: #8c4035; }
.compose-access-restricted { justify-content: flex-start; padding-top: 80rpx; }
.compose-access-title { color: #5c493c; font-size: 34rpx; font-weight: 700; line-height: 1.55; }
.compose-access-copy { color: #5c493c; font-size: 25rpx; font-weight: 500; line-height: 1.9; }
.compose-access-recovery { color: #8b6b58; font-size: 22rpx; line-height: 1.75; }
.compose-access-retry { display: inline-flex; min-height: 84rpx; align-items: center; align-self: flex-start; margin-top: 6rpx; border-bottom: 1rpx solid #cdbbae; color: #663124; font-size: 25rpx; font-weight: 600; }
.compose-tabbar { position: fixed; z-index: 30; right: 0; bottom: 0; left: 0; display: flex; height: calc(120rpx + env(safe-area-inset-bottom)); padding: 0 24rpx env(safe-area-inset-bottom); border-top: 1rpx solid rgba(92, 73, 60, .23); background: #e7dfd1; box-sizing: border-box; }
.compose-tab { display: flex; flex: 1; min-width: 0; min-height: 112rpx; flex-direction: column; align-items: center; justify-content: center; gap: 8rpx; color: #928276; }
.compose-tab.selected { color: #663124; }
.compose-tab-icon { position: relative; display: flex; width: 40rpx; height: 40rpx; align-items: center; justify-content: center; color: inherit; }
.compose-home-icon { border: 2rpx solid currentColor; border-radius: 50%; }
.compose-home-icon view { width: 8rpx; height: 8rpx; border-radius: 50%; background: currentColor; }
.compose-practice-icon { flex-direction: column; justify-content: space-around; }
.compose-practice-icon view { width: 26rpx; height: 7rpx; border: 2rpx solid currentColor; border-right: 0; border-left: 0; border-radius: 50%; }
.compose-mine-icon { overflow: hidden; border: 2rpx solid currentColor; border-radius: 50%; }
.compose-mine-head { position: absolute; top: 6rpx; left: 12rpx; width: 9rpx; height: 9rpx; border: 2rpx solid currentColor; border-radius: 50%; }
.compose-mine-body { position: absolute; bottom: -7rpx; left: 6rpx; width: 21rpx; height: 16rpx; border: 2rpx solid currentColor; border-radius: 50% 50% 0 0; }
.compose-tab text { color: inherit; font-size: 24rpx; line-height: 1.2; }
.compose-page [role="button"]:active { opacity: .62; }
@media (prefers-reduced-motion: reduce) { .compose-page [role="button"] { transition: none; transform: none; } .compose-preview-mode { animation: none; } }

/* 已有草稿/已提交回应时的选择条 */
.compose-draft-notice { margin-top: 36rpx; padding: 24rpx 0 18rpx; border-top: 1rpx solid rgba(92, 73, 60, .28); border-bottom: 1rpx solid rgba(92, 73, 60, .28); }
.compose-draft-notice-text { color: #5c493c; font-size: 23rpx; font-weight: 500; line-height: 1.85; }
.compose-draft-notice-actions { display: flex; flex-wrap: wrap; gap: 46rpx; margin-top: 16rpx; }
.compose-draft-notice-action { color: #8a5a3b; font-size: 24rpx; font-weight: 600; line-height: 1.7; }
/* RichText 在 Flex/Grid 容器内保持块级布局，避免局部字号与颜色样式失效。 */
.compose-nav-title,
.compose-number,
.compose-heading,
.compose-intro,
.compose-field-label,
.compose-action-copy,
.compose-preview-title,
.compose-preview-question,
.compose-preview-card-body {
  display: block;
  min-width: 0;
}

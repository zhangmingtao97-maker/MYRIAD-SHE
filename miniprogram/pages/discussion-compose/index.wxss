@import "../../app.wxss";

page { min-height: 100vh; background: #e7dfd1; color: #5c493c; }
.compose-page { min-height: 100vh; padding: 0 40rpx calc(152rpx + env(safe-area-inset-bottom)); box-sizing: border-box; background: #e7dfd1; color: #5c493c; font-family: "MYRIAD Song", "Source Han Serif CN", "Songti SC", serif; }
.compose-topbar { position: sticky; z-index: 20; top: 0; display: flex; height: 44px; align-items: center; justify-content: center; margin: 0 -40rpx; border-bottom: 1rpx solid rgba(92, 73, 60, .23); background: #e7dfd1; box-sizing: content-box; }
.compose-nav-title { color: #5c493c; font-size: 32rpx; font-weight: 700; line-height: 1.4; }
.compose-control { position: absolute; display: flex; width: 88rpx; height: 44px; align-items: center; justify-content: center; color: #5c493c; }
.compose-back { left: 20rpx; padding-bottom: 5rpx; font-family: Georgia, serif; font-size: 56rpx; line-height: 1; }
.compose-more { right: 20rpx; padding-bottom: 17rpx; font-family: Georgia, serif; font-size: 30rpx; }
.compose-content { padding-bottom: 8rpx; }
.compose-meta { display: flex; align-items: baseline; gap: 54rpx; min-height: 32rpx; margin-top: 52rpx; color: #6b584a; font-size: 23rpx; line-height: 1.5; }
.compose-number { color: #663124; font-family: Georgia, serif; }
.compose-heading { margin-top: 76rpx; color: #5c493c; font-size: 54rpx; font-weight: 700; line-height: 1.58; white-space: pre-line; }
.compose-intro { margin-top: 48rpx; color: #5c493c; font-size: 30rpx; font-weight: 600; line-height: 1.8; }
.compose-field-label { margin-top: 50rpx; padding-bottom: 22rpx; border-bottom: 1px solid rgba(92, 73, 60, .34); color: #663124; font-size: 25rpx; font-weight: 700; line-height: 1.6; }
.compose-input { display: block; width: 100%; height: 440rpx; min-height: 440rpx; padding: 28rpx 0 12rpx; border-bottom: 1px solid rgba(92, 73, 60, .34); color: #5c493c; font-size: 30rpx; line-height: 1.8; box-sizing: border-box; }
.compose-placeholder { color: #6b584a; }
.compose-count { margin-top: 6rpx; color: #6b584a; font-family: Georgia, serif; font-size: 21rpx; line-height: 1.6; text-align: right; }
.compose-preview { display: flex; box-sizing: border-box; min-height: 90rpx; align-items: center; justify-content: space-between; margin-top: 46rpx; padding: 18rpx 0; border-top: 1px solid #4a372b; border-bottom: 1px solid #4a372b; color: #4a372b; font-size: 26rpx; font-weight: 400; line-height: 1.85; }
.compose-arrow { flex: 0 0 auto; font-family: "MYRIAD Garamond", Georgia, serif; font-size: 38rpx; line-height: 1; }
.compose-share-note { margin-top: 20rpx; color: #6b584a; font-size: 23rpx; font-weight: 500; line-height: 1.8; letter-spacing: .01em; }
.compose-preview-mode { margin: 0 8rpx; padding-top: 96rpx; font-weight: 500; animation: compose-preview-in .22s ease-out both; }
.compose-preview-question { color: #4a372b; font-size: 27rpx; font-weight: 600; line-height: 1.9; letter-spacing: .01em; }
.compose-preview-local { margin-top: 40rpx; color: #4a372b; font-size: 22rpx; font-weight: 500; line-height: 1.8; }
.compose-preview-heading { display: grid; grid-template-columns: 80rpx 1fr; margin-top: 62rpx; color: #663124; font-family: "MYRIAD Garamond", Georgia, serif; font-size: 22rpx; line-height: 1.6; letter-spacing: .08em; }
.compose-preview-heading-title, .compose-preview-heading-hint { color: #663124; font-size: 22rpx; font-weight: 600; line-height: 1.6; }
.compose-preview-card { margin-top: 46rpx; padding-top: 38rpx; border-top: 1px solid rgba(74, 55, 43, .38); }
.compose-preview-byline { display: flex; align-items: baseline; gap: 24rpx; color: #4a372b; font-size: 26rpx; line-height: 1.6; }
.compose-preview-author { font-size: 26rpx; }
.compose-preview-kind { color: #6b584a; font-size: 20rpx; font-weight: 500; letter-spacing: .04em; }
.compose-preview-card-body { margin-top: 26rpx; color: #4a372b; font-size: 27rpx; line-height: 1.95; white-space: pre-wrap; overflow-wrap: anywhere; }
.compose-preview-confirm { display: grid; grid-template-columns: 30rpx 1fr; align-items: start; gap: 22rpx; margin: 52rpx 0; color: #4f3f34; font-size: 23rpx; font-weight: 600; line-height: 1.8; }
.compose-preview-checkbox { width: 30rpx; height: 30rpx; margin-top: 6rpx; border: 2rpx solid #6b584a; box-sizing: border-box; }
.compose-preview-checkbox.is-checked { border-color: #663124; background: #663124; box-shadow: inset 0 0 0 5rpx #e7dfd1; }
.compose-preview-confirm-text { color: #4f3f34; font-size: 23rpx; line-height: 1.8; }
.compose-preview-primary { display: flex; box-sizing: border-box; min-height: 90rpx; align-items: center; justify-content: space-between; gap: 16rpx; padding: 18rpx 0; border-top: 1px solid #4a372b; border-bottom: 1px solid #4a372b; color: #4a372b; font-size: 27rpx; font-weight: 600; line-height: 1.85; }
.compose-preview-primary.is-disabled { border-color: rgba(74, 55, 43, .55); color: #4a372b; }
.compose-preview-primary-arrow { flex: 0 0 auto; color: inherit; font-family: "MYRIAD Garamond", Georgia, serif; font-size: 40rpx; line-height: 1; }
.compose-preview-back { display: flex; box-sizing: border-box; min-height: 76rpx; align-items: center; margin-top: 19rpx; padding: 8rpx 0; color: #4a372b; font-size: 26rpx; font-weight: 600; line-height: 1.7; }
.compose-preview-draft-row { display: flex; box-sizing: border-box; min-height: 76rpx; align-items: center; justify-content: space-between; gap: 10rpx; margin-top: 49rpx; color: #4a372b; font-size: 22rpx; font-weight: 500; line-height: 1.8; }
.compose-preview-draft-action { display: flex; box-sizing: border-box; min-height: 76rpx; align-items: center; padding: 8rpx 0; }
.compose-preview-draft-action:last-child { color: #4a372b; }
@keyframes compose-preview-in { from { transform: translateY(18rpx); } to { transform: translateY(0); } }
.compose-editor-draft-row { margin-top: 49rpx; }
.compose-error { margin-top: 12rpx; color: #8c4035; font-size: 23rpx; line-height: 1.7; }
.compose-tabbar { position: fixed; z-index: 30; right: 0; bottom: 0; left: 0; display: flex; height: calc(120rpx + env(safe-area-inset-bottom)); padding: 0 24rpx env(safe-area-inset-bottom); border-top: 1rpx solid rgba(92, 73, 60, .23); background: #e7dfd1; box-sizing: border-box; }
.compose-tab { display: flex; flex: 1; min-width: 0; min-height: 112rpx; flex-direction: column; align-items: center; justify-content: center; gap: 8rpx; color: #928276; }
.compose-tab.selected { color: #663124; }
.compose-tab-icon { position: relative; display: flex; width: 40rpx; height: 40rpx; align-items: center; justify-content: center; color: inherit; }
.compose-home-icon { border: 2rpx solid currentColor; border-radius: 50%; }
.compose-home-icon view { width: 8rpx; height: 8rpx; border-radius: 50%; background: currentColor; }
.compose-practice-icon { flex-direction: column; justify-content: space-around; }
.compose-practice-icon view { width: 26rpx; height: 7rpx; border: 2rpx solid currentColor; border-right: 0; border-left: 0; border-radius: 50%; }
.compose-mine-icon { overflow: hidden; border: 2rpx solid currentColor; border-radius: 50%; }
.compose-mine-head { position: absolute; top: 6rpx; left: 12rpx; width: 9rpx; height: 9rpx; border: 2rpx solid currentColor; border-radius: 50%; }
.compose-mine-body { position: absolute; bottom: -7rpx; left: 6rpx; width: 21rpx; height: 16rpx; border: 2rpx solid currentColor; border-radius: 50% 50% 0 0; }
.compose-tab text { color: inherit; font-size: 24rpx; line-height: 1.2; }
.compose-page [role="button"]:active { opacity: .62; }
@media (prefers-reduced-motion: reduce) { .compose-page [role="button"] { transition: none; transform: none; } .compose-preview-mode { animation: none; } }

@import "../../app.wxss";

page { min-height: 100vh; background: #e7dfd1; color: #5c493c; }
.archive-page { min-height: 100vh; padding: 0 40rpx calc(160rpx + env(safe-area-inset-bottom)); background: #e7dfd1; color: #5c493c; box-sizing: border-box; font-family: "Source Han Serif CN", "Source Han Serif SC", "Noto Serif CJK SC", "Songti SC", STSong, serif; }
.archive-topbar { position: sticky; z-index: 10; top: 0; margin: 0 -40rpx; border-bottom: 1rpx solid rgba(92, 73, 60, .22); background: #e7dfd1; }
.archive-topbar-row { position: relative; display: flex; height: 88rpx; align-items: center; justify-content: center; padding: 0 120rpx; box-sizing: border-box; }
.archive-topbar-title { color: #5c493c; font-size: 30rpx; font-weight: 600; line-height: 1.4; }
.archive-control { position: absolute; top: 0; display: flex; width: 88rpx; height: 88rpx; align-items: center; justify-content: center; color: #5c493c; }
.archive-back { left: 22rpx; font-family: Georgia, serif; font-size: 56rpx; line-height: 1; }
.archive-more { right: 22rpx; font-family: Georgia, serif; font-size: 34rpx; letter-spacing: 3rpx; }
.archive-control:active, .archive-issue.is-interactive:active { opacity: .62; }
.archive-content { padding: 48rpx 0 0; }
.archive-meta { display: flex; align-items: center; justify-content: space-between; color: #8a6755; font-size: 23rpx; line-height: 1.5; }
.archive-meta text:last-child, .archive-issues-heading text:last-child { color: #663124; font-family: Garamond, Georgia, serif; letter-spacing: .08em; }
.archive-hero-title { margin-top: 108rpx; color: #5c493c; font-size: 58rpx; font-weight: 600; line-height: 1.25; letter-spacing: .01em; }
.archive-intro { max-width: 650rpx; margin-top: 42rpx; color: #40362f; font-size: 28rpx; line-height: 1.8; }
.archive-issues { margin-top: 126rpx; border-top: 1rpx solid rgba(92, 73, 60, .24); }
.archive-issues-heading { display: flex; min-height: 92rpx; align-items: center; justify-content: space-between; color: #8a6755; font-size: 23rpx; line-height: 1.5; }
.archive-issue { display: grid; grid-template-columns: 62rpx minmax(0, 1fr); gap: 20rpx; min-height: 184rpx; padding: 20rpx 0 24rpx; border-bottom: 1rpx solid rgba(92, 73, 60, .24); box-sizing: border-box; }
.archive-issue-number { padding-top: 4rpx; color: #8a6755; font-family: Garamond, Georgia, serif; font-size: 23rpx; letter-spacing: .06em; }
.archive-issue-main { min-width: 0; }
.archive-issue-status { display: block; color: #8a6755; font-size: 23rpx; line-height: 1.5; }
.archive-issue-title { display: flex; align-items: baseline; justify-content: space-between; gap: 24rpx; margin-top: 20rpx; color: #5c493c; font-size: 34rpx; font-weight: 600; line-height: 1.45; }
.archive-issue-title > text:first-child { min-width: 0; }
.archive-issue-arrow { flex: 0 0 auto; color: #663124; font-family: Garamond, Georgia, serif; font-size: 33rpx; font-weight: 400; }
.archive-issue-subline { display: block; margin-top: 8rpx; color: #5c493c; font-size: 25rpx; line-height: 1.55; }
.archive-state { min-height: 180rpx; padding: 44rpx 0; color: #76695f; font-size: 26rpx; line-height: 1.8; box-sizing: border-box; }
.archive-empty { padding-top: 52rpx; }
.archive-error { color: #8c4035; }
.archive-retry { display: inline-flex; min-height: 80rpx; align-items: center; margin-top: 12rpx; color: #663124; border-bottom: 1rpx solid rgba(92, 73, 60, .28); }
@media (prefers-reduced-motion: reduce) { .archive-control, .archive-issue { transition: none; transform: none; } }

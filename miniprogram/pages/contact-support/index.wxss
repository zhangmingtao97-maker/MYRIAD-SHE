@import "../daily-objects/index.wxss";

.support-content { padding: 52rpx 52rpx 72rpx; color: #5c493c; font-family: Georgia, "Songti SC", serif; }
.support-eyebrow { color: #663124; font-family: Georgia, "Times New Roman", serif; font-size: 18rpx; line-height: 1.5; letter-spacing: .12em; }
.support-title { margin-top: 48rpx; color: #5c493c; font-size: 48rpx; font-weight: 600; line-height: 1.35; }
.support-intro { margin-top: 22rpx; color: #5c493c; font-size: 25rpx; line-height: 1.8; }
.support-section { margin-top: 52rpx; padding-top: 54rpx; border-top: 1rpx solid rgba(92, 73, 60, .28); }
.support-heading { color: #5c493c; font-size: 36rpx; font-weight: 600; line-height: 1.4; }
.support-copy { margin-top: 42rpx; color: #5c493c; font-size: 24rpx; line-height: 1.9; }
.support-button { position: relative; display: flex; width: 100%; height: 88rpx; align-items: center; justify-content: center; box-sizing: border-box; font-size: 24rpx; }
.support-button-primary { margin-top: 48rpx; background: #663124; color: #f5f0e8; font-weight: 600; }
.support-button-primary text { position: absolute; right: 28rpx; font-family: Georgia, serif; font-size: 30rpx; }
.support-button-secondary { margin-top: 20rpx; border: 1rpx solid rgba(92, 73, 60, .35); color: #5c493c; }
@media (max-width: 360px) { .support-content { padding-right: 44rpx; padding-left: 44rpx; } }

<view class="page detail-page record-align-{{recordAlign}} record-spacing-{{recordSpacing}}">
  <view class="detail-topbar" style="padding-top: {{statusBarHeight}}px">
    <view class="detail-nav-row">
      <view class="detail-back" role="button" aria-label="返回上一级" tabindex="0" bindtap="handleBack">‹</view>
      <rich-text class="detail-nav-title" nodes="{{recordCopy.navTitle.richText}}" style="font-size: {{recordCopy.navTitle.fontSize * 2}}rpx; color: {{recordCopy.navTitle.color}};"></rich-text>
      <view class="detail-nav-spacer" aria-hidden="true"></view>
    </view>
  </view>
  <view wx:if="{{accountDeleted}}" class="panel account-deleted"><view class="eyebrow">云端账户</view><view class="title">账户已删除</view><view class="muted">此微信身份对应的云端账户已删除，请回到“我的”页面确认是否创建新账户。</view></view>
  <view wx:elif="{{loading}}" class="loading-copy" role="status" aria-live="polite">正在读取云端记录…</view>
  <view wx:elif="{{record}}" class="record-content">
    <view class="record-meta">
      <rich-text wx:if="{{record.method === 'reality'}}" class="record-method" nodes="{{recordCopy.methodReality.richText}}" style="font-size: {{recordCopy.methodReality.fontSize * 2}}rpx; color: {{recordCopy.methodReality.color}};"></rich-text>
      <rich-text wx:else class="record-method" nodes="{{recordCopy.methodSeason.richText}}" style="font-size: {{recordCopy.methodSeason.fontSize * 2}}rpx; color: {{recordCopy.methodSeason.color}};"></rich-text>
      <view class="record-date"><text>{{recordDate}} · </text><rich-text wx:if="{{record.status === 'draft'}}" nodes="{{recordCopy.statusDraft.richText}}" style="font-size: {{recordCopy.statusDraft.fontSize * 2}}rpx; color: {{recordCopy.statusDraft.color}};"></rich-text><rich-text wx:else nodes="{{recordCopy.statusSaved.richText}}" style="font-size: {{recordCopy.statusSaved.fontSize * 2}}rpx; color: {{recordCopy.statusSaved.color}};"></rich-text></view>
    </view>

    <view class="stage">
      <view class="stage-label"><rich-text nodes="{{recordCopy.stageBase.richText}}" style="font-size: {{recordCopy.stageBase.fontSize * 2}}rpx; color: {{recordCopy.stageBase.color}};"></rich-text><text wx:if="{{cardSuffix}}"> {{cardSuffix}}</text></view>
      <view wx:if="{{cardTitle}}" class="stage-title">{{cardTitle}}</view>
      <view wx:if="{{cardSubtitle}}" class="stage-subtitle">{{cardSubtitle}}</view>
    </view>

    <view class="stage">
      <rich-text class="stage-label" nodes="{{recordCopy.stageNow.richText}}" style="font-size: {{recordCopy.stageNow.fontSize * 2}}rpx; color: {{recordCopy.stageNow.color}};"></rich-text>
      <view class="stage-block">
        <rich-text class="stage-key" nodes="{{recordCopy.experienceLabel.richText}}" style="font-size: {{recordCopy.experienceLabel.fontSize * 2}}rpx; color: {{recordCopy.experienceLabel.color}};"></rich-text>
        <view class="stage-value {{experienceText ? '' : 'stage-empty'}}" style="{{experienceText ? '' : emptyValueStyle}}">{{experienceText || emptyValueText}}</view>
      </view>
      <view class="stage-block">
        <rich-text class="stage-key" nodes="{{recordCopy.changeLabel.richText}}" style="font-size: {{recordCopy.changeLabel.fontSize * 2}}rpx; color: {{recordCopy.changeLabel.color}};"></rich-text>
        <view class="stage-value {{changeStates ? '' : 'stage-empty'}}" style="{{changeStates ? '' : emptyValueStyle}}">{{changeStates || emptyValueText}}</view>
      </view>
    </view>

    <view class="stage">
      <rich-text class="stage-label" nodes="{{recordCopy.stageChoice.richText}}" style="font-size: {{recordCopy.stageChoice.fontSize * 2}}rpx; color: {{recordCopy.stageChoice.color}};"></rich-text>
      <view class="stage-block">
        <view class="stage-key-row"><rich-text class="stage-key" nodes="{{recordCopy.keepLabel.richText}}" style="font-size: {{recordCopy.keepLabel.fontSize * 2}}rpx; color: {{recordCopy.keepLabel.color}};"></rich-text><rich-text class="stage-key-optional" nodes="{{recordCopy.keepLabelOptional.richText}}" style="font-size: {{recordCopy.keepLabelOptional.fontSize * 2}}rpx; color: {{recordCopy.keepLabelOptional.color}};"></rich-text></view>
        <view class="stage-value {{keepText ? '' : 'stage-empty'}}" style="{{keepText ? '' : emptyValueStyle}}">{{keepText || emptyValueText}}</view>
      </view>
      <view wx:if="{{rejectText}}" class="stage-block">
        <rich-text class="stage-key" nodes="{{recordCopy.stageRejectLabel.richText}}" style="font-size: {{recordCopy.stageRejectLabel.fontSize * 2}}rpx; color: {{recordCopy.stageRejectLabel.color}};"></rich-text>
        <view class="stage-value">{{rejectText}}</view>
      </view>
    </view>

    <view class="stage">
      <view class="stage-label-row"><rich-text class="stage-label" nodes="{{recordCopy.stageAction.richText}}" style="font-size: {{recordCopy.stageAction.fontSize * 2}}rpx; color: {{recordCopy.stageAction.color}};"></rich-text><rich-text wx:if="{{record.method === 'season'}}" class="stage-label-tail" nodes="{{recordCopy.seasonActionTail.richText}}" style="font-size: {{recordCopy.seasonActionTail.fontSize * 2}}rpx; color: {{recordCopy.seasonActionTail.color}};"></rich-text></view>
      <view class="stage-action {{actionText ? '' : 'stage-empty'}}" style="{{actionText ? '' : emptyValueStyle}}">{{actionText || emptyValueText}}</view>
    </view>

    <view wx:if="{{record.issueQuestion}}" class="issue-context"><view class="eyebrow">{{record.issueLabel || '观察来源'}}</view><view class="issue-question">{{record.issueQuestion}}</view></view>

    <view class="perspective">
      <rich-text class="stage-key" nodes="{{recordCopy.perspectiveLabel.richText}}" style="font-size: {{recordCopy.perspectiveLabel.fontSize * 2}}rpx; color: {{recordCopy.perspectiveLabel.color}};"></rich-text>
      <view class="stage-value perspective-value {{perspectiveEmpty ? 'stage-empty' : ''}}" style="{{perspectiveEmpty ? perspectiveEmptyStyle : ''}}">{{perspective}}</view>
      <rich-text class="perspective-note" nodes="{{recordCopy.perspectiveNote.richText}}" style="font-size: {{recordCopy.perspectiveNote.fontSize * 2}}rpx; color: {{recordCopy.perspectiveNote.color}};"></rich-text>
    </view>

    <view wx:if="{{error}}" class="error-text" role="alert">{{error}}</view>

    <view class="record-actions">
      <view class="edit-button {{deleting ? 'disabled' : ''}}" role="button" aria-label="修改这次观察" aria-disabled="{{deleting}}" tabindex="0" bindtap="editRecord"><rich-text nodes="{{recordCopy.editAction.richText}}" style="font-size: {{recordCopy.editAction.fontSize * 2}}rpx; color: {{recordCopy.editAction.color}};"></rich-text></view>
      <view class="secondary-actions">
        <view class="again-button {{deleting ? 'disabled' : ''}}" role="button" aria-label="再次观察" aria-disabled="{{deleting}}" tabindex="0" bindtap="startAgain"><rich-text nodes="{{recordCopy.againAction.richText}}" style="font-size: {{recordCopy.againAction.fontSize * 2}}rpx; color: {{recordCopy.againAction.color}};"></rich-text></view>
        <view class="delete-button {{deleting ? 'disabled' : ''}}" role="button" aria-label="删除记录" aria-disabled="{{deleting}}" tabindex="0" bindtap="deleteRecord"><rich-text wx:if="{{deleting}}" nodes="{{recordCopy.deletingAction.richText}}" style="font-size: {{recordCopy.deletingAction.fontSize * 2}}rpx; color: {{recordCopy.deletingAction.color}};"></rich-text><rich-text wx:else nodes="{{recordCopy.deleteAction.richText}}" style="font-size: {{recordCopy.deleteAction.fontSize * 2}}rpx; color: {{recordCopy.deleteAction.color}};"></rich-text></view>
      </view>
    </view>
  </view>
  <view wx:elif="{{error}}" class="error-state"><view class="muted">{{error}}</view><view class="retry-button" role="button" aria-label="重新读取" tabindex="0" bindtap="loadRecord">重新读取</view></view>
  <view wx:else class="muted">这条记录暂时无法读取。</view>
</view>

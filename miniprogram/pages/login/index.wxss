page { min-height: 100%; background: #f5f0e8; }

.login-page { display: flex; min-height: 100vh; flex-direction: column; justify-content: space-between; gap: 34rpx; padding: 28rpx 28rpx 48rpx; box-sizing: border-box; background: #f5f0e8; color: #40362f; }
.login-panel { display: flex; flex: 1; flex-direction: column; justify-content: center; min-height: 760rpx; padding: 46rpx 38rpx; box-sizing: border-box; border: 1rpx solid #ded3c5; border-radius: 8rpx; background: #fffdf9; }
.login-brand { display: flex; align-items: center; gap: 16rpx; }
.login-brand-name { color: #663124; font-family: Georgia, "MYRIAD Garamond", serif; font-size: 26rpx; line-height: 1.3; }
.login-copy { margin-top: 66rpx; }
.login-eyebrow { color: #8b6b58; font-family: Georgia, serif; font-size: 22rpx; }
.login-title { margin-top: 20rpx; color: #40362f; font-family: Georgia, "MYRIAD Song", "Songti SC", serif; font-size: 42rpx; font-weight: 500; line-height: 1.5; }
.login-description { margin-top: 18rpx; color: #75675d; font-size: 24rpx; line-height: 1.7; }
.login-rule { height: 1rpx; margin-top: 36rpx; background: #e4dbd1; }
.login-actions { display: grid; gap: 22rpx; margin-top: 40rpx; }
.login-button { display: flex; align-items: center; justify-content: center; width: 100%; min-height: 96rpx; margin: 0; padding: 18rpx 26rpx; border: 1rpx solid transparent; border-radius: 999rpx; box-sizing: border-box; font-size: 28rpx; font-weight: 600; line-height: 1.4; }
.login-button::after { border: 0; }
.login-button[disabled] { opacity: 1; }
.one-click-login-button { background: #663124; color: #fffaf4; box-shadow: 0 8rpx 18rpx rgba(102, 49, 36, .14); }
.login-page .one-click-login-button[disabled] { border-color: #c8b6a3; background: #e8ddd0; color: #645247; box-shadow: none; }
.one-click-login-button:not([disabled]):active { background: #52251c; transform: translateY(1rpx); }
.login-error { margin-top: 24rpx; color: #a53f32; font-size: 22rpx; line-height: 1.6; }
.login-consent { display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: 4rpx 8rpx; min-height: 64rpx; color: #75675d; font-size: 21rpx; line-height: 1.5; }
.consent-checkbox { display: flex; align-items: center; }
.consent-label { display: flex; align-items: center; gap: 6rpx; white-space: nowrap; }
.consent-label checkbox { transform: scale(.78); transform-origin: left center; }
.consent-policy-link { color: #663124; text-decoration: underline; }
.consent-hint { flex-basis: 100%; color: #8b6b58; text-align: center; }

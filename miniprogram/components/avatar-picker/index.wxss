.avatar-picker-overlay { position: fixed; z-index: 1000; top: 0; right: 0; bottom: 0; left: 0; }
.avatar-picker-mask { position: absolute; top: 0; right: 0; bottom: 0; left: 0; background: rgba(0, 0, 0, .5); }
.avatar-picker-panel { position: absolute; right: 0; bottom: 0; left: 0; overflow: hidden; padding-bottom: env(safe-area-inset-bottom); border-radius: 24rpx 24rpx 0 0; background: #fffdf9; }
.avatar-picker-action { display: flex; width: 100%; min-height: 112rpx; align-items: center; justify-content: center; margin: 0; padding: 28rpx 32rpx; border: 0; border-bottom: 1rpx solid #eee7df; border-radius: 0; background: #fffdf9; color: #663124; font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif; font-size: 32rpx; font-weight: 400; line-height: 1.6; box-sizing: border-box; }
.avatar-picker-action::after { border: 0; }
.avatar-picker-action-active { background: #f5eee5; }
.avatar-picker-action[disabled] { color: #9d8b7f; background: #fffdf9; }
.avatar-picker-wechat { min-height: 136rpx; }
.avatar-picker-message { padding: 12rpx 32rpx 20rpx; color: #80604d; font-size: 24rpx; line-height: 1.6; text-align: center; }
.avatar-picker-divider { height: 14rpx; background: #f1ece5; }
.avatar-picker-cancel { border-bottom: 0; }

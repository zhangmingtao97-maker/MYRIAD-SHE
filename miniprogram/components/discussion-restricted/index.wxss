:host { display: block; width: 100%; }
.restricted-stage {
  display: flex;
  width: 100%;
  align-items: center;
  justify-content: center;
  padding: 28rpx 0 48rpx;
  box-sizing: border-box;
}
.restricted-card {
  position: relative;
  width: 620rpx;
  max-width: calc(100vw - 80rpx);
  padding: 48rpx 38rpx 38rpx;
  overflow: hidden;
  border: 1rpx solid rgba(92, 73, 60, .24);
  background: rgba(245, 240, 232, .72);
  box-shadow: 0 18rpx 54rpx rgba(92, 73, 60, .08);
  box-sizing: border-box;
  color: #5c493c;
  font-family: "MYRIAD Song", "Source Han Serif CN", "Songti SC", serif;
}
.restricted-accent {
  position: absolute;
  top: 0;
  left: 38rpx;
  width: 64rpx;
  height: 4rpx;
  background: #663124;
}
.restricted-eyebrow {
  display: block;
  color: #8b6b58;
  font-family: Georgia, "Times New Roman", serif;
  font-size: 18rpx;
  line-height: 1.5;
  letter-spacing: .13em;
}
.restricted-title {
  display: block;
  margin-top: 26rpx;
  color: #4a3f38;
  font-size: 42rpx;
  font-weight: 700;
  line-height: 1.45;
}
.restricted-copy {
  display: block;
  margin-top: 22rpx;
  color: #5c493c;
  font-size: 25rpx;
  line-height: 1.9;
}
.restricted-reason {
  margin-top: 34rpx;
  padding: 24rpx 26rpx;
  border-left: 5rpx solid #663124;
  background: rgba(102, 49, 36, .075);
}
.restricted-reason-label {
  display: block;
  color: #8b6b58;
  font-size: 20rpx;
  font-weight: 600;
  line-height: 1.5;
  letter-spacing: .08em;
}
.restricted-reason-value {
  display: block;
  margin-top: 10rpx;
  color: #4a3f38;
  font-size: 27rpx;
  font-weight: 600;
  line-height: 1.75;
  word-break: break-all;
}
.restricted-reason-empty { color: #8b6b58; font-weight: 500; }
.restricted-recovery {
  display: block;
  margin-top: 24rpx;
  color: #5c493c;
  font-size: 23rpx;
  line-height: 1.8;
}
.restricted-actions { margin-top: 34rpx; }
.restricted-button {
  display: flex;
  width: 100%;
  min-height: 92rpx;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  font-size: 26rpx;
  font-weight: 650;
  line-height: 1.5;
}
.restricted-button-primary {
  position: relative;
  background: #663124;
  color: #f5f0e8;
  box-shadow: 0 10rpx 26rpx rgba(102, 49, 36, .18);
}
.restricted-button-arrow {
  position: absolute;
  right: 28rpx;
  font-family: Georgia, serif;
  font-size: 34rpx;
  font-weight: 400;
}
.restricted-button-secondary {
  min-height: 88rpx;
  margin-top: 16rpx;
  border: 1rpx solid rgba(92, 73, 60, .34);
  color: #5c493c;
  font-weight: 600;
}
.restricted-contact-hint {
  display: block;
  margin-top: 24rpx;
  color: #663124;
  font-size: 21rpx;
  line-height: 1.7;
  word-break: break-all;
}
.restricted-note {
  display: block;
  margin-top: 18rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid rgba(92, 73, 60, .16);
  color: #8b6b58;
  font-size: 20rpx;
  line-height: 1.75;
}
.restricted-card [role="button"]:active { opacity: .68; }
@media (max-width: 360px) {
  .restricted-stage { padding-top: 18rpx; padding-bottom: 32rpx; }
  .restricted-card { width: calc(100vw - 64rpx); padding: 38rpx 28rpx 30rpx; }
  .restricted-title { font-size: 38rpx; }
  .restricted-accent { left: 28rpx; }
}
:host { display: block; width: 100%; height: 100%; }
.brand-launch-overlay {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 9999;
  width: 100vw;
  height: 100vh;
  overflow: hidden;
  background: #17110e;
}
.brand-launch-stage {
  position: relative;
  width: 100%;
  height: 100%;
  overflow: hidden;
  background: #17110e;
}
.brand-launch-image {
  display: block;
  width: 100%;
  height: 100%;
  background: #17110e;
}
.brand-launch-footer {
  position: absolute;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 2;
  display: flex;
  align-items: flex-end;
  justify-content: flex-end;
  padding: 140rpx 32rpx calc(env(safe-area-inset-bottom) + 28rpx);
  background: linear-gradient(180deg, rgba(18, 12, 9, 0) 0%, rgba(18, 12, 9, .68) 46%, rgba(18, 12, 9, .9) 100%);
  box-sizing: border-box;
  pointer-events: none;
}
.brand-launch-action {
  display: flex;
  min-width: 184rpx;
  min-height: 88rpx;
  align-items: center;
  justify-content: center;
  padding: 0 30rpx;
  border: 1rpx solid rgba(255, 255, 255, .58);
  border-radius: 999rpx;
  background: rgba(18, 12, 9, .52);
  color: #fff;
  font-size: 24rpx;
  font-weight: 650;
  line-height: 1.5;
  letter-spacing: .02em;
  box-shadow: 0 8rpx 28rpx rgba(0, 0, 0, .28);
  box-sizing: border-box;
  pointer-events: auto;
}
.brand-launch-action:active { background: rgba(18, 12, 9, .74); }
.brand-launch-action-readonly {
  pointer-events: none;
}

/* ---------- 启动品牌图轻量动效 ---------- */
.brand-launch-overlay {
  animation: brand-overlay-in .22s ease-out both;
}
.brand-launch-stage {
  transform: scale(1);
  transition: transform .18s ease-in;
}
.brand-launch-image {
  animation: brand-image-in .42s cubic-bezier(.22, 1, .36, 1) both;
}
.brand-launch-action {
  animation: brand-action-rise .32s cubic-bezier(.22, 1, .36, 1) .1s both;
  transition: background-color .18s ease, transform .18s ease;
}
.brand-launch-action:active { transform: scale(.98); }
.brand-launch-overlay.is-closing {
  animation: brand-overlay-out .18s ease-in both;
}
.brand-launch-overlay.is-closing .brand-launch-stage {
  transform: scale(1.012);
}
@keyframes brand-overlay-in {
  from { opacity: 0; }
  to { opacity: 1; }
}
@keyframes brand-overlay-out {
  from { opacity: 1; }
  to { opacity: 0; }
}
@keyframes brand-image-in {
  from { opacity: .72; transform: scale(1.025); }
  to { opacity: 1; transform: scale(1); }
}
@keyframes brand-action-rise {
  from { opacity: 0; transform: translateY(18rpx); }
  to { opacity: 1; transform: translateY(0); }
}
@media (prefers-reduced-motion: reduce) {
  .brand-launch-overlay, .brand-launch-image, .brand-launch-action { animation: none; transform: none; }
  .brand-launch-stage, .brand-launch-overlay.is-closing .brand-launch-stage { transition: none; transform: none; }
  .brand-launch-action { transition: none; }
  .brand-launch-action:active { transform: none; }
}

:host { display: block; width: 100%; height: 100%; }
.brand-launch-overlay {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 9999;
  width: 100vw;
  height: 100vh;
  overflow: hidden;
  background: #17110e;
}
.brand-launch-stage {
  position: relative;
  width: 100%;
  height: 100%;
  overflow: hidden;
  background: #17110e;
}
.brand-launch-image {
  display: block;
  width: 100%;
  height: 100%;
  background: #17110e;
}
.brand-launch-footer {
  position: absolute;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 2;
  display: flex;
  align-items: flex-end;
  justify-content: flex-end;
  padding: 140rpx 32rpx calc(env(safe-area-inset-bottom) + 28rpx);
  background: linear-gradient(180deg, rgba(18, 12, 9, 0) 0%, rgba(18, 12, 9, .68) 46%, rgba(18, 12, 9, .9) 100%);
  box-sizing: border-box;
  pointer-events: none;
}
.brand-launch-action {
  display: flex;
  min-width: 184rpx;
  min-height: 88rpx;
  align-items: center;
  justify-content: center;
  padding: 0 30rpx;
  border: 1rpx solid rgba(255, 255, 255, .58);
  border-radius: 999rpx;
  background: rgba(18, 12, 9, .52);
  color: #fff;
  font-size: 24rpx;
  font-weight: 650;
  line-height: 1.5;
  letter-spacing: .02em;
  box-shadow: 0 8rpx 28rpx rgba(0, 0, 0, .28);
  box-sizing: border-box;
  pointer-events: auto;
}
.brand-launch-action:active { background: rgba(18, 12, 9, .74); }
.brand-launch-action-readonly {
  pointer-events: none;
}

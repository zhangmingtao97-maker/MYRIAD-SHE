@font-face { font-family: "MYRIAD Song"; src: url("/SourceHanSerifCN-Regular.otf"); }
@font-face { font-family: "MYRIAD Garamond"; src: url("/AppleGaramond.ttf"); }
page { background: #f5f0e8; color: #40362f; font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif; }
.page { min-height: 100vh; padding: 40rpx 36rpx 160rpx; box-sizing: border-box; }
.brand-topbar { position: sticky; z-index: 10; top: 0; display: flex; align-items: center; justify-content: center; height: 44px; margin: 0 -36rpx; padding: 0 36rpx; border-bottom: 1rpx solid #c6bbad; background: #e7dfd1; box-sizing: content-box; }
.brand-topbar-copy { color: #663124; font-family: Georgia, serif; font-size: 31rpx; font-weight: 400; letter-spacing: 1rpx; }
.brand-mark { display: block; flex: 0 0 auto; width: 68rpx; height: 68rpx; }
.eyebrow { color: #8b6b58; font-size: 22rpx; letter-spacing: 3rpx; }
.title { margin: 10rpx 0 24rpx; font-family: Georgia, serif; font-size: 54rpx; font-weight: 400; }
.muted { color: #88786b; font-size: 26rpx; line-height: 1.7; }
.panel { margin-top: 28rpx; padding: 30rpx; background: #fffdf9; border: 1rpx solid #ded3c5; }
.button { display: flex; width: 100%; align-items: center; justify-content: center; box-sizing: border-box; margin: 30rpx 0 0; padding: 24rpx; border-radius: 4rpx; background: #663124; color: #fffaf4; text-align: center; font-size: 28rpx; line-height: 1.6; }
.button.secondary { background: transparent; color: #663124; border: 1rpx solid #cdbbae; }
.button { width: 100%; box-sizing: border-box; border: 0; line-height: 1.6; }
.button::after { border: 0; }
.button.secondary { border: 1rpx solid #cdbbae; }
.list { margin: 0; padding: 0; list-style: none; }
.list-item { padding: 26rpx 0; border-bottom: 1rpx solid #e4dbd1; }
.list-item:last-child { border-bottom: 0; }
.list-title { display: block; font-family: Georgia, serif; font-size: 34rpx; }
.list-desc { display: block; margin-top: 8rpx; color: #88786b; font-size: 24rpx; line-height: 1.6; }
.entry-status { display: inline-block; margin-top: 10rpx; color: #663124; font-size: 22rpx; line-height: 1.5; }
.disabled .list-title, .disabled .list-desc { color: #75675d; }

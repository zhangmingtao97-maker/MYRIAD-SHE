# Copy to .env.production and replace every REPLACE_* value before use.
APP_ENV=production
NODE_ENV=production
TZ=Asia/Shanghai
COMPOSE_PROJECT_NAME=myriad_she_prod
DOCKER_NETWORK=myriad_she_prod_net

API_CONTAINER_NAME=myriad_she_prod_api
ADMIN_CONTAINER_NAME=myriad_she_prod_admin
GATEWAY_CONTAINER_NAME=myriad_she_prod_gateway
POSTGRES_CONTAINER_NAME=myriad_she_prod_postgres
REDIS_CONTAINER_NAME=myriad_she_prod_redis
MINIO_CONTAINER_NAME=myriad_she_prod_minio

PORT=62021
API_PREFIX=api
HEALTHCHECK_TIMEOUT_MS=3000
ADMIN_PORT=62022
VITE_API_BASE_URL=https://hszfckga.com/api
VITE_API_REQUEST_TIMEOUT_MS=12000
VITE_MEDIA_UPLOAD_TIMEOUT_MS=90000
CORS_ORIGIN=https://hszfckga.com,https://www.hszfckga.com
TRUST_PROXY_HOPS=1

POSTGRES_IMAGE=postgres:16-alpine
POSTGRES_CONTAINER_PORT=5432
POSTGRES_HOST_PORT=62023
POSTGRES_DB=myriad_she
POSTGRES_USER=myriad_she
POSTGRES_PASSWORD=REPLACE_POSTGRES_PASSWORD
POSTGRES_VOLUME=myriad_she_prod_postgres_data
DB_HOST=postgres
DB_PORT=5432
# DB_PORT must stay within 1-65535; pool sizes must be integers, 0-100, with MIN <= MAX.
DB_POOL_MIN=2
DB_POOL_MAX=20
DB_CONNECTION_TIMEOUT_MS=5000
DB_IDLE_TIMEOUT_MS=10000
DATABASE_SSL=false

REDIS_IMAGE=redis:7-alpine
REDIS_CONTAINER_PORT=6379
REDIS_PASSWORD=REPLACE_REDIS_PASSWORD
REDIS_VOLUME=myriad_she_prod_redis_data
REDIS_TIMEOUT_MS=1500
REDIS_TLS_REJECT_UNAUTHORIZED=true

MINIO_IMAGE=minio/minio:latest
MINIO_CONTAINER_PORT=9000
MINIO_CONSOLE_CONTAINER_PORT=9001
MINIO_HOST_PORT=62025
MINIO_CONSOLE_HOST_PORT=62026
MINIO_BUCKET=myriad-she
MINIO_VOLUME=myriad_she_prod_minio_data
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_PUBLIC_ENDPOINT=https://hszfckga.com
# The public HTTPS endpoint may terminate TLS at a reverse proxy; the internal MinIO container remains HTTP unless TLS is configured inside MinIO.
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=REPLACE_MINIO_ACCESS_KEY
MINIO_SECRET_KEY=REPLACE_MINIO_SECRET_KEY
UPLOAD_MAX_FILE_SIZE_MB=10
CONTENT_MEDIA_ORPHAN_GRACE_HOURS=24
CONTENT_PUBLIC_CACHE_TTL_SECONDS=60

WECHAT_MINI_APP_ID=REPLACE_WECHAT_APP_ID
WECHAT_MINI_APP_SECRET=REPLACE_WECHAT_APP_SECRET
WECHAT_OPEN_API_BASE_URL=https://api.weixin.qq.com
WECHAT_OPEN_API_TIMEOUT_MS=8000

ADMIN_AUTH_MODE=local
ADMIN_DEV_USERNAME=REPLACE_ADMIN_USERNAME
ADMIN_DEV_PASSWORD=REPLACE_ADMIN_PASSWORD
ADMIN_SESSION_TTL_SECONDS=86400
ADMIN_LOGIN_MAX_ATTEMPTS=5
ADMIN_LOGIN_LOCK_SECONDS=900

JWT_ACCESS_SECRET=REPLACE_JWT_ACCESS_SECRET_AT_LEAST_32_BYTES
DATA_ENCRYPTION_KEY=REPLACE_DATA_ENCRYPTION_KEY_AT_LEAST_32_BYTES
DATA_ENCRYPTION_ACTIVE_KEY_ID=prod-2026
DATA_ENCRYPTION_KEYRING={"prod-2026":"REPLACE_WITH_CANONICAL_BASE64_32_BYTE_KEY"}
# Optional raw 32-byte key for decrypting legacy ciphertext only during key rotation.
DATA_ENCRYPTION_LEGACY_KEY_BASE64=
JWT_ACCESS_TTL_SECONDS=3600

ACCOUNT_DELETION_ENABLED=true
ACCOUNT_DELETION_WORKER_ENABLED=true
ACCOUNT_DELETION_GRACE_DAYS=7
ACCOUNT_DELETION_POLL_INTERVAL_MS=60000
ACCOUNT_DELETION_PROCESSING_LEASE_SECONDS=300
ACCOUNT_DELETION_MAX_ATTEMPTS=10
ACCOUNT_DELETION_RETRY_BASE_SECONDS=30
ACCOUNT_DELETION_RETRY_MAX_SECONDS=3600
OBSERVATION_DRAFT_RETENTION_DAYS=90
SEASON_SAVE_BIRTH_DATE=true

STORE_ENABLED=false
MEMBERSHIP_ENABLED=false
PAID_MEMBERSHIP_ENABLED=false
PAYMENT_ENABLED=false
FULFILLMENT_ENABLED=false
MOCK_PAYMENT_ENABLED=false
MOCK_FULFILLMENT_ENABLED=false
